{
  "name": "spacetime-daytona-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ./spacetimedb -y",
    "check": "tsc --noEmit",
    "build:app": "pnpm run check && esbuild src/app.ts --bundle --format=esm --outfile=public/app.js --target=es2022",
    "build": "pnpm run generate && pnpm run build:app",
    "dev": "tsx server.ts"
  },
  "dependencies": {
    "@spacetimedb/example-ui": "workspace:*",
    "express": "^4.21.2",
    "spacetimedb": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
