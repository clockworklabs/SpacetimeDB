<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SAPPY)' == '1'">
    <DefineConstants>$(DefineConstants);SAPPY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../SpacetimeDB.ClientSDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../regression-tests/client/module_bindings/**/*.cs" LinkBase="module_bindings" />
    <Compile Include="../../regression-tests/shared/RegressionTestHarness.cs" Link="shared/RegressionTestHarness.cs" />
  </ItemGroup>

</Project>
