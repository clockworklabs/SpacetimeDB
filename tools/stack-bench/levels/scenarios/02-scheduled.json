{
  "level": 2,
  "note": "Level 2 adds scheduled messages. Scheduling times are kept short (60-75s) because the spec permits it and a test cannot wait minutes; the L2 contract requires the time input to accept a send time as little as 60 seconds ahead.",
  "features": [
    {
      "id": 5,
      "name": "Scheduled Messages",
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "register",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "register",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "sched"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "sched"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "sched"
        }
      ],
      "criteria": [
        {
          "id": "pending-visible-to-author",
          "points": 1,
          "desc": "After scheduling, the author sees the message listed as pending",
          "steps": [
            {
              "do": "scheduleMessage",
              "actor": "alice",
              "text": "SCHEDULED alpha",
              "secondsAhead": 70
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "scheduled-item",
              "within": 6000
            }
          ]
        },
        {
          "id": "not-delivered-early",
          "points": 1,
          "desc": "A scheduled message must not appear in the room before its send time",
          "steps": [
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "SCHEDULED alpha",
              "absent": true,
              "within": 5000
            }
          ]
        },
        {
          "id": "cancel-removes-pending",
          "points": 1,
          "desc": "Cancelling a pending scheduled message removes it, and it never sends",
          "steps": [
            {
              "do": "scheduleMessage",
              "actor": "alice",
              "text": "SCHEDULED cancelme",
              "secondsAhead": 70
            },
            {
              "do": "click",
              "actor": "alice",
              "testid": "schedule-cancel",
              "in": {
                "testid": "scheduled-item",
                "contains": "cancelme"
              }
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "scheduled-item",
              "contains": "cancelme",
              "absent": true,
              "within": 5000
            }
          ]
        }
      ]
    }
  ]
}