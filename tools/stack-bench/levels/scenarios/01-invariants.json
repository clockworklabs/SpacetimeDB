{
  "level": 1,
  "track": "stack-bench",
  "note": "Cross-cutting properties, scored on a separate axis from features. A feature-only score cannot see these: an app can implement every listed feature and still let one user take over another's account. Each invariant is its own feature with fresh contexts, so one root defect cannot cascade into several apparent problems.",
  "features": [
    {
      "id": 101,
      "name": "Account Integrity",
      "max": 2,
      "actors": [
        "victim",
        "impostor"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "victim",
          "name": "Victim"
        },
        {
          "do": "createRoom",
          "actor": "victim",
          "room": "private-notes"
        },
        {
          "do": "enterRoom",
          "actor": "victim",
          "room": "private-notes"
        },
        {
          "do": "send",
          "actor": "victim",
          "text": "victim private message"
        }
      ],
      "criteria": [
        {
          "id": "username-is-not-a-credential",
          "points": 1,
          "desc": "Knowing a username must not grant access to that account. Signing up with a taken username, or signing in with the wrong password, must be rejected \u2014 not silently resolved to the existing account.",
          "steps": [
            {
              "do": "signUp",
              "actor": "impostor",
              "name": "Victim",
              "expectFailure": true
            },
            {
              "do": "expect",
              "actor": "impostor",
              "testid": "current-user",
              "contains": "Victim",
              "absent": true,
              "within": 5000
            }
          ]
        },
        {
          "id": "wrong-password-rejected",
          "points": 1,
          "desc": "Signing in with a wrong password is rejected and grants nothing",
          "steps": [
            {
              "do": "signIn",
              "actor": "impostor",
              "name": "Victim",
              "password": "not-the-password",
              "expectFailure": true
            },
            {
              "do": "expect",
              "actor": "impostor",
              "testid": "auth-error",
              "within": 6000
            },
            {
              "do": "expect",
              "actor": "impostor",
              "testid": "message-item",
              "contains": "victim private message",
              "absent": true,
              "within": 4000
            }
          ]
        }
      ]
    },
    {
      "id": 102,
      "name": "Session Durability",
      "max": 3,
      "actors": [
        "alice"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "mine"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "mine"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "alice message"
        }
      ],
      "criteria": [
        {
          "id": "session-survives-reload",
          "points": 1,
          "desc": "Reloading keeps the user signed in as the same account",
          "steps": [
            {
              "do": "reload",
              "actor": "alice",
              "settleMs": 3000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "current-user",
              "contains": "Alice",
              "within": 8000
            }
          ]
        },
        {
          "id": "session-survives-reconnect",
          "points": 1,
          "desc": "A user who loses and regains their connection while sitting on the page is still signed in as the same account. The connection drops and re-establishes on its own; re-identifying the client here would orphan everything it owns.",
          "steps": [
            {
              "do": "setOffline",
              "actor": "alice",
              "offline": true,
              "settleMs": 3000
            },
            {
              "do": "setOffline",
              "actor": "alice",
              "offline": false,
              "settleMs": 6000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "current-user",
              "contains": "Alice",
              "within": 20000
            }
          ]
        },
        {
          "id": "own-content-still-owned-after-reconnect",
          "points": 1,
          "desc": "After reconnecting the user still owns what they created \u2014 their room and their message are still theirs",
          "steps": [
            {
              "do": "enterRoom",
              "actor": "alice",
              "room": "mine"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-item",
              "contains": "alice message",
              "within": 15000
            }
          ]
        }
      ],
      "note": "Session durability is tested by dropping the client's connection, not by restarting the backend. Both force the same reconnect, but only one needs a server the harness owns \u2014 and restarting a shared host takes unrelated databases down with it. Backend restarts belong where they test storage rather than session handling (level 4)."
    },
    {
      "id": 103,
      "name": "Data Isolation",
      "max": 2,
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "room-a"
        },
        {
          "do": "createRoom",
          "actor": "bob",
          "room": "room-b"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "room-a"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "room-b"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "message for room a"
        }
      ],
      "criteria": [
        {
          "id": "messages-scoped-to-room",
          "points": 1,
          "desc": "A message sent in one room never appears in another",
          "steps": [
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "message for room a",
              "absent": true,
              "within": 5000
            }
          ]
        },
        {
          "id": "no-duplicate-rooms",
          "points": 1,
          "desc": "A room renders exactly once in the list \u2014 an optimistic insert plus a broadcast echo duplicates it",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "room-item",
              "contains": "{room:room-a}",
              "count": 1,
              "within": 5000
            }
          ]
        }
      ]
    },
    {
      "id": 104,
      "name": "Per-User State Integrity",
      "max": 3,
      "actors": [
        "alice",
        "bob"
      ],
      "note": "Unread counts and read receipts are per-user state derived from other people's actions. The historical grading data has more defects here than anywhere else in level 1.",
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "main"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "side"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "main"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "main"
        }
      ],
      "criteria": [
        {
          "id": "own-messages-not-unread",
          "points": 1,
          "desc": "Your own message must never count as unread for you. (historical: a sender's own badge went to 1 on SpacetimeDB, twice)",
          "steps": [
            {
              "do": "send",
              "actor": "alice",
              "text": "alice speaking"
            },
            {
              "do": "wait",
              "actor": "alice",
              "ms": 1400
            },
            {
              "do": "enterRoom",
              "actor": "alice",
              "room": "side"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "unread-badge",
              "in": {
                "testid": "room-item",
                "contains": "{room:main}"
              },
              "absent": true,
              "within": 5000
            }
          ]
        },
        {
          "id": "unread-does-not-resurrect",
          "points": 1,
          "desc": "Once a room is open its badge stays clear while new messages arrive in it \u2014 you are looking at them. (historical: badges that never cleared)",
          "steps": [
            {
              "do": "enterRoom",
              "actor": "alice",
              "room": "main"
            },
            {
              "do": "wait",
              "actor": "alice",
              "ms": 1400
            },
            {
              "do": "send",
              "actor": "bob",
              "text": "bob speaking"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-item",
              "contains": "bob speaking",
              "within": 6000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "unread-badge",
              "in": {
                "testid": "room-item",
                "contains": "{room:main}"
              },
              "absent": true,
              "within": 4000
            }
          ]
        },
        {
          "id": "receipts-keep-updating",
          "points": 1,
          "desc": "Receipts stay live for later messages, not just the first one. (historical: 'Seen by' that only appeared after leaving and re-entering the room)",
          "steps": [
            {
              "do": "wait",
              "actor": "alice",
              "ms": 1400
            },
            {
              "do": "send",
              "actor": "alice",
              "text": "second message from alice"
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "second message from alice",
              "within": 6000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "read-receipt",
              "contains": "Bob",
              "within": 10000
            }
          ]
        }
      ]
    },
    {
      "id": 105,
      "name": "Presence and Display Stability",
      "max": 2,
      "actors": [
        "alice",
        "bob"
      ],
      "note": "Presence was wrong in six of the historically graded runs, and 'Seen by' lists were seen flickering between orderings. Neither is visible to a single assertion.",
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "lobby"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "lobby"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "lobby"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "who is here"
        }
      ],
      "criteria": [
        {
          "id": "receipt-text-does-not-flicker",
          "points": 1,
          "desc": "The 'Seen by' list must not change while nothing is happening. (historical: names flipping order continuously from an unstable sort)",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "read-receipt",
              "within": 10000
            },
            {
              "do": "expectStable",
              "actor": "alice",
              "testid": "read-receipt",
              "samples": 4,
              "intervalMs": 700
            }
          ]
        },
        {
          "id": "presence-drops-signed-out-user",
          "points": 1,
          "desc": "A user who signs out disappears from the online list. (historical: presence lists stale or stuck, six runs)",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "online-users",
              "contains": "Bob",
              "within": 8000
            },
            {
              "do": "click",
              "actor": "bob",
              "testid": "signout"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "online-users",
              "contains": "Bob",
              "absent": true,
              "within": 12000
            }
          ]
        }
      ]
    },
    {
      "id": 106,
      "name": "Concurrent State Integrity",
      "max": 4,
      "actors": [
        "alice",
        "bob",
        "carol",
        "dave"
      ],
      "note": "Counters and capacity limits that several people touch at once. Read-modify-write loses updates and check-then-insert overshoots a cap; a serializable transaction cannot do either. Every assertion here also checks the clients AGREE, because one client showing the right number while another shows a different one is the defect non-atomic broadcast actually produces.",
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "signUp",
          "actor": "carol",
          "name": "Carol"
        },
        {
          "do": "signUp",
          "actor": "dave",
          "name": "Dave"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "busy"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "busy"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "busy"
        },
        {
          "do": "enterRoom",
          "actor": "carol",
          "room": "busy"
        },
        {
          "do": "enterRoom",
          "actor": "dave",
          "room": "busy"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "react to this"
        }
      ],
      "criteria": [
        {
          "id": "reaction-count-is-exact",
          "points": 1,
          "desc": "Four users reacting at the same instant leave a count of exactly four. A read-modify-write loses updates under concurrency; a serializable transaction cannot.",
          "steps": [
            {
              "do": "clickConcurrently",
              "actors": [
                "alice",
                "bob",
                "carol",
                "dave"
              ],
              "testid": "react-button",
              "settleMs": 5000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "reaction-count",
              "contains": "4",
              "within": 12000
            }
          ]
        },
        {
          "id": "reaction-count-agrees-across-clients",
          "points": 1,
          "desc": "Every client shows the same count. One client being right while another is wrong is what a broadcast that is not atomic with the write produces.",
          "steps": [
            {
              "do": "expectAgreement",
              "actors": [
                "alice",
                "bob",
                "carol",
                "dave"
              ],
              "testid": "reaction-count",
              "within": 10000
            }
          ]
        },
        {
          "id": "removing-a-reaction-decrements-once",
          "points": 1,
          "desc": "A user removing their reaction takes exactly one off the count, and every client agrees on the new total. One user contributes at most one either way.",
          "steps": [
            {
              "do": "click",
              "actor": "alice",
              "testid": "react-button"
            },
            {
              "do": "wait",
              "actor": "alice",
              "ms": 3000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "reaction-count",
              "contains": "3",
              "within": 8000
            },
            {
              "do": "expectAgreement",
              "actors": [
                "alice",
                "bob",
                "carol",
                "dave"
              ],
              "testid": "reaction-count",
              "within": 10000
            }
          ]
        },
        {
          "id": "pin-cap-holds-under-concurrency",
          "points": 1,
          "desc": "Four users pinning four different messages at the same instant, against a cap of three, must leave exactly three. Checking the count and inserting as separate steps lets all four see room under the cap.",
          "steps": [
            {
              "do": "sendMany",
              "actor": "alice",
              "prefix": "PIN",
              "count": 4,
              "delayMs": 1400
            },
            {
              "do": "wait",
              "actor": "alice",
              "ms": 2000
            },
            {
              "do": "clickConcurrently",
              "testid": "pin-button",
              "settleMs": 6000,
              "targets": [
                {
                  "actor": "alice",
                  "in": {
                    "testid": "message-item",
                    "contains": "PIN-1"
                  }
                },
                {
                  "actor": "bob",
                  "in": {
                    "testid": "message-item",
                    "contains": "PIN-2"
                  }
                },
                {
                  "actor": "carol",
                  "in": {
                    "testid": "message-item",
                    "contains": "PIN-3"
                  }
                },
                {
                  "actor": "dave",
                  "in": {
                    "testid": "message-item",
                    "contains": "PIN-4"
                  }
                }
              ]
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "pinned-item",
              "count": 3,
              "within": 12000
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "pinned-item",
              "count": 3,
              "within": 12000
            }
          ]
        }
      ]
    },
    {
      "id": 107,
      "name": "Server-Side Truth",
      "max": 2,
      "actors": [
        "alice",
        "bob"
      ],
      "note": "Whatever the acting client shows must actually exist on the server. Optimistic inserts that were never confirmed, and counts incremented only in one browser, are invisible to any assertion made from that same browser.",
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "truth"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "truth"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "truth"
        }
      ],
      "criteria": [
        {
          "id": "rejected-message-does-not-linger",
          "points": 1,
          "desc": "A message the server refused for exceeding the rate limit must not stay visible to its sender. An optimistic insert without rollback leaves the sender believing they said something nobody received.",
          "steps": [
            {
              "do": "send",
              "actor": "alice",
              "text": "first of a burst"
            },
            {
              "do": "send",
              "actor": "alice",
              "text": "REJECTED BY RATE LIMIT"
            },
            {
              "do": "wait",
              "actor": "alice",
              "ms": 4000
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "REJECTED BY RATE LIMIT",
              "absent": true,
              "within": 4000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-item",
              "contains": "REJECTED BY RATE LIMIT",
              "absent": true,
              "within": 4000
            }
          ]
        },
        {
          "id": "a-fresh-client-sees-the-same-thing",
          "points": 1,
          "desc": "A brand-new browser sees what the acting client claims. Anything visible only to the client that performed the action never reached the server.",
          "steps": [
            {
              "do": "wait",
              "actor": "alice",
              "ms": 1500
            },
            {
              "do": "send",
              "actor": "alice",
              "text": "durable statement"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-item",
              "contains": "durable statement",
              "within": 6000
            },
            {
              "do": "freshClient",
              "actor": "bob"
            },
            {
              "do": "signUp",
              "actor": "bob-fresh",
              "name": "Observer"
            },
            {
              "do": "enterRoom",
              "actor": "bob-fresh",
              "room": "truth"
            },
            {
              "do": "expect",
              "actor": "bob-fresh",
              "testid": "message-item",
              "contains": "durable statement",
              "within": 10000
            }
          ]
        }
      ]
    }
  ]
}