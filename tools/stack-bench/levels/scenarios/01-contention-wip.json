              }
            },
            {
              "do": "wait",
              "actor": "alice",
              "ms": 2500
            },
            {
              "do": "click",
              "actor": "alice",
              "testid": "pinned-unpin",
              "in": {
                "testid": "pinned-item",
                "contains": "PIN-1"
              }
            },
            {
              "do": "click",
              "actor": "bob",
              "testid": "pinned-unpin",
              "in": {
                "testid": "pinned-item",
                "contains": "PIN-2"
              }
            },
            {
              "do": "click",
              "actor": "carol",
              "testid": "pinned-unpin",
              "in": {
                "testid": "pinned-item",
                "contains": "PIN-3"
              }
            },
            {
              "do": "wait",
              "actor": "alice",
              "ms": 2500
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "pinned-item",
