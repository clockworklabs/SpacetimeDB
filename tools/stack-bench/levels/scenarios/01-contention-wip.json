                "contains": "PIN-1"
              }
            },
            {
              "do": "click",
              "actor": "bob",
              "testid": "pin-button",
              "in": {
                "testid": "message-item",
                "contains": "PIN-2"
              }
            },
            {
              "do": "click",
              "actor": "carol",
              "testid": "pin-button",
              "in": {
