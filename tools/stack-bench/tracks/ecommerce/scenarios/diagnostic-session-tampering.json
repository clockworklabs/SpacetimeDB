{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Session credential tampering diagnostic",
  "note": "Zero-point diagnostic, not selected by scored campaigns. Independent reads use the declared order data interface to inspect stock, orders, cart and allocations. Prove a valid purchase, alter the sole session credential without changing the request or browser state, require refusal and unchanged stored state, then prove valid access still works. Mixed credentials and cookie/CSRF ambiguity remain unmeasured. This does not test expiry, revocation or every token attack.",
  "features": [{
    "id": 9600,
    "name": "A forged session cannot purchase",
    "actors": ["buyer"],
    "setup": [{"do":"signUp","actor":"buyer","name":"session-buyer"}],
    "criteria": [{
      "id": "9600a",
      "category": "production",
      "points": 0,
      "desc": "valid purchases work before and after a refused forged credential, with no stored purchase effect from the forgery",
      "steps": [
        {"do":"dbRecordStock","item":"Keyboard","as":"initial-stock"},
        {"do":"callAction","actor":"buyer","action":"buy","namedAction":{"id":"buy","path":"/api/items/:id/buy","reducer":"buy_now","args":[0],"params":[{"name":"itemId","in":"path","placeholder":":id","wireType":"u64"}]},"input":{"testid":"item-card","contains":"Keyboard","attribute":"data-buy-input"},"settleMs":0},
        {"do":"expectActionOutcome","actor":"buyer","outcome":"accepted"},
        {"do":"dbExpectStock","item":"Keyboard","relativeTo":"initial-stock","plus":-1},
        {"do":"dbRecordCheckout","account":"{user:session-buyer}","item":"Keyboard","as":"before-forgery","storage":{"kind":"order-data","cart":true,"warehouses":true}},
        {"do":"callAction","actor":"buyer","action":"buy","authentication":"tampered-session","namedAction":{"id":"buy","path":"/api/items/:id/buy","reducer":"buy_now","args":[0],"params":[{"name":"itemId","in":"path","placeholder":":id","wireType":"u64"}]},"input":{"testid":"item-card","contains":"Keyboard","attribute":"data-buy-input"},"settleMs":1000},
        {"do":"expectActionOutcome","actor":"buyer","outcome":"completed"},
        {"do":"dbExpectNoPurchase","before":"before-forgery"},
        {"do":"expectActionOutcome","actor":"buyer","outcome":"refused"},
        {"do":"callAction","actor":"buyer","action":"buy","namedAction":{"id":"buy","path":"/api/items/:id/buy","reducer":"buy_now","args":[0],"params":[{"name":"itemId","in":"path","placeholder":":id","wireType":"u64"}]},"input":{"testid":"item-card","contains":"Keyboard","attribute":"data-buy-input"},"settleMs":0},
        {"do":"expectActionOutcome","actor":"buyer","outcome":"accepted"},
        {"do":"dbExpectStock","item":"Keyboard","relativeTo":"initial-stock","plus":-2}
      ]
    }]
  }]
}
