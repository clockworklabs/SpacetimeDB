{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Sign out and return",
  "features": [
    {
      "id": 1,
      "name": "Accounts",
      "actors": [
        "shopper"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "shopper",
          "name": "ann"
        }
      ],
      "criteria": [
        {
          "id": "1d",
          "category": "feature",
          "desc": "signing out and back in returns the same account",
          "points": 1,
          "steps": [
            { "do": "click", "actor": "shopper", "testid": "current-user", "unlessVisible": "signout" },
            {
              "do": "click",
              "actor": "shopper",
              "testid": "signout"
            },
            {
              "do": "waitUntilAbsent",
              "actor": "shopper",
              "testid": "current-user",
              "within": 6000
            },
            {
              "do": "expect",
              "actor": "shopper",
              "testid": "current-user",
              "absent": true
            },
            {
              "do": "reload",
              "actor": "shopper",
              "application": true,
              "settleMs": 1000
            },
            {
              "do": "expect",
              "actor": "shopper",
              "testid": "current-user",
              "absent": true
            },
            {
              "do": "signIn",
              "actor": "shopper",
              "name": "ann",
              "awaitSignedIn": false
            },
            {
              "do": "expect",
              "actor": "shopper",
              "testid": "current-user",
              "contains": "ann",
              "within": 10000
            }
          ],
          "statedBy": "a signed-in user can sign out, returning to the signed-out state"
        }
      ]
    }
  ]
}
