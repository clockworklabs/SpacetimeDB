{
  "schemaVersion": 1,
  "status": "candidate",
  "track": "ecommerce",
  "level": 1,
  "name": "Accounts and catalog",
  "note": "Account checks retain their independent actors. Catalog checks assert the exact seeded values and visible ranking order rather than treating mere presence as ordering evidence.",
  "features": [
    {
      "id": 1,
      "name": "Accounts",
      "actors": ["shopper", "impostor"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "ann" }
      ],
      "criteria": [
        {
          "id": "1a",
          "desc": "a visitor can create an account and is signed in as it",
          "points": 1,
          "steps": [
            { "do": "expect", "actor": "shopper", "testid": "current-user", "contains": "ann", "within": 6000 }
          ],
          "statedBy": "a visitor can create an account with a username and password"
        },
        {
          "id": "1b",
          "desc": "a taken username is refused and does not sign the visitor in as the existing account",
          "points": 1,
          "steps": [
            { "do": "signUp", "actor": "impostor", "name": "ann", "password": "different-pw", "expectFailure": true },
            { "do": "expect", "actor": "impostor", "testid": "auth-error", "within": 6000 },
            { "do": "expect", "actor": "impostor", "testid": "current-user", "absent": true }
          ],
          "statedBy": "signing up with a taken username fails with a visible error and must never sign the visitor in as the existing account"
        },
        {
          "id": "1c",
          "desc": "a wrong password is refused",
          "points": 1,
          "steps": [
            { "do": "signIn", "actor": "impostor", "name": "ann", "password": "wrong-pw", "expectFailure": true },
            { "do": "expect", "actor": "impostor", "testid": "auth-error", "within": 6000 },
            { "do": "expect", "actor": "impostor", "testid": "current-user", "absent": true }
          ],
          "statedBy": "signing in with a wrong password fails with a visible error"
        },
        {
          "id": "1d",
          "desc": "signing out and back in returns the same account",
          "points": 1,
          "steps": [
            { "do": "click", "actor": "shopper", "testid": "signout" },
            { "do": "expect", "actor": "shopper", "testid": "signup-username", "within": 6000 },
            { "do": "signIn", "actor": "shopper", "name": "ann" },
            { "do": "expect", "actor": "shopper", "testid": "current-user", "contains": "ann", "within": 6000 }
          ],
          "statedBy": "a signed-in user can sign out, returning to the signed-out state"
        },
        {
          "id": "1e",
          "desc": "the session survives a reload",
          "points": 1,
          "steps": [
            { "do": "reload", "actor": "shopper", "settleMs": 4000 },
            { "do": "expect", "actor": "shopper", "testid": "current-user", "contains": "ann", "within": 6000 }
          ],
          "statedBy": "a signed-in session persists across a page reload"
        }
      ]
    },
    {
      "id": 2,
      "name": "Storefront is public and live",
      "actors": ["buyer", "visitor"],
      "setup": [
        { "do": "signUp", "actor": "buyer", "name": "dov" }
      ],
      "criteria": [
        {
          "id": "2a",
          "desc": "a signed-out visitor sees the catalogue with the seeded prices and stock",
          "points": 1,
          "steps": [
            { "do": "expect", "actor": "visitor", "testid": "item-card", "contains": "Air Purifier" },
            { "do": "expectNumber", "actor": "visitor", "testid": "item-price", "in": { "testid": "item-card", "contains": "Air Purifier" }, "equals": 189 },
            { "do": "expectNumber", "actor": "visitor", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "equals": 100 }
          ],
          "statedBy": "each card shows its name, current price, and total stock"
        },
        {
          "id": "2b",
          "desc": "the storefront shows the exact alphabetical top ten while nothing has been bought",
          "points": 1,
          "steps": [
            { "do": "expectSequence", "actor": "visitor", "testid": "item-name", "in": { "testid": "item-list" }, "equals": ["Air Purifier", "Bluetooth Speaker", "Coffee Grinder", "Desk Lamp", "Espresso Machine", "Gaming Mouse", "Headphones", "Induction Cooktop", "Keyboard", "Laptop Stand"] }
          ],
          "statedBy": "the storefront shows the ten most-purchased items, with alphabetical order breaking ties"
        },
        {
          "id": "2c",
          "desc": "a purchase moves the bought item to the front of the ranking, live",
          "points": 1,
          "steps": [
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Coffee Grinder" } },
            { "do": "expectSequence", "actor": "visitor", "testid": "item-name", "in": { "testid": "item-list" }, "within": 10000, "equals": ["Coffee Grinder", "Air Purifier", "Bluetooth Speaker", "Desk Lamp", "Espresso Machine", "Gaming Mouse", "Headphones", "Induction Cooktop", "Keyboard", "Laptop Stand"] },
            { "do": "expectAgreement", "actors": ["buyer", "visitor"], "testid": "item-stock", "in": { "testid": "item-card", "contains": "Coffee Grinder" }, "numeric": true }
          ],
          "statedBy": "a purchase immediately changes the ranking for every open client"
        },
        {
          "id": "2d",
          "desc": "search finds an item that is not on the storefront",
          "points": 1,
          "steps": [
            { "do": "fill", "actor": "visitor", "testid": "search-input", "text": "Mirrorless", "enter": true, "settleMs": 1500 },
            { "do": "expect", "actor": "visitor", "testid": "item-card", "contains": "Mirrorless Camera", "in": { "testid": "search-results" } }
          ],
          "statedBy": "search matches any part of an item name across the full catalogue"
        }
      ]
    }
  ]
}
