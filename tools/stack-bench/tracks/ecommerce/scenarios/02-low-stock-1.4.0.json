{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Ecommerce L2 low-stock boundary",
  "note": "This scenario owns only the low-stock boundary check so a failure cannot prevent unrelated operational-view checks from running.",
  "features": [
    {
      "id": 5,
      "name": "The low-stock view",
      "actors": ["admin", "customer"],
      "setup": [
        { "do": "dbSetStock", "item": "Air Purifier", "warehouse": "East", "quantity": 2, "settleMs": 250 },
        { "do": "dbSetStock", "item": "Air Purifier", "warehouse": "West", "quantity": 1, "settleMs": 250 },
        {
          "do": "signIn",
          "actor": "admin",
          "name": "admin",
          "password": "stackbench-admin-2026",
          "exact": true
        },
        { "do": "signUp", "actor": "customer", "name": "low-stock-focused" },
        { "do": "reload", "actor": "admin", "settleMs": 1000 },
        { "do": "reload", "actor": "customer", "settleMs": 1000 },
        { "do": "click", "actor": "admin", "testid": "admin-link" }
      ],
      "criteria": [
        {
          "id": "5a",
          "desc": "an item falling to ten units or fewer joins the low-stock list, live",
          "points": 3,
          "statedBy": "items enter and leave this list as stock moves, sells, is restocked, cancelled or returned",
          "steps": [
            {
              "do": "expect",
              "actor": "admin",
              "testid": "low-stock-item",
              "contains": "Air Purifier",
              "within": 8000
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "restock-input",
              "text": "8",
              "in": { "testid": "admin-location-row", "contains": "Air Purifier" }
            },
            {
              "do": "click",
              "actor": "admin",
              "testid": "restock-submit",
              "in": { "testid": "admin-location-row", "contains": "Air Purifier" }
            },
            {
              "do": "expect",
              "actor": "admin",
              "testid": "low-stock-item",
              "contains": "Air Purifier",
              "absent": true,
              "within": 10000
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "buy-now",
              "in": { "testid": "item-card", "contains": "Air Purifier" }
            },
            {
              "do": "expect",
              "actor": "admin",
              "testid": "low-stock-item",
              "contains": "Air Purifier",
              "within": 10000
            }
          ]
        }
      ]
    }
  ]
}
