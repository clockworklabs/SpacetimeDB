{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Checkout recovery after process crashes",
  "note": "One fixed 16-call, zero-offset trial per independent process boundary. Database then application; SpacetimeDB reuses its measured combined boundary once. Both assertions use both retained observations. Unknown outcomes, missed windows and incomplete recovery remain unmeasured. Fresh-customer progress is a shared prerequisite. This single-item test observes recovered order/cart correctness, not physical rows, optional payment/warehouse features, power loss or storage-device durability.",
  "features": [
    {
      "id": 910,
      "name": "Checkout crash recovery",
      "actors": [
        "a",
        "b",
        "c"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "a",
          "name": "database"
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:database}",
          "item": "Keyboard",
          "as": "database-baseline-before",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "click",
          "actor": "a",
          "testid": "add-to-cart",
          "in": {
            "testid": "item-card",
            "contains": "Keyboard"
          }
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:database}",
          "item": "Keyboard",
          "as": "database-baseline-prepared",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "confirmCheckout",
          "actor": "a",
          "namedAction": {
            "id": "checkout",
            "reducer": "checkout",
            "path": "/api/checkout",
            "args": []
          }
        },
        {
          "do": "dbExpectCheckout",
          "before": "database-baseline-before",
          "prepared": "database-baseline-prepared",
          "quantity": 1
        },
        {
          "do": "reload",
          "actor": "a",
          "settleMs": 0
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:database}",
          "item": "Keyboard",
          "as": "database-before",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "click",
          "actor": "a",
          "testid": "add-to-cart",
          "in": {
            "testid": "item-card",
            "contains": "Keyboard"
          }
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:database}",
          "item": "Keyboard",
          "as": "database-prepared",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "crashCheckout",
          "actor": "a",
          "before": "database-before",
          "prepared": "database-prepared",
          "quantity": 1,
          "requests": 16,
          "offsetMs": 0,
          "target": "database",
          "as": "database-crash-observation",
          "namedAction": {
            "id": "checkout",
            "reducer": "checkout",
            "path": "/api/checkout",
            "args": []
          }
        },
        {
          "do": "signUp",
          "actor": "b",
          "name": "application"
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:application}",
          "item": "Keyboard",
          "as": "application-baseline-before",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "click",
          "actor": "b",
          "testid": "add-to-cart",
          "in": {
            "testid": "item-card",
            "contains": "Keyboard"
          }
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:application}",
          "item": "Keyboard",
          "as": "application-baseline-prepared",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "confirmCheckout",
          "actor": "b",
          "namedAction": {
            "id": "checkout",
            "reducer": "checkout",
            "path": "/api/checkout",
            "args": []
          }
        },
        {
          "do": "dbExpectCheckout",
          "before": "application-baseline-before",
          "prepared": "application-baseline-prepared",
          "quantity": 1
        },
        {
          "do": "reload",
          "actor": "b",
          "settleMs": 0
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:application}",
          "item": "Keyboard",
          "as": "application-before",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "click",
          "actor": "b",
          "testid": "add-to-cart",
          "in": {
            "testid": "item-card",
            "contains": "Keyboard"
          }
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:application}",
          "item": "Keyboard",
          "as": "application-prepared",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "crashCheckout",
          "actor": "b",
          "before": "application-before",
          "prepared": "application-prepared",
          "quantity": 1,
          "requests": 16,
          "offsetMs": 0,
          "target": "application",
          "as": "application-crash-observation",
          "reuseCombinedFrom": "database-crash-observation",
          "namedAction": {
            "id": "checkout",
            "reducer": "checkout",
            "path": "/api/checkout",
            "args": []
          }
        },
        {
          "do": "signUp",
          "actor": "c",
          "name": "recovered"
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:recovered}",
          "item": "Keyboard",
          "as": "recovered-before",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "click",
          "actor": "c",
          "testid": "add-to-cart",
          "in": {
            "testid": "item-card",
            "contains": "Keyboard"
          }
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:recovered}",
          "item": "Keyboard",
          "as": "recovered-prepared",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "click",
          "actor": "c",
          "testid": "cart-toggle"
        },
        {
          "do": "click",
          "actor": "c",
          "testid": "checkout-submit"
        },
        {
          "do": "expectNumber",
          "actor": "c",
          "testid": "cart-count",
          "equals": 0,
          "within": 10000
        },
        {
          "do": "click",
          "actor": "c",
          "testid": "overlay-close",
          "ifAvailable": true
        },
        {
          "do": "dbExpectCheckout",
          "before": "recovered-before",
          "prepared": "recovered-prepared",
          "quantity": 1
        }
      ],
      "criteria": [
        {
          "id": "910a",
          "category": "production",
          "points": 1,
          "desc": "interrupted checkout recovers to the prepared cart or one complete order with the cart cleared after each independent process crash",
          "steps": [
            {
              "do": "expectCrashCheckout",
              "from": "database-crash-observation",
              "verdict": "atomicity"
            },
            {
              "do": "expectCrashCheckout",
              "from": "application-crash-observation",
              "verdict": "atomicity"
            }
          ]
        },
        {
          "id": "910b",
          "category": "production",
          "points": 1,
          "desc": "acknowledged checkout is not rolled back and earlier orders remain unchanged after each independent process crash",
          "steps": [
            {
              "do": "expectCrashCheckout",
              "from": "database-crash-observation",
              "verdict": "durability"
            },
            {
              "do": "expectCrashCheckout",
              "from": "application-crash-observation",
              "verdict": "durability"
            }
          ]
        }
      ]
    }
  ]
}
