{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 5,
  "name": "Notification preferences",
  "features": [
    {
      "id": 630,
      "name": "Account notification preferences",
      "actors": ["owner", "other"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "notification-owner" },
        { "do": "signUp", "actor": "other", "name": "notification-other" },
        { "do": "click", "actor": "owner", "testid": "notification-settings" },
        { "do": "click", "actor": "owner", "testid": "notification-order" },
        { "do": "click", "actor": "owner", "testid": "notification-save" }
      ],
      "criteria": [
        {
          "id": "630c",
          "desc": "the customer can save a notification choice",
          "points": 1,
          "statedBy": "Signed-in customers can turn order and stock notifications on or off.",
          "steps": [
            { "do": "expect", "actor": "owner", "testid": "notification-order", "attribute": "data-state", "value": "on" }
          ]
        },
        {
          "id": "630a",
          "desc": "the owner's notification choice survives a reload",
          "points": 2,
          "statedBy": "Notification choices persist for the account.",
          "steps": [
            { "do": "reload", "actor": "owner", "settleMs": 3000 },
            { "do": "click", "actor": "owner", "testid": "notification-settings" },
            { "do": "expect", "actor": "owner", "testid": "notification-order", "attribute": "data-state", "value": "on" }
          ]
        },
        {
          "id": "630b",
          "desc": "the owner's choice does not change another account",
          "points": 2,
          "statedBy": "One customer's notification choices do not affect another customer.",
          "steps": [
            { "do": "click", "actor": "other", "testid": "notification-settings" },
            { "do": "expect", "actor": "other", "testid": "notification-order", "attribute": "data-state", "value": "off" }
          ]
        }
      ]
    }
  ]
}
