{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 2,
  "name": "Customer profile",
  "features": [
    {
      "id": 620,
      "name": "Customer profile",
      "actors": ["owner", "privateOwner", "other"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "profile-owner" },
        { "do": "click", "actor": "owner", "testid": "profile-link" },
        { "do": "fill", "actor": "owner", "testid": "profile-name", "text": "Avery Stone" },
        { "do": "fill", "actor": "owner", "testid": "profile-address", "text": "14 Market Street" },
        { "do": "click", "actor": "owner", "testid": "profile-save" }
      ],
      "criteria": [
        {
          "id": "620c",
          "desc": "the owner can save and view a customer profile",
          "points": 1,
          "statedBy": "A signed-in customer can save and view their name and shipping address.",
          "steps": [
            { "do": "expect", "actor": "owner", "testid": "profile-address-summary", "contains": "14 Market Street" }
          ]
        },
        {
          "id": "620a",
          "desc": "the owner sees the saved profile after reload",
          "points": 2,
          "statedBy": "The saved profile remains after a reload.",
          "steps": [
            { "do": "reload", "actor": "owner", "settleMs": 2500 },
            { "do": "click", "actor": "owner", "testid": "profile-link" },
            { "do": "expect", "actor": "owner", "testid": "profile-address-summary", "contains": "14 Market Street" }
          ]
        },
        {
          "id": "620b",
          "desc": "another customer cannot see the owner's profile",
          "points": 2,
          "statedBy": "Each customer can see only their own profile.",
          "steps": [
            { "do": "signUp", "actor": "privateOwner", "name": "profile-private-owner" },
            { "do": "click", "actor": "privateOwner", "testid": "profile-link" },
            { "do": "fill", "actor": "privateOwner", "testid": "profile-name", "text": "Avery Stone" },
            { "do": "fill", "actor": "privateOwner", "testid": "profile-address", "text": "14 Market Street" },
            { "do": "click", "actor": "privateOwner", "testid": "profile-save" },
            { "do": "signUp", "actor": "other", "name": "profile-other" },
            { "do": "click", "actor": "other", "testid": "profile-link" },
            { "do": "expect", "actor": "other", "testid": "profile-address-summary", "contains": "14 Market Street", "absent": true }
          ]
        }
      ]
    }
  ]
}
