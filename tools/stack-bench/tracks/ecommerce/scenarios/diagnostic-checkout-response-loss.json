              "ifAvailable": true,
              "within": 1000
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "catalog-link",
              "ifAvailable": true,
              "within": 1000
            },
            {
              "do": "dbRecordCheckout",
              "account": "{user:lost-reply}",
              "item": "Desk Lamp",
              "as": "recovered-before",
              "storage": {
                "kind": "order-data",
                "cart": true,
                "warehouses": true
              }
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "add-to-cart",
              "in": {
                "testid": "item-card",
                "contains": "Desk Lamp"
              }
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "cart-toggle",
              "unlessVisible": "checkout-submit"
            },
            {
              "do": "expectNumber",
              "actor": "a",
              "testid": "cart-count",
              "equals": 1
            },
            {
              "do": "dbRecordCheckout",
              "account": "{user:lost-reply}",
              "item": "Desk Lamp",
              "as": "recovered-cart",
              "storage": {
                "kind": "order-data",
                "cart": true,
                "warehouses": true
              }
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "checkout-submit"
            },
            {
              "do": "expectNumber",
              "actor": "a",
              "testid": "cart-count",
              "equals": 0
            },
            {
              "do": "dbExpectCheckout",
              "before": "recovered-before",
              "prepared": "recovered-cart",
              "quantity": 1
            }
          ]
        }
      ]
    }
  ]
