{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Checkout after a lost browser reply",
  "note": "Zero-point qualification. Block write replies on the actor's actual HTTP/WebSocket paths. Observe the commit independently, reconnect, and retry the unchanged consumed cart. Equal buy-now arguments are not a retry identity.",
  "features": [
    {
      "id": 9450,
      "name": "Committed checkout survives a lost reply and same-cart replay",
      "actors": [
        "a"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "a",
          "name": "lost-reply"
        },
        {
          "do": "prepareResponseLoss",
          "actor": "a"
        },
        {
          "do": "ensureSignedIn",
          "actor": "a",
          "name": "lost-reply",
          "readyTestid": "current-user"
        }
      ],
      "criteria": [
        {
          "id": "lost-checkout-reply",
          "category": "production",
          "points": 0,
          "desc": "one committed cart produces one order despite a lost reply and retry; later checkout still works",
          "steps": [
            {
              "do": "click",
              "actor": "a",
              "testid": "overlay-close",
              "ifAvailable": true,
              "within": 1000
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "catalog-link",
              "ifAvailable": true,
              "within": 1000
            },
            {
              "do": "dbRecordCheckout",
              "account": "{user:lost-reply}",
              "item": "Desk Lamp",
              "as": "control-before",
              "storage": {
                "kind": "order-data",
                "cart": true,
                "warehouses": true
              }
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "add-to-cart",
              "in": {
                "testid": "item-card",
                "contains": "Desk Lamp"
              }
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "cart-toggle",
              "unlessVisible": "checkout-submit"
            },
            {
              "do": "expectNumber",
              "actor": "a",
              "testid": "cart-count",
              "equals": 1
            },
            {
              "do": "dbRecordCheckout",
              "account": "{user:lost-reply}",
              "item": "Desk Lamp",
              "as": "control-cart",
              "storage": {
                "kind": "order-data",
                "cart": true,
                "warehouses": true
              }
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "checkout-submit"
            },
            {
              "do": "expectNumber",
              "actor": "a",
              "testid": "cart-count",
              "equals": 0
            },
            {
              "do": "dbExpectCheckout",
              "before": "control-before",
              "prepared": "control-cart",
              "quantity": 1
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "overlay-close",
              "ifAvailable": true,
              "within": 1000
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "catalog-link",
              "ifAvailable": true,
              "within": 1000
            },
            {
              "do": "dbRecordCheckout",
              "account": "{user:lost-reply}",
              "item": "Desk Lamp",
              "as": "before",
              "storage": {
                "kind": "order-data",
                "cart": true,
                "warehouses": true
              }
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "add-to-cart",
              "in": {
                "testid": "item-card",
                "contains": "Desk Lamp"
              }
            },
            {
              "do": "click",
              "actor": "a",
              "testid": "cart-toggle",
              "unlessVisible": "checkout-submit"
            },
            {
              "do": "expectNumber",
              "actor": "a",
              "testid": "cart-count",
              "equals": 1
            },
            {
              "do": "dbRecordCheckout",
              "account": "{user:lost-reply}",
              "item": "Desk Lamp",
              "as": "prepared",
              "storage": {
                "kind": "order-data",
                "cart": true,
                "warehouses": true
              }
            },
            {
              "do": "loseCheckoutResponse",
              "actor": "a",
              "before": "before",
              "prepared": "prepared",
              "quantity": 1
            },
            {
              "do": "reload",
              "actor": "a",
              "settleMs": 0
            },
            {
              "do": "ensureSignedIn",
              "actor": "a",
              "name": "lost-reply",
              "readyTestid": "current-user"
            },
            {
              "do": "expectNumber",
              "actor": "a",
              "testid": "cart-count",
              "equals": 0
            },
            {
              "do": "callAction",
              "actor": "a",
              "action": "checkout",
              "namedAction": {
                "id": "checkout",
                "path": "/api/checkout",
