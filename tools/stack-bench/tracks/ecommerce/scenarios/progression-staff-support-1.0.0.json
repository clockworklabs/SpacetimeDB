{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 5,
  "name": "Staff and customer support",
  "features": [
    {
      "id": 601,
      "name": "Staff access",
      "actors": ["customer", "staff", "admin"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "staff-boundary" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true }
      ],
      "criteria": [
        { "id": "601a", "desc": "staff and administrators can open staff tools", "points": 2, "statedBy": "Staff and administrators can sign in and use staff areas.", "steps": [
          { "do": "expect", "actor": "staff", "testid": "staff-link" },
          { "do": "expect", "actor": "admin", "testid": "staff-link" }
        ] },
        { "id": "601b", "desc": "customers cannot open staff tools", "points": 2, "statedBy": "Staff areas are not available to customers.", "steps": [
          { "do": "expect", "actor": "customer", "testid": "staff-link", "absent": true }
        ] }
      ]
    },
    {
      "id": 610,
      "name": "Support intake",
      "actors": ["visitor"],
      "setup": [],
      "criteria": [
        { "id": "610a", "desc": "a visitor can open a ticket and receives a reference", "points": 2, "statedBy": "Anyone can open a support ticket and receives a reference.", "steps": [
          { "do": "click", "actor": "visitor", "testid": "support-link" },
          { "do": "fill", "actor": "visitor", "testid": "support-email", "text": "visitor@example.com" },
          { "do": "fill", "actor": "visitor", "testid": "support-subject", "text": "Damaged package" },
          { "do": "fill", "actor": "visitor", "testid": "support-message", "text": "The package arrived damaged." },
          { "do": "click", "actor": "visitor", "testid": "support-submit" },
          { "do": "expect", "actor": "visitor", "testid": "support-reference", "nonEmpty": true }
        ] }
      ]
    },
    {
      "id": 611,
      "name": "Support triage",
      "actors": ["visitor", "staff"],
      "setup": [
        { "do": "click", "actor": "visitor", "testid": "support-link" },
        { "do": "fill", "actor": "visitor", "testid": "support-email", "text": "triage@example.com" },
        { "do": "fill", "actor": "visitor", "testid": "support-subject", "text": "Missing item" },
        { "do": "fill", "actor": "visitor", "testid": "support-message", "text": "One item is missing." },
        { "do": "click", "actor": "visitor", "testid": "support-submit" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true }
      ],
      "criteria": [
        { "id": "611a", "desc": "staff can assign and prioritize a new ticket", "points": 3, "statedBy": "Staff can triage support tickets.", "steps": [
          { "do": "click", "actor": "staff", "testid": "staff-link" },
          { "do": "fill", "actor": "staff", "testid": "support-assignee", "in": { "testid": "support-ticket", "contains": "Missing item" }, "text": "staff" },
          { "do": "fill", "actor": "staff", "testid": "support-priority", "in": { "testid": "support-ticket", "contains": "Missing item" }, "text": "high" },
          { "do": "click", "actor": "staff", "testid": "support-assign", "in": { "testid": "support-ticket", "contains": "Missing item" } },
          { "do": "expect", "actor": "staff", "testid": "support-ticket", "contains": "high" }
        ] }
      ]
    },
    {
      "id": 612,
      "name": "Customer support history",
      "actors": ["owner", "other"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "support-owner" },
        { "do": "click", "actor": "owner", "testid": "support-link" },
        { "do": "fill", "actor": "owner", "testid": "support-subject", "text": "Owner ticket" },
        { "do": "fill", "actor": "owner", "testid": "support-message", "text": "Private account issue." },
        { "do": "click", "actor": "owner", "testid": "support-submit" },
        { "do": "signUp", "actor": "other", "name": "support-other" }
      ],
      "criteria": [
        { "id": "612a", "desc": "the owner sees the ticket after reload", "points": 2, "statedBy": "A customer's support history persists.", "steps": [
          { "do": "reload", "actor": "owner", "settleMs": 3000 },
          { "do": "click", "actor": "owner", "testid": "support-link" },
          { "do": "expect", "actor": "owner", "testid": "support-ticket", "contains": "Owner ticket" }
        ] },
        { "id": "612b", "desc": "another customer cannot see the ticket", "points": 2, "statedBy": "Customers cannot see another customer's support tickets.", "steps": [
          { "do": "click", "actor": "other", "testid": "support-link" },
          { "do": "expect", "actor": "other", "testid": "support-ticket", "contains": "Owner ticket", "absent": true }
        ] }
      ]
    },
    {
      "id": 613,
      "name": "Managed support cases",
      "actors": ["owner", "staff"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "managed-case" },
        { "do": "click", "actor": "owner", "testid": "support-link" },
        { "do": "fill", "actor": "owner", "testid": "support-subject", "text": "Managed case" },
        { "do": "fill", "actor": "owner", "testid": "support-message", "text": "Please investigate." },
        { "do": "click", "actor": "owner", "testid": "support-submit" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true }
      ],
      "criteria": [
        { "id": "613a", "desc": "a staff reply and status update reach the customer live", "points": 3, "statedBy": "Staff and customers see one shared support case.", "steps": [
          { "do": "click", "actor": "staff", "testid": "staff-link" },
          { "do": "fill", "actor": "staff", "testid": "support-reply", "in": { "testid": "support-ticket", "contains": "Managed case" }, "text": "We are investigating." },
          { "do": "click", "actor": "staff", "testid": "support-reply-submit", "in": { "testid": "support-ticket", "contains": "Managed case" } },
          { "do": "expect", "actor": "owner", "testid": "support-ticket", "contains": "We are investigating.", "within": 10000 }
        ] }
      ]
    },
    {
      "id": 614,
      "name": "Order-linked support",
      "actors": ["owner", "other", "staff"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "case-order-owner" },
        { "do": "click", "actor": "owner", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
        { "do": "click", "actor": "owner", "testid": "support-link" },
        { "do": "fill", "actor": "owner", "testid": "support-subject", "text": "Order case" },
        { "do": "fill", "actor": "owner", "testid": "support-message", "text": "Question about my order." },
        { "do": "click", "actor": "owner", "testid": "support-submit" },
        { "do": "signUp", "actor": "other", "name": "case-order-other" },
        { "do": "click", "actor": "other", "testid": "support-link" },
        { "do": "fill", "actor": "other", "testid": "support-subject", "text": "Other case" },
        { "do": "fill", "actor": "other", "testid": "support-message", "text": "My separate case." },
        { "do": "click", "actor": "other", "testid": "support-submit" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true }
      ],
      "criteria": [
        { "id": "614a", "desc": "the owner can link their order and staff can inspect it", "points": 3, "statedBy": "A customer can attach one of their orders to a support case.", "steps": [
          { "do": "click", "actor": "owner", "testid": "support-link-order", "in": { "testid": "support-ticket", "contains": "Order case" } },
          { "do": "click", "actor": "staff", "testid": "staff-link" },
          { "do": "expect", "actor": "staff", "testid": "support-order", "in": { "testid": "support-ticket", "contains": "Order case" }, "contains": "Desk Lamp", "within": 10000 }
        ] },
        { "id": "614b", "desc": "another customer cannot attach the owner's order", "points": 2, "statedBy": "A customer cannot attach another customer's order.", "steps": [
          { "do": "click", "actor": "other", "testid": "support-link" },
          { "do": "expect", "actor": "other", "testid": "support-order", "in": { "testid": "support-ticket", "contains": "Other case" }, "contains": "Desk Lamp", "absent": true }
        ] }
      ]
    },
    {
      "id": 615,
      "name": "Support refunds",
      "actors": ["owner", "staff"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "case-refund-owner" },
        { "do": "click", "actor": "owner", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } },
        { "do": "click", "actor": "owner", "testid": "support-link" },
        { "do": "fill", "actor": "owner", "testid": "support-subject", "text": "Refund case" },
        { "do": "fill", "actor": "owner", "testid": "support-message", "text": "Please refund this order." },
        { "do": "click", "actor": "owner", "testid": "support-submit" },
        { "do": "click", "actor": "owner", "testid": "support-link-order", "in": { "testid": "support-ticket", "contains": "Refund case" } },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true }
      ],
      "criteria": [
        { "id": "615a", "desc": "staff resolution refunds the order and closes the case", "points": 4, "statedBy": "Authorized staff can resolve an order-linked case with a refund.", "steps": [
          { "do": "click", "actor": "staff", "testid": "staff-link" },
          { "do": "click", "actor": "staff", "testid": "support-refund", "in": { "testid": "support-ticket", "contains": "Refund case" } },
          { "do": "expect", "actor": "owner", "testid": "support-status", "in": { "testid": "support-ticket", "contains": "Refund case" }, "contains": "resolved", "within": 10000 },
          { "do": "click", "actor": "owner", "testid": "orders-toggle" },
          { "do": "expect", "actor": "owner", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "contains": "refunded", "within": 10000 }
        ] }
      ]
    }
  ]
}
