{
  "level": 2,
  "track": "ecommerce",
  "name": "Running the business — features",
  "writeUrlPattern": "\\/api\\/|\\/items|\\/cart|\\/orders|\\/checkout|\\/buy|\\/reviews|\\/stock|\\/restock|\\/warehouses|\\/transfer|\\/cancel|\\/return|\\/ship|\\/price|\\/fulfil",
  "note": "The level's thesis is that eight actions each touch several of ten live views. These features are therefore written as ONE action watched by SEVERAL viewers at once, not as one action checked once — a backend that updates the view the actor is looking at and forgets the others fails on the watcher, not on the actor. Items are reached by search because earlier features re-rank the storefront. Panels are closed with Escape, which the spec requires, rather than by clicking an opener again.",
  "features": [
    {
      "id": 1,
      "name": "Fulfilment queue",
      "actors": [
        "customer",
        "staff",
        "admin"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "customer",
          "name": "fq"
        },
        {
          "do": "signIn",
          "actor": "staff",
          "name": "staff",
          "password": "stackbench-staff-2026",
          "exact": true
        },
        {
          "do": "signIn",
          "actor": "admin",
          "name": "admin",
          "password": "stackbench-admin-2026",
          "exact": true
        }
      ],
      "criteria": [
        {
          "id": "1a",
          "desc": "an order placed by a customer appears in the staff queue without a reload",
          "points": 2,
          "steps": [
            {
              "do": "click",
              "actor": "staff",
              "testid": "staff-link"
            },
            {
              "do": "recordNumber",
              "actor": "staff",
              "testid": "queue-depth",
              "as": "depth-before"
            },
            {
              "do": "fill",
              "actor": "customer",
              "testid": "search-input",
              "text": "Desk Lamp",
              "enter": true,
              "settleMs": 1500
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "buy-now",
              "in": {
                "testid": "item-card",
                "contains": "Desk Lamp"
              }
            },
            {
              "do": "expect",
              "actor": "staff",
              "testid": "queue-item",
              "contains": "Desk Lamp",
              "within": 10000
            },
            {
              "do": "expectNumber",
              "actor": "staff",
              "testid": "queue-depth",
              "relativeTo": "depth-before",
              "plus": 1
            }
          ],
          "statedBy": "appears in the fulfilment queue in the order it was placed"
        },
        {
          "id": "1b",
          "desc": "the queue names the warehouse the order will ship from",
          "points": 1,
          "steps": [
            {
              "do": "expect",
              "actor": "staff",
              "testid": "queue-warehouse",
              "in": {
                "testid": "queue-item",
                "contains": "Desk Lamp"
              }
            }
          ],
          "statedBy": "which warehouse each will ship from"
        },
        {
          "id": "1c",
          "desc": "shipping removes the order from the queue for staff and marks it shipped for the customer, live",
          "points": 2,
          "steps": [
            {
              "do": "click",
              "actor": "staff",
              "testid": "ship-submit",
              "in": {
                "testid": "queue-item",
                "contains": "Desk Lamp"
              }
            },
            {
              "do": "expect",
              "actor": "staff",
              "testid": "queue-item",
              "contains": "Desk Lamp",
              "absent": true,
              "within": 10000
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "orders-toggle"
            },
            {
              "do": "expect",
              "actor": "customer",
              "testid": "order-status",
              "in": {
                "testid": "order-item",
                "contains": "Desk Lamp"
              },
              "contains": "hipped",
              "within": 10000
            }
          ],
          "statedBy": "it leaves the queue for everyone watching the queue, and the customer's order history shows it as shipped, live"
        },
        {
          "id": "1d",
          "desc": "the fulfilment area is for staff and admins, not customers",
          "points": 1,
          "steps": [
            {
              "do": "expect",
              "actor": "admin",
              "testid": "staff-link"
            },
            {
              "do": "expect",
              "actor": "customer",
              "testid": "staff-link",
              "absent": true
            }
          ],
          "statedBy": "a staff account signs in like anyone else but sees the fulfilment area instead of the admin area"
        },
        {
          "id": "1e",
          "desc": "the server refuses a ship request from a customer, not just the button",
          "points": 2,
          "statedBy": "staff cannot change prices or create items; admins can do everything staff can",
          "steps": [
            {
              "do": "fill",
              "actor": "customer",
              "testid": "search-input",
              "text": "Webcam",
              "enter": true,
              "settleMs": 1500
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "buy-now",
              "in": {
                "testid": "item-card",
                "contains": "Webcam"
              }
            },
            {
              "do": "wait",
              "actor": "customer",
              "ms": 2500
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "orders-toggle"
            },
            {
              "do": "replayAs",
              "actor": "customer",
              "from": "staff",
              "match": "ship",
              "namedAction": {
                "id": "ship",
                "path": "/api/fulfilment/ship",
                "reducer": "ship_order",
                "args": [0]
              },
              "namedTarget": {
                "testid": "order-item",
                "contains": "Webcam",
                "attribute": "data-entity-id",
                "valueType": "number"
              },
              "swap": {
                "find": "Desk Lamp",
                "with": "Webcam"
              },
              "settleMs": 2500
            },
            {
              "do": "expectReplayRejected",
              "actor": "customer"
            },
            {
              "do": "expect",
              "actor": "customer",
              "testid": "order-status",
              "in": {
                "testid": "order-item",
                "contains": "Webcam"
              },
              "notContains": "hipped"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "name": "Moving stock between warehouses",
      "actors": [
        "admin",
        "staff",
        "visitor"
      ],
      "setup": [
        {
          "do": "signIn",
          "actor": "admin",
          "name": "admin",
          "password": "stackbench-admin-2026",
          "exact": true
        },
        {
          "do": "signIn",
          "actor": "staff",
          "name": "staff",
          "password": "stackbench-staff-2026",
          "exact": true
        },
        {
          "do": "click",
          "actor": "admin",
          "testid": "admin-link"
        }
      ],
      "criteria": [
        {
          "id": "2a",
          "desc": "a transfer moves stock without creating or destroying any",
          "points": 3,
          "steps": [
            {
              "do": "recordNumber",
              "actor": "visitor",
              "testid": "item-stock",
              "in": {
                "testid": "item-card",
                "contains": "Headphones"
              },
              "as": "total-before"
            },
            {
              "do": "recordNumber",
              "actor": "admin",
              "testid": "admin-location-qty",
              "in": {
                "testid": "admin-location-row",
                "contains": "Headphones"
              },
              "as": "east-before"
            },
            {
              "do": "recordNumber",
              "actor": "admin",
              "testid": "warehouse-total",
              "in": {
                "testid": "admin-warehouse-item",
                "contains": "West"
              },
              "as": "west-before"
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "transfer-from",
              "text": "East",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              }
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "transfer-to",
              "text": "West",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              }
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "transfer-qty",
              "text": "10",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              }
            },
            {
              "do": "click",
              "actor": "admin",
              "testid": "transfer-submit",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              }
            },
            {
              "do": "wait",
              "actor": "admin",
              "ms": 2500
            },
            {
              "do": "expectNumber",
              "actor": "admin",
              "testid": "admin-location-qty",
              "in": {
                "testid": "admin-location-row",
                "contains": "Headphones"
              },
              "relativeTo": "east-before",
              "plus": -10
            },
            {
              "do": "expectNumber",
              "actor": "visitor",
              "testid": "item-stock",
              "in": {
                "testid": "item-card",
                "contains": "Headphones"
              },
              "relativeTo": "total-before",
              "plus": 0
            }
          ],
          "statedBy": "a transfer moves stock, it does not create or destroy it"
        },
        {
          "id": "2b",
          "desc": "the warehouse totals move live as stock is transferred",
          "points": 2,
          "steps": [
            {
              "do": "expectNumber",
              "actor": "admin",
              "testid": "warehouse-total",
              "in": {
                "testid": "admin-warehouse-item",
                "contains": "West"
              },
              "relativeTo": "west-before",
              "plus": 10,
              "within": 10000
            }
          ],
          "statedBy": "the per-warehouse numbers staff and admins see both move at once"
        },
        {
          "id": "2c",
          "desc": "a transfer that would overdraw a warehouse is refused and changes nothing",
          "points": 2,
          "steps": [
            {
              "do": "recordNumber",
              "actor": "admin",
              "testid": "admin-stock",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              },
              "as": "total-guard"
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "transfer-from",
              "text": "East",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              }
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "transfer-to",
              "text": "West",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              }
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "transfer-qty",
              "text": "99999",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              }
            },
            {
              "do": "click",
              "actor": "admin",
              "testid": "transfer-submit",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              }
            },
            {
              "do": "expect",
              "actor": "admin",
              "testid": "order-error",
              "within": 6000
            },
            {
              "do": "expectNumber",
              "actor": "admin",
              "testid": "admin-stock",
              "in": {
                "testid": "admin-item-row",
                "contains": "Headphones"
              },
              "relativeTo": "total-guard",
              "plus": 0
            }
          ],
          "statedBy": "a transfer that would leave a warehouse short is refused and changes nothing"
        }
      ]
    },
    {
      "id": 3,
      "name": "Cancelling and returning",
      "actors": [
        "customer",
        "staff",
        "admin"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "customer",
          "name": "cr"
        },
        {
          "do": "signIn",
          "actor": "staff",
          "name": "staff",
          "password": "stackbench-staff-2026",
          "exact": true
        },
        {
          "do": "signIn",
          "actor": "admin",
          "name": "admin",
          "password": "stackbench-admin-2026",
          "exact": true
        },
        {
          "do": "click",
          "actor": "admin",
          "testid": "admin-link"
        },
        {
          "do": "click",
          "actor": "staff",
          "testid": "staff-link"
        }
      ],
      "criteria": [
        {
          "id": "3a",
          "desc": "cancelling a pending order returns its stock, empties it from the queue and lowers revenue",
          "points": 3,
          "steps": [
            {
              "do": "recordNumber",
              "actor": "admin",
              "testid": "admin-revenue",
              "as": "rev-before"
            },
            {
              "do": "fill",
              "actor": "customer",
              "testid": "search-input",
              "text": "Coffee Grinder",
              "enter": true,
              "settleMs": 1500
            },
            {
              "do": "recordNumber",
              "actor": "customer",
              "testid": "item-stock",
              "in": {
                "testid": "item-card",
                "contains": "Coffee Grinder"
              },
              "as": "stock-before"
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "buy-now",
              "in": {
                "testid": "item-card",
                "contains": "Coffee Grinder"
              }
            },
            {
              "do": "wait",
              "actor": "customer",
              "ms": 2500
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "orders-toggle"
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "cancel-order",
              "in": {
                "testid": "order-item",
                "contains": "Coffee Grinder"
              }
            },
            {
              "do": "wait",
              "actor": "customer",
              "ms": 2500
            },
            {
              "do": "expect",
              "actor": "staff",
              "testid": "queue-item",
              "contains": "Coffee Grinder",
              "absent": true,
              "within": 10000
            },
            {
              "do": "expectNumber",
              "actor": "admin",
              "testid": "admin-revenue",
              "relativeTo": "rev-before",
              "plus": 0,
              "within": 10000
            },
            {
              "do": "pressKey",
              "actor": "customer",
              "key": "Escape"
            },
            {
              "do": "expectNumber",
              "actor": "customer",
              "testid": "item-stock",
              "in": {
                "testid": "item-card",
                "contains": "Coffee Grinder"
              },
              "relativeTo": "stock-before",
              "plus": 0
            }
          ],
          "statedBy": "the stock goes back to the warehouse it came from, the order leaves the fulfilment queue, and revenue falls"
        },
        {
          "id": "3b",
          "desc": "a cancelled order is shown as cancelled in the customer’s history",
          "points": 1,
          "steps": [
            {
              "do": "click",
              "actor": "customer",
              "testid": "orders-toggle",
              "settleMs": 1200
            },
            {
              "do": "expect",
              "actor": "customer",
              "testid": "order-status",
              "in": {
                "testid": "order-item",
                "contains": "Coffee Grinder"
              },
              "contains": "ancel",
              "within": 8000
            }
          ],
          "statedBy": "a customer can cancel an order that has not shipped"
        },
        {
          "id": "3c",
          "desc": "returning an item from a shipped order brings the stock back and lowers revenue",
          "points": 3,
          "steps": [
            {
              "do": "fill",
              "actor": "customer",
              "testid": "search-input",
              "text": "Keyboard",
              "enter": true,
              "settleMs": 1500
            },
            {
              "do": "recordNumber",
              "actor": "customer",
              "testid": "item-stock",
              "in": {
                "testid": "item-card",
                "contains": "Keyboard"
              },
              "as": "kb-before"
            },
            {
              "do": "recordNumber",
              "actor": "admin",
              "testid": "admin-revenue",
              "as": "rev2-before"
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "buy-now",
              "in": {
                "testid": "item-card",
                "contains": "Keyboard"
              }
            },
            {
              "do": "wait",
              "actor": "customer",
              "ms": 2500
            },
            {
              "do": "click",
              "actor": "staff",
              "testid": "ship-submit",
              "in": {
                "testid": "queue-item",
                "contains": "Keyboard"
              }
            },
            {
              "do": "wait",
              "actor": "staff",
              "ms": 2500
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "orders-toggle"
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "return-item",
              "in": {
                "testid": "order-item",
                "contains": "Keyboard"
              }
            },
            {
              "do": "wait",
              "actor": "customer",
              "ms": 2500
            },
            {
              "do": "expectNumber",
              "actor": "admin",
              "testid": "admin-revenue",
              "relativeTo": "rev2-before",
              "plus": 0,
              "within": 10000
            },
            {
              "do": "pressKey",
              "actor": "customer",
              "key": "Escape"
            },
            {
              "do": "expectNumber",
              "actor": "customer",
              "testid": "item-stock",
              "in": {
                "testid": "item-card",
                "contains": "Keyboard"
              },
              "relativeTo": "kb-before",
              "plus": 0
            }
          ],
          "statedBy": "the stock comes back, revenue falls by what was paid for it, and the order shows the item as returned"
        }
      ]
    },
    {
      "id": 4,
      "name": "Prices change, history does not",
      "actors": [
        "admin",
        "customer",
        "visitor"
      ],
      "setup": [
        {
          "do": "signIn",
          "actor": "admin",
          "name": "admin",
          "password": "stackbench-admin-2026",
          "exact": true
        },
        {
          "do": "signUp",
          "actor": "customer",
          "name": "pr"
        },
        {
          "do": "click",
          "actor": "admin",
          "testid": "admin-link"
        }
      ],
      "criteria": [
        {
          "id": "4a",
          "desc": "a customer's receipt keeps the price that was paid after the price changes",
          "points": 3,
          "steps": [
            {
              "do": "fill",
              "actor": "customer",
              "testid": "search-input",
              "text": "Air Purifier",
              "enter": true,
              "settleMs": 1500
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "buy-now",
              "in": {
                "testid": "item-card",
                "contains": "Air Purifier"
              }
            },
            {
              "do": "wait",
              "actor": "customer",
              "ms": 2500
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "price-input",
              "text": "1.00",
              "in": {
                "testid": "admin-item-row",
                "contains": "Air Purifier"
              }
            },
            {
              "do": "click",
              "actor": "admin",
              "testid": "price-submit",
              "in": {
                "testid": "admin-item-row",
                "contains": "Air Purifier"
              }
            },
            {
              "do": "wait",
              "actor": "admin",
              "ms": 2500
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "orders-toggle"
            },
            {
              "do": "expectNumber",
              "actor": "customer",
              "testid": "order-total",
              "in": {
                "testid": "order-item",
                "contains": "Air Purifier"
              },
              "atLeast": 189
            }
          ],
          "statedBy": "past orders keep the price that was paid"
        },
        {
          "id": "4b",
          "desc": "the new price reaches a signed-out visitor without a reload",
          "points": 2,
          "steps": [
            {
              "do": "fill",
              "actor": "visitor",
              "testid": "search-input",
              "text": "Air Purifier",
              "enter": true,
              "settleMs": 1500
            },
            {
              "do": "expectNumber",
              "actor": "visitor",
              "testid": "item-price",
              "in": {
                "testid": "item-card",
                "contains": "Air Purifier"
              },
              "equals": 1,
              "within": 10000
            }
          ],
          "statedBy": "the storefront shows the new price immediately, to everyone"
        },
        {
          "id": "4c",
          "desc": "a price change updates an open cart and checkout charges the new price",
          "points": 3,
          "steps": [
            {
              "do": "pressKey",
              "actor": "customer",
              "key": "Escape"
            },
            {
              "do": "fill",
              "actor": "customer",
              "testid": "search-input",
              "text": "Desk Lamp",
              "enter": true,
              "settleMs": 1500
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "add-to-cart",
              "in": {
                "testid": "item-card",
                "contains": "Desk Lamp"
              }
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "cart-toggle"
            },
            {
              "do": "expectNumber",
              "actor": "customer",
              "testid": "cart-total",
              "equals": 42
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "price-input",
              "text": "52.00",
              "in": {
                "testid": "admin-item-row",
                "contains": "Desk Lamp"
              }
            },
            {
              "do": "click",
              "actor": "admin",
              "testid": "price-submit",
              "in": {
                "testid": "admin-item-row",
                "contains": "Desk Lamp"
              }
            },
            {
              "do": "expectNumber",
              "actor": "customer",
              "testid": "cart-total",
              "equals": 52,
              "within": 10000
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "checkout-submit"
            },
            {
              "do": "click",
              "actor": "customer",
              "testid": "orders-toggle",
              "settleMs": 1500
            },
            {
              "do": "expectNumber",
              "actor": "customer",
              "testid": "order-total",
              "in": {
                "testid": "order-item",
                "contains": "Desk Lamp"
              },
              "equals": 52
            }
          ],
          "statedBy": "an item in someone's cart at the moment the price changes is charged the new price at checkout, and the cart total they are looking at updates to match"
        }
      ]
    },
    {
      "id": 5,
      "name": "The operational views",
      "actors": [
        "admin",
        "customer",
        "visitor"
      ],
      "setup": [
        {
          "do": "signIn",
          "actor": "admin",
          "name": "admin",
          "password": "stackbench-admin-2026",
          "exact": true
        },
        {
          "do": "signUp",
          "actor": "customer",
          "name": "ops"
        },
        {
