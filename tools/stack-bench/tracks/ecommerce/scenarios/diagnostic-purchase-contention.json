{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Purchase contention diagnostic",
  "note": "Draft diagnostic only; not selected by scored campaigns. Widths 1/4/16/64 are parallel buy requests cycled over two fresh customer accounts, not distinct client populations. Three cohorts per width reset Keyboard stock to128 East/0 West on an otherwise idle disposable L2 app. This tests affordable competing purchases and lost updates, not scarce-stock overselling, sustained throughput, or server execution overlap. All requests must be accepted; order counts and the stored stock decrement must match. Exact reference and defect qualification is pending.",
  "features": [
    {"id": 9100, "name": "1 parallel purchase requests, cohort 1", "actors": ["a", "b"],
      "setup": [
        {"do":"signUp","actor":"a","name":"purchase-1-1-a"},
        {"do":"signUp","actor":"b","name":"purchase-1-1-b"},
        {"do":"dbSetStock","item":"Keyboard","warehouse":"East","quantity":128,"settleMs":0},
        {"do":"dbSetStock","item":"Keyboard","warehouse":"West","quantity":0,"settleMs":1000},
        {"do":"dbExpectStock","item":"Keyboard","equals":128},
        {"do":"reload","actor":"a","settleMs":1000},
        {"do":"expectNumber","actor":"a","testid":"item-stock","in":{"testid":"item-card","contains":"Keyboard"},"equals":128,"within":10000},
        {"do":"dbRecordStock","item":"Keyboard","as":"stock-before"}
      ],
      "criteria": [{"id": "9100a", "category": "production", "points": 0,
        "desc": "every affordable purchase is accepted once, with matching account orders and stored stock",
        "steps": [
          {"do":"callConcurrently","actors":["a","b"],"action":"buy","namedAction":{"id":"buy","path":"/api/items/:id/buy","reducer":"buy_now","args":[0],"params":[{"name":"itemId","in":"path","placeholder":":id","wireType":"u64"}]},"input":{"testid":"item-card","contains":"Keyboard","attribute":"data-buy-input"},"requests":1,"requestTimeoutMs":30000,"settleMs":3000},
          {"do":"expectCallOutcomes","accepted":1},
          {"do":"dbExpectStock","item":"Keyboard","relativeTo":"stock-before","plus":-1},
          {"do":"reload","actor":"a","settleMs":1000},
          {"do":"ensureSignedIn","actor":"a","name":"purchase-1-1-a","readyTestid":"current-user"},
          {"do":"click","actor":"a","testid":"orders-toggle"},
          {"do":"expect","actor":"a","testid":"order-item","contains":"Keyboard","count":1,"within":10000},
          {"do":"reload","actor":"b","settleMs":1000},
          {"do":"ensureSignedIn","actor":"b","name":"purchase-1-1-b","readyTestid":"current-user"},
          {"do":"click","actor":"b","testid":"orders-toggle"},
          {"do":"expect","actor":"b","testid":"order-item","contains":"Keyboard","count":0,"within":10000}
        ]
      }]
    },
