              {"name": "Espresso Machine", "stock": {"East": 80, "West": 20}},
              {"name": "Gaming Mouse", "stock": {"East": 50, "West": 50}},
              {"name": "Headphones", "stock": {"East": 60, "West": 40}},
              {"name": "Induction Cooktop", "stock": {"East": 50, "West": 50}},
              {"name": "Keyboard", "stock": {"East": 70, "West": 30}},
              {"name": "Laptop Stand", "stock": {"East": 90, "West": 10}},
              {"name": "Mirrorless Camera", "stock": {"East": 2, "West": 1}},
              {"name": "USB Cable", "stock": {"East": 0, "West": 0}},
              {"name": "Webcam", "stock": {"East": 60, "West": 40}}
