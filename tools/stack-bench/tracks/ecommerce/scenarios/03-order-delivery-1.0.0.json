{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 3,
  "name": "Order delivery",
  "note": "L2 shipping remains immediate. L3 adds automatic delivery after shipping.",
  "features": [
    {
      "id": 303,
      "name": "A shipped order becomes delivered",
      "actors": ["customer", "staff"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "delivery-live" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "click", "actor": "staff", "testid": "staff-link" },
        { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Gaming Mouse" } },
        { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Gaming Mouse", "within": 10000 },
        { "do": "click", "actor": "staff", "testid": "ship-submit", "in": { "testid": "queue-item", "contains": "Gaming Mouse" } },
        { "do": "click", "actor": "customer", "testid": "orders-toggle" },
        { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Gaming Mouse" }, "contains": "hipped", "within": 10000 }
      ],
      "criteria": [{
        "id": "303a",
        "desc": "a shipped order becomes delivered for the customer and staff without a reload",
        "points": 3,
        "statedBy": "A shipped order becomes delivered after 60 seconds.",
        "steps": [
          { "do": "wait", "actor": "customer", "ms": 70000 },
          { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Gaming Mouse" }, "contains": "elivered", "within": 15000 },
          { "do": "expect", "actor": "staff", "testid": "completed-order-status", "in": { "testid": "completed-order-item", "contains": "Gaming Mouse" }, "contains": "elivered", "within": 15000 }
        ]
      }]
    },
    {
      "id": 305,
      "name": "Cancellation is final",
      "actors": ["customer"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "delivery-cancel" },
        { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } },
        { "do": "click", "actor": "customer", "testid": "orders-toggle" },
        { "do": "click", "actor": "customer", "testid": "cancel-order", "in": { "testid": "order-item", "contains": "Keyboard" } },
        { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "contains": "ancelled", "within": 10000 }
      ],
      "criteria": [{
        "id": "305a",
        "desc": "a cancelled order does not advance later",
        "points": 2,
        "statedBy": "A cancelled order never advances.",
        "steps": [
          { "do": "wait", "actor": "customer", "ms": 70000 },
          { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "contains": "ancelled" },
          { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "notContains": "elivered" }
        ]
      }]
    }
  ]
}
