{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Scheduled restocks",
  "note": "This check owns a separate scenario so pending work from another check cannot affect it.",
  "features": [
    {
      "id": 305,
      "name": "A due restock applies",
      "actors": ["admin", "watcher"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "click", "actor": "admin", "testid": "restocks-link", "ifAvailable": true },
        { "do": "recordNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "as": "before" }
      ],
      "criteria": [
        {
          "id": "305a",
          "category": "feature",
          "desc": "a due restock updates stock and moves to the ledger",
          "points": 3,
          "statedBy": "A due restock updates stock, leaves the pending list, and enters the stock ledger.",
          "steps": [
            { "do": "recordNumber", "actor": "admin", "testid": "stock-ledger-entry", "count": true, "as": "ledger-before" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Keyboard" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "West" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "7" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "15" },
            { "do": "click", "actor": "admin", "testid": "schedule-restock-submit" },
            { "do": "wait", "actor": "admin", "ms": 25000 },
            { "do": "reload", "actor": "watcher", "settleMs": 2000 },
            { "do": "reload", "actor": "admin", "settleMs": 2000 },
            { "do": "ensureSignedIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "admin", "testid": "admin-link", "ifAvailable": true },
            { "do": "click", "actor": "admin", "testid": "restocks-link", "ifAvailable": true },
            { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "relativeTo": "before", "plus": 7, "within": 15000 },
            { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "absent": true },
            { "do": "expectElementCount", "actor": "admin", "testid": "stock-ledger-entry", "relativeTo": "ledger-before", "plus": 1 }
          ]
        }
      ]
    }
  ]
}
