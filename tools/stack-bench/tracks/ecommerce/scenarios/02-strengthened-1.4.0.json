{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Ecommerce L2 strengthened observations",
  "note": "Corrected L2 criteria assert both sides of state transitions and the user-visible outcomes required by the product brief.",
  "features": [
    {
      "id": 2,
      "name": "Moving stock between warehouses",
      "actors": ["admin", "visitor"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "fill", "actor": "visitor", "testid": "search-input", "text": "Headphones", "enter": true, "settleMs": 1500 }
      ],
      "criteria": [
        {
          "id": "2a",
          "desc": "a transfer decreases the source, increases the destination, and preserves the item's exact total",
          "points": 3,
          "statedBy": "a transfer moves stock, it does not create or destroy it",
          "steps": [
            { "do": "recordNumber", "actor": "visitor", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "as": "transfer-item-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "as": "transfer-east-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "as": "transfer-west-before" },
            { "do": "fill", "actor": "admin", "testid": "transfer-from", "text": "East", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "fill", "actor": "admin", "testid": "transfer-to", "text": "West", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "fill", "actor": "admin", "testid": "transfer-qty", "text": "10", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "click", "actor": "admin", "testid": "transfer-submit", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "relativeTo": "transfer-east-before", "plus": -10, "within": 10000 },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "relativeTo": "transfer-west-before", "plus": 10, "within": 10000 },
            { "do": "expectNumber", "actor": "visitor", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "relativeTo": "transfer-item-before", "plus": 0, "within": 10000 }
          ]
        },
        {
          "id": "2c",
          "desc": "a transfer that would overdraw a warehouse is refused and changes neither warehouse nor the item total",
          "points": 2,
          "statedBy": "a transfer that would leave a warehouse short is refused and changes nothing",
          "steps": [
            { "do": "recordNumber", "actor": "visitor", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "as": "overdraw-item-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "as": "overdraw-east-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "as": "overdraw-west-before" },
            { "do": "fill", "actor": "admin", "testid": "transfer-from", "text": "East", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "fill", "actor": "admin", "testid": "transfer-to", "text": "West", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "fill", "actor": "admin", "testid": "transfer-qty", "text": "99999", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "click", "actor": "admin", "testid": "transfer-submit", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "expect", "actor": "admin", "testid": "order-error", "within": 6000 },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "relativeTo": "overdraw-east-before", "plus": 0 },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "relativeTo": "overdraw-west-before", "plus": 0 },
            { "do": "expectNumber", "actor": "visitor", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "relativeTo": "overdraw-item-before", "plus": 0 }
          ]
        }
      ]
    },
    {
      "id": 3,
      "name": "Returning a shipped item",
      "actors": ["customer", "staff", "admin"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "return-focused" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "click", "actor": "staff", "testid": "staff-link" },
        { "do": "click", "actor": "admin", "testid": "admin-link" }
      ],
      "criteria": [
        {
          "id": "3c",
          "desc": "returning a shipped item restores stock and revenue and visibly marks the item returned",
          "points": 3,
          "statedBy": "the stock comes back, revenue falls by what was paid for it, and the order shows the item as returned",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Keyboard", "enter": true, "settleMs": 1500 },
            { "do": "recordNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "as": "return-stock-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "admin-revenue", "as": "return-revenue-before" },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Keyboard", "within": 10000 },
            { "do": "click", "actor": "staff", "testid": "ship-submit", "in": { "testid": "queue-item", "contains": "Keyboard" } },
            { "do": "click", "actor": "customer", "testid": "orders-toggle", "settleMs": 1500 },
            { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "contains": "hipped", "within": 10000 },
            { "do": "click", "actor": "customer", "testid": "return-item", "in": { "testid": "order-item", "contains": "Keyboard" } },
            { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "contains": "eturn", "within": 10000 },
            { "do": "expectNumber", "actor": "admin", "testid": "admin-revenue", "relativeTo": "return-revenue-before", "plus": 0, "within": 10000 },
            { "do": "pressKey", "actor": "customer", "key": "Escape" },
            { "do": "expectNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "relativeTo": "return-stock-before", "plus": 0 }
          ]
        }
      ]
    },
    {
      "id": 4,
      "name": "Prices change, history does not",
      "actors": ["admin", "customer", "visitor"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signUp", "actor": "customer", "name": "history-focused" },
        { "do": "click", "actor": "admin", "testid": "admin-link" }
      ],
      "criteria": [
        {
          "id": "4a",
          "desc": "a price change updates the live catalog but leaves the customer's exact paid price unchanged",
          "points": 3,
          "statedBy": "past orders keep the price that was paid",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Air Purifier", "enter": true, "settleMs": 1500 },
            { "do": "recordNumber", "actor": "customer", "testid": "item-price", "in": { "testid": "item-card", "contains": "Air Purifier" }, "as": "air-purifier-paid" },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Air Purifier" }, "settleMs": 2000 },
            { "do": "fill", "actor": "visitor", "testid": "search-input", "text": "Air Purifier", "enter": true, "settleMs": 1500 },
            { "do": "fill", "actor": "admin", "testid": "price-input", "text": "1.00", "in": { "testid": "admin-item-row", "contains": "Air Purifier" } },
            { "do": "click", "actor": "admin", "testid": "price-submit", "in": { "testid": "admin-item-row", "contains": "Air Purifier" } },
            { "do": "expectNumber", "actor": "visitor", "testid": "item-price", "in": { "testid": "item-card", "contains": "Air Purifier" }, "equals": 1, "within": 10000 },
            { "do": "click", "actor": "customer", "testid": "orders-toggle" },
            { "do": "expectNumber", "actor": "customer", "testid": "order-total", "in": { "testid": "order-item", "contains": "Air Purifier" }, "relativeTo": "air-purifier-paid", "plus": 0 }
          ]
        }
      ]
    },
    {
      "id": 5,
      "name": "Best sellers count only kept purchases",
      "actors": ["customer", "staff", "visitor"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "best-seller-focused" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "click", "actor": "staff", "testid": "staff-link" }
      ],
      "criteria": [
        {
          "id": "5d",
          "desc": "signed-out best sellers include kept purchases and exclude purchases that are cancelled or returned",
          "points": 1,
          "statedBy": "A cancelled or returned order's items stop counting as purchases",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Desk Lamp", "enter": true, "settleMs": 1200 },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
            { "do": "expect", "actor": "visitor", "testid": "recommended-item", "contains": "Desk Lamp", "within": 10000 },

            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Webcam", "enter": true, "settleMs": 1200 },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Webcam" } },
            { "do": "expect", "actor": "visitor", "testid": "recommended-item", "contains": "Webcam", "within": 10000 },
            { "do": "click", "actor": "customer", "testid": "orders-toggle" },
            { "do": "click", "actor": "customer", "testid": "cancel-order", "in": { "testid": "order-item", "contains": "Webcam" } },
            { "do": "expect", "actor": "visitor", "testid": "recommended-item", "contains": "Webcam", "absent": true, "within": 10000 },
            { "do": "pressKey", "actor": "customer", "key": "Escape" },

            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Coffee Grinder", "enter": true, "settleMs": 1200 },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Coffee Grinder" } },
            { "do": "expect", "actor": "visitor", "testid": "recommended-item", "contains": "Coffee Grinder", "within": 10000 },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Coffee Grinder", "within": 10000 },
            { "do": "click", "actor": "staff", "testid": "ship-submit", "in": { "testid": "queue-item", "contains": "Coffee Grinder" } },
            { "do": "click", "actor": "customer", "testid": "orders-toggle", "settleMs": 1500 },
            { "do": "click", "actor": "customer", "testid": "return-item", "in": { "testid": "order-item", "contains": "Coffee Grinder" } },
            { "do": "expect", "actor": "visitor", "testid": "recommended-item", "contains": "Coffee Grinder", "absent": true, "within": 10000 },
            { "do": "expect", "actor": "visitor", "testid": "recommended-item", "contains": "Desk Lamp", "within": 10000 }
          ]
        }
      ]
    },
    {
      "id": 201,
      "name": "Operating the store requires authorization",
      "actors": ["admin", "customer"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signUp", "actor": "customer", "name": "not-operator" },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Gaming Mouse", "enter": true, "settleMs": 1500 }
      ],
      "criteria": [
        {
          "id": "201a",
          "desc": "the server refuses a customer's direct transfer and neither warehouse nor the item total changes",
          "points": 2,
          "statedBy": "An admin can transfer a number of units of an item from one warehouse to another",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Headphones", "enter": true, "settleMs": 1500 },
            { "do": "recordNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "as": "unauthorized-item-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "as": "unauthorized-east-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "as": "unauthorized-west-before" },
            {
              "do": "callAction",
              "actor": "customer",
              "from": "admin",
              "action": "transfer",
              "namedAction": {
                "id": "transfer",
                "path": "/api/admin/transfer",
                "reducer": "admin_transfer_stock",
                "args": [0, 0, 0, 25],
                "params": [
                  { "name": "itemId", "in": "body", "wireType": "u64" },
                  { "name": "fromWarehouseId", "in": "body", "wireType": "u64" },
                  { "name": "toWarehouseId", "in": "body", "wireType": "u64" },
                  { "name": "quantity", "in": "body" }
                ]
              },
              "input": { "testid": "admin-item-row", "contains": "Headphones", "attribute": "data-transfer-input" },
              "settleMs": 2000
            },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "refused" },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "relativeTo": "unauthorized-east-before", "plus": 0 },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "relativeTo": "unauthorized-west-before", "plus": 0 },
            { "do": "expectNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "relativeTo": "unauthorized-item-before", "plus": 0 }
          ]
        },
        {
          "id": "201b",
          "desc": "the server refuses a customer's direct price change and the last accepted price remains exact",
          "points": 2,
          "statedBy": "an admin can change an item's price",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Gaming Mouse", "enter": true, "settleMs": 1500 },
            { "do": "fill", "actor": "admin", "testid": "price-input", "text": "77.00", "in": { "testid": "admin-item-row", "contains": "Gaming Mouse" } },
            { "do": "click", "actor": "admin", "testid": "price-submit", "in": { "testid": "admin-item-row", "contains": "Gaming Mouse" } },
            { "do": "expectNumber", "actor": "customer", "testid": "item-price", "in": { "testid": "item-card", "contains": "Gaming Mouse" }, "equals": 77, "within": 10000 },
            {
              "do": "callAction",
              "actor": "customer",
              "from": "admin",
              "action": "price",
              "namedAction": {
                "id": "price",
                "path": "/api/admin/price",
                "reducer": "admin_change_price",
                "args": [0, 1],
                "params": [
                  { "name": "itemId", "in": "body", "wireType": "u64" },
                  { "name": "price", "in": "body" }
                ]
              },
              "input": { "testid": "admin-item-row", "contains": "Gaming Mouse", "attribute": "data-price-input" },
              "settleMs": 2000
            },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "refused" },
            { "do": "expectNumber", "actor": "customer", "testid": "item-price", "in": { "testid": "item-card", "contains": "Gaming Mouse" }, "equals": 77, "within": 10000 }
          ]
        }
      ]
    },
    {
      "id": 202,
      "name": "Stock is conserved however it moves",
      "actors": ["admin", "customer"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signUp", "actor": "customer", "name": "directional-stock" },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Espresso Machine", "enter": true, "settleMs": 1500 }
      ],
      "criteria": [
        {
          "id": "202a",
          "desc": "a transfer decreases East, increases West, and leaves the item's exact total unchanged",
          "points": 2,
          "statedBy": "a transfer moves stock, it does not create or destroy it",
          "steps": [
            { "do": "recordNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Espresso Machine" }, "as": "conservation-item-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "as": "conservation-east-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "as": "conservation-west-before" },
            { "do": "fill", "actor": "admin", "testid": "transfer-from", "text": "East", "in": { "testid": "admin-item-row", "contains": "Espresso Machine" } },
            { "do": "fill", "actor": "admin", "testid": "transfer-to", "text": "West", "in": { "testid": "admin-item-row", "contains": "Espresso Machine" } },
            { "do": "fill", "actor": "admin", "testid": "transfer-qty", "text": "17", "in": { "testid": "admin-item-row", "contains": "Espresso Machine" } },
            { "do": "click", "actor": "admin", "testid": "transfer-submit", "in": { "testid": "admin-item-row", "contains": "Espresso Machine" } },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "relativeTo": "conservation-east-before", "plus": -17, "within": 10000 },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "relativeTo": "conservation-west-before", "plus": 17, "within": 10000 },
            { "do": "expectNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Espresso Machine" }, "relativeTo": "conservation-item-before", "plus": 0, "within": 10000 }
          ]
        }
      ]
    }
  ]
}
