{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 3,
  "name": "Faceted search",
  "features": [
    {
      "id": 401,
      "name": "Filters compose",
      "actors": ["visitor"],
      "setup": [
        { "do": "fill", "actor": "visitor", "testid": "category-filter", "text": "Audio" },
        { "do": "fill", "actor": "visitor", "testid": "maximum-price", "text": "100" },
        { "do": "click", "actor": "visitor", "testid": "in-stock-filter" }
      ],
      "criteria": [
        {
          "id": "401a",
          "desc": "combined filters return only matching items",
          "points": 3,
          "statedBy": "Catalogue filters work together.",
          "steps": [
            { "do": "expectElementCount", "actor": "visitor", "testid": "item-card", "contains": "Bluetooth Speaker", "equals": 1, "within": 10000 },
            { "do": "expect", "actor": "visitor", "testid": "item-card", "in": { "testid": "search-results" }, "contains": "Bluetooth Speaker" }
          ]
        }
      ]
    },
    {
      "id": 402,
      "name": "Pages are stable",
      "actors": ["visitor"],
      "setup": [],
      "criteria": [
        {
          "id": "402a",
          "desc": "moving between pages returns the same ordered items without duplicates",
          "points": 3,
          "statedBy": "Search results have stable pages without missing or repeated items.",
          "steps": [
            { "do": "expectSequence", "actor": "visitor", "testid": "item-card", "in": { "testid": "search-results" }, "equals": ["Air Purifier", "Bluetooth Speaker", "Coffee Grinder", "Desk Lamp", "Espresso Machine", "Gaming Mouse", "Headphones", "Induction Cooktop", "Keyboard", "Laptop Stand"] },
            { "do": "click", "actor": "visitor", "testid": "search-next-page" },
            { "do": "expectSequence", "actor": "visitor", "testid": "item-card", "in": { "testid": "search-results" }, "equals": ["Mirrorless Camera", "Webcam"] },
            { "do": "click", "actor": "visitor", "testid": "search-previous-page" },
            { "do": "expectSequence", "actor": "visitor", "testid": "item-card", "in": { "testid": "search-results" }, "equals": ["Air Purifier", "Bluetooth Speaker", "Coffee Grinder", "Desk Lamp", "Espresso Machine", "Gaming Mouse", "Headphones", "Induction Cooktop", "Keyboard", "Laptop Stand"] }
          ]
        }
      ]
    }
  ]
}
