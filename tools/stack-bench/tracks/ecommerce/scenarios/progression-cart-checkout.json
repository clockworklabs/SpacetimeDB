{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Cart and checkout",
  "note": "Draft: checkout must book every item at its stored price in one order and empty the whole cart. A subsequent two-item request includes a false price; it may be refused with orders and cart unchanged or accepted at stored prices. Independent order-data reads reconcile both outcomes. Stock is checked on the normal UI path only; this does not claim multi-item crash atomicity or independent attack-stock reconciliation. An independent session then adds a second product during checkout. Both calls must succeed; the extra unit belongs either to that order or to the remaining cart, with exact stock reconciliation when warehouse access is part of the delivered task.",
  "features": [
    {
      "id": 4,
      "name": "Account cart and checkout",
      "actors": ["quantity", "checkout", "raceCheckout", "raceAdd"],
      "setup": [
        { "do": "signUp", "actor": "quantity", "name": "cart-quantity" },
        { "do": "signUp", "actor": "checkout", "name": "cart-checkout" }
      ],
      "criteria": [
        {
          "id": "4a",
          "category": "feature",
          "desc": "adding the same item twice raises its quantity instead of adding a second line",
          "points": 1,
          "statedBy": "Adding an existing cart item increases its quantity.",
          "steps": [
            { "do": "click", "actor": "quantity", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Headphones" } },
            { "do": "wait", "actor": "quantity", "ms": 800 },
            { "do": "click", "actor": "quantity", "testid": "overlay-close", "ifAvailable": true },
            { "do": "click", "actor": "quantity", "testid": "catalog-link", "ifAvailable": true },
            { "do": "click", "actor": "quantity", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Headphones" } },
            { "do": "click", "actor": "quantity", "testid": "cart-toggle", "unlessVisible": "cart-total" },
            { "do": "expect", "actor": "quantity", "testid": "cart-item", "contains": "Headphones", "count": 1 },
            { "do": "expectNumber", "actor": "quantity", "testid": "cart-quantity", "in": { "testid": "cart-item", "contains": "Headphones" }, "equals": 2 }
          ]
        },
        {
          "id": "4d",
          "category": "feature",
          "desc": "checkout creates one order, reduces stock, and empties the cart",
          "points": 2,
          "statedBy": "Checkout creates one order, reduces stock, and empties the cart.",
          "steps": [
            { "do": "expectNumber", "actor": "checkout", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "equals": 100 },
            { "do": "dbRecordCheckout", "account": "{user:cart-checkout}", "item": "Desk Lamp", "as": "normal-before", "storage": { "kind": "order-data", "cart": true, "warehouses": false } },
            { "do": "click", "actor": "checkout", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
            { "do": "click", "actor": "checkout", "testid": "overlay-close", "ifAvailable": true },
            { "do": "click", "actor": "checkout", "testid": "catalog-link", "ifAvailable": true },
            { "do": "click", "actor": "checkout", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Coffee Grinder" } },
            { "do": "click", "actor": "checkout", "testid": "cart-toggle", "unlessVisible": "cart-total" },
            { "do": "expect", "actor": "checkout", "testid": "cart-item", "count": 2 },
            { "do": "dbRecordCheckout", "account": "{user:cart-checkout}", "item": "Desk Lamp", "as": "normal-prepared", "storage": { "kind": "order-data", "cart": true, "warehouses": false } },
            { "do": "click", "actor": "checkout", "testid": "checkout-submit" },
            { "do": "wait", "actor": "checkout", "ms": 1500 },
            { "do": "dbExpectCheckout", "before": "normal-before", "prepared": "normal-prepared", "quantity": [{ "item": "Desk Lamp", "quantity": 1 }, { "item": "Coffee Grinder", "quantity": 1 }] },
            { "do": "reload", "actor": "checkout", "settleMs": 2500 },
            { "do": "ensureSignedIn", "actor": "checkout", "name": "cart-checkout", "readyTestid": "current-user" },
            { "do": "click", "actor": "checkout", "testid": "cart-toggle", "unlessVisible": "cart-total" },
            { "do": "expectNumber", "actor": "checkout", "testid": "cart-count", "equals": 0 },
            { "do": "click", "actor": "checkout", "testid": "overlay-close", "ifAvailable": true },
            { "do": "click", "actor": "checkout", "testid": "catalog-link", "ifAvailable": true },
            { "do": "expectNumber", "actor": "checkout", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "equals": 99 },
            { "do": "expectNumber", "actor": "checkout", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Coffee Grinder" }, "equals": 99 },
            {"do":"click","actor":"checkout","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
            { "do": "click", "actor": "checkout", "testid": "orders-toggle", "unlessVisible": "order-item" },
            { "do": "expect", "actor": "checkout", "testid": "order-item", "contains": "Desk Lamp", "count": 1 },
            { "do": "click", "actor": "checkout", "testid": "overlay-close", "ifAvailable": true },
            { "do": "click", "actor": "checkout", "testid": "catalog-link", "ifAvailable": true },
            { "do": "dbRecordCheckout", "account": "{user:cart-checkout}", "item": "Desk Lamp", "as": "claim-before", "storage": { "kind": "order-data", "cart": true, "warehouses": false } },
            { "do": "click", "actor": "checkout", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
            { "do": "click", "actor": "checkout", "testid": "overlay-close", "ifAvailable": true },
            { "do": "click", "actor": "checkout", "testid": "catalog-link", "ifAvailable": true },
            { "do": "click", "actor": "checkout", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Coffee Grinder" } },
            { "do": "click", "actor": "checkout", "testid": "cart-toggle", "unlessVisible": "cart-total" },
            { "do": "expect", "actor": "checkout", "testid": "cart-item", "count": 2 },
            { "do": "dbRecordCheckout", "account": "{user:cart-checkout}", "item": "Desk Lamp", "as": "claim-prepared", "storage": { "kind": "order-data", "cart": true, "warehouses": false } },
            { "do": "callAction", "actor": "checkout", "action": "checkout", "namedAction": { "id": "checkout", "path": "/api/checkout", "method": "POST", "reducer": "checkout", "args": [1], "params": [{ "name": "price", "in": "body" }] }, "settleMs": 0 },
            { "do": "expectActionOutcome", "actor": "checkout", "outcome": "completed" },
            { "do": "dbExpectCheckout", "actor": "checkout", "before": "claim-before", "prepared": "claim-prepared", "quantity": [{ "item": "Desk Lamp", "quantity": 1 }, { "item": "Coffee Grinder", "quantity": 1 }] },
            {"do":"signUp","actor":"raceCheckout","name":"checkout-overlap"},
            {"do":"signIn","actor":"raceAdd","name":"checkout-overlap"},
            {"do":"dbRecordCheckout","account":"{user:checkout-overlap}","item":"Desk Lamp","as":"overlap-before","storage":{"kind":"order-data","cart":true,"warehouses":"if-requested"}},
            {"do":"click","actor":"raceCheckout","testid":"add-to-cart","in":{"testid":"item-card","contains":"Desk Lamp"}},
            {"do":"click","actor":"raceCheckout","testid":"cart-toggle","unlessVisible":"cart-total"},
            {"do":"expect","actor":"raceCheckout","testid":"cart-item","contains":"Desk Lamp","count":1},
            {"do":"dbRecordCheckout","account":"{user:checkout-overlap}","item":"Desk Lamp","as":"overlap-prepared","storage":{"kind":"order-data","cart":true,"warehouses":"if-requested"}},
            {"do":"callConcurrently","actors":["raceCheckout"],"action":"checkout","namedAction":{"id":"checkout","path":"/api/checkout","method":"POST","reducer":"checkout","args":[]},"requests":1,"settleMs":0,"alongside":[{"actors":["raceAdd"],"action":"cart-add","namedAction":{"id":"cart-add","path":"/api/cart","method":"POST","reducer":"add_to_cart","args":[0],"params":[{"name":"itemId","in":"body","wireType":"u64"}]},"requests":1,"input":{"testid":"item-card","contains":"Coffee Grinder","attribute":"data-buy-input"}}]},
            {"do":"expectCallOutcomes","accepted":2},
            {"do":"dbExpectCheckout","before":"overlap-before","prepared":"overlap-prepared","quantity":[{"item":"Desk Lamp","quantity":1}],"alongsideAdd":"Coffee Grinder"}
          ]
        }
      ]
    }
  ]
}
