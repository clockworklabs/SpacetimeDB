{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 1,
  "name": "Warehouse administration through staff access",
  "features": [
    {
      "id": 7,
      "name": "Admin and warehouses",
      "actors": ["admin", "staff"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true }
      ],
      "criteria": [
        {
          "id": "7a",
          "desc": "the admin area is for administrators only",
          "points": 1,
          "statedBy": "administrators can open the administration area; other staff cannot",
          "steps": [
            { "do": "expect", "actor": "admin", "testid": "admin-link" },
            { "do": "expectUnavailable", "actor": "staff", "testid": "admin-link" },
            { "do": "expect", "actor": "staff", "testid": "admin-panel", "absent": true }
          ]
        },
        {
          "id": "7b",
          "desc": "admin lists every item, every warehouse, and what each warehouse holds",
          "points": 1,
          "statedBy": "admin lists every item with its stock, every warehouse, and the stock of each item in each warehouse",
          "steps": [
            { "do": "click", "actor": "admin", "testid": "admin-link" },
            { "do": "expect", "actor": "admin", "testid": "admin-item-row", "count": 13 },
            { "do": "expect", "actor": "admin", "testid": "admin-location-row", "count": 26 },
            { "do": "expect", "actor": "admin", "testid": "admin-warehouse-item", "contains": "East" },
            { "do": "expect", "actor": "admin", "testid": "admin-warehouse-item", "contains": "West" },
            { "do": "expectNumber", "actor": "admin", "testid": "admin-stock", "in": { "testid": "admin-item-row", "contains": "Gaming Mouse" }, "equals": 100 }
          ]
        }
      ]
    }
  ]
}
