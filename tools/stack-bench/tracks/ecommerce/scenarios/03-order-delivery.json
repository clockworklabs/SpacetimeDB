{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Order delivery",
  "note": "Draft: revised observations require matching reference and defect-control qualification.",
  "features": [
    {
      "id": 303,
      "name": "A shipped order becomes delivered",
      "actors": ["customer", "staff"],
      "setup": [
        {
          "do": "signUp",
          "actor": "customer",
          "name": "delivery-live"
        },
        {
          "do": "signIn",
          "actor": "staff",
          "name": "staff",
          "password": "stackbench-staff-2026",
          "exact": true
        },
        {
          "do": "click",
          "actor": "staff",
          "testid": "staff-link"
        },
        {
          "do": "click",
          "actor": "customer",
          "testid": "buy-now",
          "in": {
            "testid": "item-card",
            "contains": "Gaming Mouse"
          }
        },
        {
          "do": "reload",
          "actor": "staff",
          "settleMs": 1000
        },
        {
          "do": "ensureSignedIn",
          "actor": "staff",
          "name": "staff",
          "readyTestid": "current-user",
          "exact": true,
          "password": "stackbench-staff-2026"
        },
        {
          "do": "click",
          "actor": "staff",
          "testid": "overlay-close",
          "ifAvailable": true,
          "within": 1000
        },
        {
          "do": "click",
          "actor": "staff",
          "testid": "staff-link",
          "unlessVisible": "queue-item"
        },
        {
          "do": "expect",
          "actor": "staff",
          "testid": "queue-item",
          "contains": "Gaming Mouse",
          "within": 10000
        },
        {
          "do": "click",
          "actor": "staff",
          "testid": "ship-submit",
          "in": {
            "testid": "queue-item",
            "contains": "Gaming Mouse"
          }
        },
        {
          "do": "click",
          "actor": "customer",
          "testid": "overlay-close",
          "ifAvailable": true,
          "unlessVisible": "order-item",
          "within": 1000
        },
        {
          "do": "reload",
          "actor": "customer",
          "settleMs": 1000
        },
        {
          "do": "ensureSignedIn",
          "actor": "customer",
          "name": "delivery-live",
          "readyTestid": "current-user"
        },
        {
          "do": "click",
          "actor": "customer",
          "testid": "overlay-close",
          "ifAvailable": true,
          "within": 1000
        },
        {
          "do": "click",
          "actor": "customer",
          "testid": "orders-toggle"
        },
        {
          "do": "expect",
          "actor": "customer",
          "testid": "order-status",
          "in": {
            "testid": "order-item",
            "contains": "Gaming Mouse"
          },
          "value": "shipped",
          "ignoreCase": true,
          "within": 10000
        }
      ],
      "criteria": [{
        "id": "303a",
        "category": "production",
        "desc": "a shipped order becomes delivered in customer and staff views",
        "points": 3,
        "statedBy": "A shipped order becomes delivered after 60 seconds.",
        "steps": [
          {
            "do": "wait",
            "actor": "customer",
            "ms": 70000
          },
          {
            "do": "reload",
            "actor": "customer",
            "settleMs": 1000
          },
          {
            "do": "ensureSignedIn",
            "actor": "customer",
            "name": "delivery-live",
            "readyTestid": "current-user"
          },
          {
            "do": "click",
            "actor": "customer",
            "testid": "overlay-close",
            "ifAvailable": true,
            "within": 1000
          },
          {
            "do": "click",
            "actor": "customer",
            "testid": "orders-toggle",
            "unlessVisible": "order-item"
          },
          {
            "do": "expect",
            "actor": "customer",
            "testid": "order-status",
            "in": {
              "testid": "order-item",
              "contains": "Gaming Mouse"
            },
            "value": "delivered",
            "ignoreCase": true,
            "within": 15000
          },
          {
            "do": "reload",
            "actor": "staff",
            "settleMs": 1000
          },
          {
            "do": "ensureSignedIn",
            "actor": "staff",
            "name": "staff",
            "readyTestid": "current-user",
            "exact": true,
            "password": "stackbench-staff-2026"
          },
          {
            "do": "click",
            "actor": "staff",
            "testid": "overlay-close",
            "ifAvailable": true,
            "within": 1000
          },
          {
            "do": "click",
            "actor": "staff",
            "testid": "staff-link",
            "unlessVisible": "completed-order-item"
          },
          {
            "do": "expect",
            "actor": "staff",
            "testid": "completed-order-status",
            "in": {
              "testid": "completed-order-item",
              "contains": "Gaming Mouse"
            },
            "value": "delivered",
            "ignoreCase": true,
            "within": 15000
          }
        ]
      }]
    },
    {
      "id": 305,
      "name": "Cancellation is final",
      "actors": ["customer"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "delivery-cancel" },
        { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } },
        {"do":"click","actor":"customer","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
        { "do": "click", "actor": "customer", "testid": "orders-toggle" },
        { "do": "click", "actor": "customer", "testid": "cancel-order", "in": { "testid": "order-item", "contains": "Keyboard" } },
        { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "value": "cancelled", "ignoreCase": true, "within": 10000 }
      ],
      "criteria": [{
        "id": "305a",
        "category": "production",
        "desc": "a cancelled order remains cancelled after the delivery interval",
        "points": 2,
        "statedBy": "A cancelled order never advances.",
        "steps": [
          {"do":"wait","actor":"customer","ms":70000},
          {"do":"reload","actor":"customer","settleMs":1000},
          {"do":"ensureSignedIn","actor":"customer","name":"delivery-cancel","readyTestid":"current-user"},
          {"do":"click","actor":"customer","testid":"overlay-close","ifAvailable":true,"within":1000},
          {"do":"click","actor":"customer","testid":"orders-toggle","unlessVisible":"order-item"},
          {"do":"expect","actor":"customer","testid":"order-status","in":{"testid":"order-item","contains":"Keyboard"},"value":"cancelled","ignoreCase":true}
        ]
      }]
    }
  ]
}
