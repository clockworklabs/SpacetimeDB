      "criteria": [
        {
          "id": "762a",
          "category": "production",
          "desc": "Another customer cannot cancel an active subscription",
          "points": 2,
          "steps": [
            {"do":"callAction","actor":"other","from":"owner","action":"cancelSubscription","namedAction":{"id":"cancelSubscription","path":"/api/subscriptions/{subscriptionId}/cancel","method":"POST","reducer":"cancel_subscription","args":[0],"params":[{"name":"subscriptionId","in":"path","placeholder":"{subscriptionId}","wireType":"u64"}]},"input":{"testid":"subscription-cancel","attribute":"data-action-input"},"settleMs":0},
            {"do":"expectActionOutcome","actor":"other","outcome":"refused"},
            {"do":"expect","actor":"owner","testid":"subscription-status","in":{"testid":"subscription-row","contains":"Desk Lamp"},"value":"active","within":10000},
            {"do":"click","actor":"owner","testid":"subscription-cancel","in":{"testid":"subscription-row","contains":"Desk Lamp"}},
            {"do":"freshClient","actor":"owner"},
            {"do":"signIn","actor":"owner-fresh","name":"subscription-762"},
            {"do":"click","actor":"owner-fresh","testid":"subscriptions-link","unlessVisible":"subscriptions-panel"},
            {"do":"expect","actor":"owner-fresh","testid":"subscriptions-panel","attribute":"aria-busy","value":"false","within":10000},
            {"do":"expect","actor":"owner-fresh","testid":"subscription-status","in":{"testid":"subscription-row","contains":"Desk Lamp"},"value":"cancelled","within":10000},
            {"do":"recordNumber","actor":"owner-fresh","testid":"subscription-delivery","in":{"testid":"subscription-row","contains":"Desk Lamp"},"count":true,"as":"deliveries-at-cancel"},
            {"do":"dbRecordStock","item":"Desk Lamp","as":"stock-at-cancel"},
            {"do":"wait","actor":"owner-fresh","ms":65000},
            {"do":"expectElementCount","actor":"owner-fresh","testid":"subscription-delivery","in":{"testid":"subscription-row","contains":"Desk Lamp"},"relativeTo":"deliveries-at-cancel","plus":0},
            {"do":"dbExpectStock","item":"Desk Lamp","relativeTo":"stock-at-cancel","plus":0}
          ]
        }
