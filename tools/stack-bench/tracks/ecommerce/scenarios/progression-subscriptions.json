{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 5,
  "name": "Scheduled purchases",
  "features": [
    {
      "id": 760,
      "name": "A subscription creates exactly its requested deliveries and payments",
      "actors": [
        "owner",
        "other"
      ],
      "setup": [
        {"do":"signUp","actor":"owner","name":"subscription-760"},
        {"do":"dbSetStock","item":"Desk Lamp","warehouse":"East","quantity":10,"settleMs":0},
        {"do":"dbSetStock","item":"Desk Lamp","warehouse":"West","quantity":0,"settleMs":0},
        {"do":"click","actor":"owner","testid":"subscriptions-link","unlessVisible":"subscriptions-panel"},
        {"do":"expect","actor":"owner","testid":"subscriptions-panel","attribute":"aria-busy","value":"false","within":10000},
        {"do":"fill","actor":"owner","testid":"subscription-item-input","text":"Desk Lamp"},
        {"do":"fill","actor":"owner","testid":"subscription-quantity-input","text":"1"},
        {"do":"fill","actor":"owner","testid":"subscription-interval-input","text":"30"},
        {"do":"fill","actor":"owner","testid":"subscription-deliveries-input","text":"2"},
        {"do":"click","actor":"owner","testid":"subscription-create"},
        {"do":"expect","actor":"owner","testid":"subscription-status","in":{"testid":"subscription-row","contains":"Desk Lamp"},"value":"active","within":10000}
      ],
      "criteria": [
        {
          "id": "760a",
          "category": "feature",
          "desc": "A subscription creates exactly its requested deliveries and payments",
          "points": 2,
          "steps": [
            {"do":"freshClient","actor":"owner"},
            {"do":"signIn","actor":"owner-fresh","name":"subscription-760"},
            {"do":"click","actor":"owner-fresh","testid":"subscriptions-link","unlessVisible":"subscriptions-panel"},
            {"do":"expect","actor":"owner-fresh","testid":"subscriptions-panel","attribute":"aria-busy","value":"false","within":10000},
            {"do":"expect","actor":"owner-fresh","testid":"subscription-status","in":{"testid":"subscription-row","contains":"Desk Lamp"},"value":"complete","within":90000},
            {"do":"expectElementCount","actor":"owner-fresh","testid":"subscription-delivery","in":{"testid":"subscription-row","contains":"Desk Lamp"},"equals":2},
            {"do":"expectSequence","actor":"owner-fresh","testid":"subscription-delivery-status","in":{"testid":"subscription-row","contains":"Desk Lamp"},"equals":["paid","paid"]},
            {"do":"expectNumber","actor":"owner-fresh","testid":"subscription-total","in":{"testid":"subscription-row","contains":"Desk Lamp"},"equals":84},
            {"do":"dbExpectStock","item":"Desk Lamp","equals":8},
            {"do":"click","actor":"owner-fresh","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
            {"do":"click","actor":"owner-fresh","testid":"orders-toggle"},
            {"do":"expectElementCount","actor":"owner-fresh","testid":"order-item","contains":"Desk Lamp","equals":2,"within":10000},
            {"do":"expectElementCount","actor":"owner-fresh","testid":"payment-record","equals":2}
          ]
        }
      ]
    },
