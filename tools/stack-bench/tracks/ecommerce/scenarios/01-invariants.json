{
  "level": 1,
  "track": "ecommerce",
  "name": "Storefront and warehouse — invariants",
  "writeUrlPattern": "\\/api\\/|\\/items|\\/cart|\\/orders|\\/checkout|\\/buy|\\/reviews|\\/stock|\\/restock|\\/warehouses",
  "note": "Cross-cutting properties, scored separately from features because an app can implement every feature and still let anyone spend anyone else's money. Each is stated as an outcome a customer would recognise, not as a protocol detail — a backend must not lose points for being harder to inspect, nor gain them for it.",
  "features": [
    {
      "id": 101,
      "name": "Purchase requires an account",
      "actors": ["buyer", "guest"],
      "setup": [
        { "do": "signUp", "actor": "buyer", "name": "kim" }
      ],
      "criteria": [
        {
          "id": "101a",
          "desc": "a purchase request replayed without a session creates no order and moves no stock",
          "points": 2,
          "steps": [
            { "do": "expectNumber", "actor": "buyer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Bellows" }, "equals": 100 },
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Bellows" } },
            { "do": "wait", "actor": "buyer", "ms": 1500 },
            { "do": "replayAs", "actor": "guest", "from": "buyer", "match": "buy", "settleMs": 2500 },
            { "do": "expectReplayRejected", "actor": "guest" },
            { "do": "expectNumber", "actor": "buyer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Bellows" }, "equals": 99 }
          ]
        }
      ]
    },

    {
      "id": 102,
      "name": "Purchases are attributed to whoever made them",
      "actors": ["victim", "attacker"],
      "setup": [
        { "do": "signUp", "actor": "victim", "name": "lee" },
        { "do": "signUp", "actor": "attacker", "name": "mel" }
      ],
      "criteria": [
        {
          "id": "102a",
          "desc": "an order cannot be placed in someone else's name by editing the request",
          "points": 2,
          "steps": [
            { "do": "click", "actor": "attacker", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Drill Press" } },
            { "do": "wait", "actor": "attacker", "ms": 1500 },
            { "do": "forgeWrite", "actor": "attacker", "fromActor": "victim", "settleMs": 2500 },
            { "do": "expectForgeryRejected", "actor": "attacker" },
            { "do": "click", "actor": "victim", "testid": "orders-toggle" },
            { "do": "expect", "actor": "victim", "testid": "order-item", "contains": "Drill Press", "absent": true }
          ]
        }
      ]
    },

    {
      "id": 103,
      "name": "Stock is administered by admins only",
      "actors": ["admin", "customer"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signUp", "actor": "customer", "name": "ned" }
      ],
      "criteria": [
        {
          "id": "103a",
          "desc": "a restock replayed by a customer is refused and changes no stock",
          "points": 2,
          "steps": [
            { "do": "click", "actor": "admin", "testid": "admin-link" },
            { "do": "fill", "actor": "admin", "testid": "restock-input", "text": "10" },
            { "do": "click", "actor": "admin", "testid": "restock-submit" },
            { "do": "wait", "actor": "admin", "ms": 2000 },
            { "do": "expectNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Anvil" }, "atLeast": 100 },
            { "do": "replayAs", "actor": "customer", "from": "admin", "match": "restock", "settleMs": 2500 },
            { "do": "expectReplayRejected", "actor": "customer" },
            { "do": "expectNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Anvil" }, "atMost": 110 }
          ]
        }
      ]
    },

    {
      "id": 104,
      "name": "The price is the store's to set",
      "actors": ["buyer"],
      "setup": [
        { "do": "signUp", "actor": "buyer", "name": "oli" }
      ],
      "criteria": [
        {
          "id": "104a",
          "desc": "a purchase request with the price edited does not sell the item for less",
          "points": 2,
          "steps": [
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Drill Press" } },
            { "do": "wait", "actor": "buyer", "ms": 1500 },
            { "do": "replayAs", "actor": "buyer", "from": "buyer", "match": "buy",
              "swap": { "find": "349", "with": "1" }, "settleMs": 2500 },
            { "do": "click", "actor": "buyer", "testid": "orders-toggle" },
            { "do": "expectNumber", "actor": "buyer", "testid": "order-total", "in": { "testid": "order-item", "contains": "Drill Press" }, "atLeast": 349 }
          ]
        }
      ]
    },

    {
      "id": 105,
      "name": "An account keeps what belongs to it",
      "actors": ["shopper"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "pat" }
      ],
      "criteria": [
        {
          "id": "105a",
          "desc": "cart and order history survive a reload as the same account",
          "points": 1,
          "steps": [
            { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Jeweller's Loupe" } },
            { "do": "click", "actor": "shopper", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Hammer" } },
            { "do": "reload", "actor": "shopper", "settleMs": 4000 },
            { "do": "expect", "actor": "shopper", "testid": "current-user", "contains": "pat" },
            { "do": "click", "actor": "shopper", "testid": "cart-toggle" },
            { "do": "expect", "actor": "shopper", "testid": "cart-item", "contains": "Jeweller's Loupe" },
            { "do": "click", "actor": "shopper", "testid": "orders-toggle" },
            { "do": "expect", "actor": "shopper", "testid": "order-item", "contains": "Hammer" }
          ]
        },
        {
          "id": "105b",
          "desc": "the same account survives the connection dropping and coming back",
          "points": 1,
          "steps": [
            { "do": "setOffline", "actor": "shopper", "settleMs": 3000 },
            { "do": "setOffline", "actor": "shopper", "offline": false, "settleMs": 6000 },
            { "do": "expect", "actor": "shopper", "testid": "current-user", "contains": "pat" },
            { "do": "click", "actor": "shopper", "testid": "cart-toggle" },
            { "do": "expect", "actor": "shopper", "testid": "cart-item", "contains": "Jeweller's Loupe" }
          ]
        }
      ]
    },

    {
      "id": 106,
      "name": "One customer's orders are not another's",
      "actors": ["one", "two"],
      "setup": [
        { "do": "signUp", "actor": "one", "name": "quin" },
        { "do": "signUp", "actor": "two", "name": "ros" }
      ],
      "criteria": [
        {
          "id": "106a",
          "desc": "a customer's order history contains only their own orders",
          "points": 1,
          "steps": [
            { "do": "click", "actor": "one", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Chisel Set" } },
            { "do": "wait", "actor": "one", "ms": 2000 },
            { "do": "click", "actor": "two", "testid": "orders-toggle" },
            { "do": "expect", "actor": "two", "testid": "order-item", "contains": "Chisel Set", "absent": true }
          ]
        }
      ]
    },

    {
      "id": 107,
      "name": "The books balance",
      "actors": ["buyer", "admin"],
      "setup": [
        { "do": "signUp", "actor": "buyer", "name": "sam" },
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true }
      ],
      "criteria": [
        {
          "id": "107a",
          "desc": "revenue equals what was actually bought",
          "points": 1,
          "steps": [
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Kiln Brick" } },
            { "do": "wait", "actor": "buyer", "ms": 1000 },
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Kiln Brick" } },
            { "do": "wait", "actor": "buyer", "ms": 2000 },
            { "do": "click", "actor": "admin", "testid": "admin-link" },
            { "do": "expectNumber", "actor": "admin", "testid": "admin-revenue", "equals": 16, "within": 10000 }
          ]
        },
        {
          "id": "107b",
          "desc": "what the store sold is what left the warehouses",
          "points": 1,
          "steps": [
            { "do": "expectNumber", "actor": "admin", "testid": "admin-stock", "in": { "testid": "admin-item-row", "contains": "Kiln Brick" }, "equals": 98 },
            { "do": "freshClient", "actor": "buyer" },
            { "do": "expectNumber", "actor": "buyer-fresh", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Kiln Brick" }, "equals": 98 }
          ]
        }
      ]
    }
  ]
}
