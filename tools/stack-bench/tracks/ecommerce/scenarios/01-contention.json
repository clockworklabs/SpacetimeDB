              "actor": "a",
              "testid": "item-stock",
              "in": {
                "testid": "item-card",
                "contains": "Bluetooth Speaker"
              },
              "relativeTo": "storefront-before",
              "plus": 5,
              "within": 8000
            }
          ]
        },
        {
          "id": "202a",
          "points": 0,
          "withheld": "A candidate cross-feature mutation now omits purchase inventory reservation and directly makes this read start + 5 instead of start + 2. Keep at zero until that exact target passes the repeated live Docker mutation gate.",
          "desc": "three purchases and a restock of five during the rush leave stock at start + 2",
