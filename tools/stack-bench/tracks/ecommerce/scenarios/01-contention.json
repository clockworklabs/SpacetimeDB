      "criteria": [
        {
          "id": "202-control",
          "points": 0,
          "withheld": "diagnostic: establishes that a restock is applied and reaches the storefront",
          "desc": "an uncontended restock of five is stored by the server and shows on the storefront",
          "steps": [
            {
              "do": "click",
              "actor": "admin",
              "testid": "admin-link"
