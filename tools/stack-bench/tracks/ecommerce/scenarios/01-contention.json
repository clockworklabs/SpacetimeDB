              "do": "wait",
              "actor": "admin",
              "ms": 4000
            },
            {
              "do": "expectNumber",
              "actor": "admin",
              "testid": "admin-location-qty",
              "in": {
                "testid": "admin-location-row",
                "contains": "Bluetooth Speaker"
              },
              "relativeTo": "warehouse-before",
