            {
              "do": "recordNumber",
              "actor": "a",
              "testid": "item-stock",
              "in": {
                "testid": "item-card",
                "contains": "Bluetooth Speaker"
              },
              "as": "storefront-before"
            },
            {
              "do": "fill",
              "actor": "admin",
              "testid": "restock-input",
              "in": {
                "testid": "admin-location-row",
                "contains": "Bluetooth Speaker"
