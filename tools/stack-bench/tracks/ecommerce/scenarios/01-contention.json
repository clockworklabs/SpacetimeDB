              "in": {
                "testid": "admin-location-row",
                "contains": "Bluetooth Speaker"
              },
              "text": "5"
            },
            {
              "do": "click",
              "actor": "admin",
              "testid": "restock-submit",
              "in": {
                "testid": "admin-location-row",
                "contains": "Bluetooth Speaker"
              }
            },
            {
              "do": "wait",
              "actor": "admin",
              "ms": 6000
