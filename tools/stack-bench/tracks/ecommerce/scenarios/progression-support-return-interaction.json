          "testid": "admin-link"
        }
      ],
      "criteria": [
        {
          "id": "757a",
          "category": "production",
          "desc": "a support refund followed by physical return restores each warehouse once and refunds only the price paid",
          "points": 2,
          "steps": [
            {
              "do": "reload",
              "actor": "owner",
              "settleMs": 0
            },
            {
              "do": "ensureSignedIn",
              "actor": "owner",
              "name": "return-refund-owner",
              "readyTestid": "current-user",
              "settleMs": 0
            },
            {
              "do": "click",
              "actor": "owner",
              "testid": "catalog-link",
              "ifAvailable": true
            },
            {
              "do": "dbRecordStock",
              "item": "Keyboard",
              "as": "757atotal"
            },
            {
              "do": "dbRecordStock",
              "item": "Keyboard",
              "warehouse": "East",
              "as": "757aEast"
            },
            {
              "do": "dbRecordStock",
              "item": "Keyboard",
              "warehouse": "West",
              "as": "757aWest"
            },
            {
              "do": "recordNumber",
              "actor": "admin",
              "testid": "admin-revenue",
              "as": "757arevenue"
            },
            {
              "do": "click",
              "actor": "owner",
              "testid": "buy-now",
              "in": {
                "testid": "item-card",
                "contains": "Keyboard"
              }
            },
            {
              "do": "click",
              "actor": "owner",
              "testid": "orders-toggle",
              "unlessVisible": "order-item"
            },
            {
              "do": "expect",
              "actor": "owner",
              "testid": "order-status",
              "within": 10000,
              "in": {
                "testid": "order-item",
                "contains": "Keyboard"
              },
              "value": "pending",
              "ignoreCase": true
            },
            {
              "do": "recordNumber",
              "actor": "owner",
              "testid": "order-total",
              "in": {
                "testid": "order-item",
                "contains": "Keyboard"
              },
              "as": "757apaid"
            },
            {
              "do": "callAction",
              "actor": "staff",
              "action": "ship",
              "namedAction": {
                "id": "ship",
                "path": "/api/fulfilment/ship",
                "reducer": "ship_order",
                "args": [
                  0
                ],
                "params": [
                  {
                    "name": "orderId",
                    "in": "body",
                    "wireType": "u64"
                  }
                ]
              },
              "input": {
                "testid": "order-item",
                "contains": "Keyboard",
                "attribute": "data-ship-input"
              },
              "from": "owner",
              "settleMs": 0
            },
            {
              "do": "expectActionOutcome",
              "actor": "staff",
              "outcome": "accepted"
            },
            {
              "do": "expect",
              "actor": "owner",
              "testid": "order-status",
              "within": 10000,
              "in": {
                "testid": "order-item",
                "contains": "Keyboard"
              },
              "value": "shipped",
              "ignoreCase": true
            },
            {
              "do": "dbExpectStock",
              "item": "Keyboard",
              "relativeTo": "757atotal",
              "plus": -1
            },
            {
              "do": "reload",
              "actor": "owner",
              "settleMs": 0
            },
            {
              "do": "ensureSignedIn",
              "actor": "owner",
              "name": "return-refund-owner",
              "readyTestid": "current-user",
              "settleMs": 0
            },
