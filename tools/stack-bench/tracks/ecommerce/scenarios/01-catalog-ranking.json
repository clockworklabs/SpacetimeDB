                "Bluetooth Speaker",
                "Coffee Grinder",
                "Desk Lamp",
                "Espresso Machine",
                "Gaming Mouse",
                "Headphones",
                "Induction Cooktop",
                "Keyboard",
                "Laptop Stand"
              ]
            }
          ]
        }
      ]
    }
  ]
