{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 2,
  "name": "Order cancellation",
  "features": [
    {
      "id": 3,
      "name": "Cancel a pending order",
      "actors": ["customer", "admin"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "cancel-core" },
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "click", "actor": "admin", "testid": "admin-link" }
      ],
      "criteria": [
        {
          "id": "3a",
          "desc": "cancelling a pending order restores its stock and revenue",
          "points": 2,
          "statedBy": "the stock goes back to the warehouse it came from and revenue falls",
          "steps": [
            { "do": "recordNumber", "actor": "admin", "testid": "admin-revenue", "as": "revenue-before" },
            { "do": "recordNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Coffee Grinder" }, "as": "stock-before" },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Coffee Grinder" } },
            { "do": "click", "actor": "customer", "testid": "orders-toggle", "settleMs": 2000 },
            { "do": "click", "actor": "customer", "testid": "cancel-order", "in": { "testid": "order-item", "contains": "Coffee Grinder" } },
            { "do": "expectNumber", "actor": "admin", "testid": "admin-revenue", "relativeTo": "revenue-before", "plus": 0, "within": 10000 },
            { "do": "click", "actor": "customer", "testid": "catalog-link" },
            { "do": "expectNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Coffee Grinder" }, "relativeTo": "stock-before", "plus": 0, "within": 10000 }
          ]
        }
      ]
    }
  ]
}
