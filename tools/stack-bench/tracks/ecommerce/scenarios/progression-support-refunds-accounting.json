{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 5,
  "name": "Support refund accounting",
  "features": [
    {
      "id": 615,
      "name": "Support refund accounting",
      "actors": ["owner", "staff"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "refund-accounting-owner" },
        { "do": "click", "actor": "owner", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Mouse" } },
        { "do": "click", "actor": "owner", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } },
        { "do": "click", "actor": "owner", "testid": "orders-toggle", "unlessVisible": "order-item" },
        { "do": "recordNumber", "actor": "owner", "testid": "order-total", "in": { "testid": "order-item", "contains": "Keyboard" }, "as": "paid-total" },
        { "do": "click", "actor": "owner", "testid": "support-link" },
        { "do": "fill", "actor": "owner", "testid": "support-subject", "text": "Accounting refund case" },
        { "do": "fill", "actor": "owner", "testid": "support-message", "text": "Refund the exact amount paid." },
        { "do": "click", "actor": "owner", "testid": "support-submit" },
        { "do": "click", "actor": "owner", "testid": "support-order-option", "contains": "Keyboard", "in": { "testid": "support-ticket", "contains": "Accounting refund case" } },
        { "do": "click", "actor": "owner", "testid": "support-link-order", "in": { "testid": "support-ticket", "contains": "Accounting refund case" } },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        {"do":"click","actor":"staff","testid":"staff-link","unlessVisible":"support-assignee"},
        {"do":"click","actor":"staff","testid":"support-queue-link","unlessVisible":"support-assignee","ifAvailable":true}
      ],
      "criteria": [
        {
          "id": "615b",
          "category": "production",
          "desc": "the refund equals the paid total, cannot be applied twice, and leaves another order unrefunded",
          "points": 1,
          "statedBy": "The recorded refund equals the amount paid and is applied only once.",
          "steps": [
            { "do": "click", "actor": "staff", "testid": "support-refund", "in": { "testid": "support-ticket", "contains": "Accounting refund case" } },
            { "do": "expectNumber", "actor": "owner", "testid": "support-refund-total", "in": { "testid": "support-ticket", "contains": "Accounting refund case" }, "relativeTo": "paid-total", "plus": 0, "within": 10000 },
            { "do": "click", "actor": "owner", "testid": "orders-toggle", "unlessVisible": "order-item" },
            { "do": "expectNumber", "actor": "owner", "testid": "order-refund-total", "in": { "testid": "order-item", "contains": "Keyboard" }, "relativeTo": "paid-total", "plus": 0, "within": 10000 },
            { "do": "expectElementCount", "actor": "owner", "testid": "refund-entry", "contains": "Keyboard", "equals": 1, "within": 10000 },
            { "do": "replayAs", "actor": "staff", "from": "staff", "match": "refund", "namedAction": { "id": "supportRefund", "path": "/api/support/cases/{caseId}/refund", "method": "POST", "reducer": "support_refund", "args": [0], "params": [{ "name": "caseId", "in": "path", "placeholder": "{caseId}", "wireType": "u64" }] }, "namedTarget": { "testid": "support-ticket", "contains": "Accounting refund case", "attribute": "data-entity-id", "valueType": "string" }, "settleMs": 1500 },
            { "do": "expectReplayCompleted", "actor": "staff" },
            { "do": "freshClient", "actor": "owner" },
            { "do": "signIn", "actor": "owner-fresh", "name": "refund-accounting-owner" },
            { "do": "click", "actor": "owner-fresh", "testid": "support-link" },
            { "do": "expectNumber", "actor": "owner-fresh", "testid": "support-refund-total", "in": { "testid": "support-ticket", "contains": "Accounting refund case" }, "relativeTo": "paid-total", "plus": 0, "within": 10000 },
            { "do": "click", "actor": "owner-fresh", "testid": "orders-toggle", "unlessVisible": "order-item" },
            { "do": "expectNumber", "actor": "owner-fresh", "testid": "order-refund-total", "in": { "testid": "order-item", "contains": "Keyboard" }, "relativeTo": "paid-total", "plus": 0, "within": 10000 },
            { "do": "expectElementCount", "actor": "owner-fresh", "testid": "refund-entry", "contains": "Keyboard", "equals": 1, "within": 10000 },
            { "do": "expectNumber", "actor": "owner-fresh", "testid": "order-refund-total", "in": { "testid": "order-item", "contains": "Mouse" }, "equals": 0, "within": 10000 },
            { "do": "expectElementCount", "actor": "owner-fresh", "testid": "refund-entry", "contains": "Mouse", "equals": 0, "within": 10000 }
          ]
        }
      ]
    }
  ]
}
