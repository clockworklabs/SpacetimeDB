{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 5,
  "name": "Staff activity history",
  "features": [
    {
      "id": 624,
      "name": "Attributable staff activity",
      "actors": ["admin", "staff", "customer"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "signIn", "actor": "customer", "name": "customer", "password": "stackbench-customer-2026", "exact": true },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "fill", "actor": "admin", "testid": "catalog-name", "text": "Activity Mug" },
        { "do": "fill", "actor": "admin", "testid": "catalog-category", "text": "Kitchen" },
        { "do": "fill", "actor": "admin", "testid": "catalog-price", "text": "43.00" },
        { "do": "fill", "actor": "admin", "testid": "catalog-variants", "text": "Green" },
        { "do": "click", "actor": "admin", "testid": "catalog-save" }
      ],
      "criteria": [
        {
          "id": "624a",
          "desc": "an administrative change records its actor, action, subject, and time",
          "points": 3,
          "statedBy": "Each administrative change identifies its actor, action, subject, and time.",
          "steps": [
            { "do": "click", "actor": "staff", "testid": "staff-link" },
            { "do": "click", "actor": "staff", "testid": "activity-link" },
            { "do": "expect", "actor": "staff", "testid": "activity-entry", "contains": "Activity Mug", "within": 10000 },
            { "do": "expect", "actor": "staff", "testid": "activity-actor", "in": { "testid": "activity-entry", "contains": "Activity Mug" }, "contains": "admin" },
            { "do": "expect", "actor": "staff", "testid": "activity-action", "in": { "testid": "activity-entry", "contains": "Activity Mug" }, "contains": "creat" },
            { "do": "expect", "actor": "staff", "testid": "activity-subject", "in": { "testid": "activity-entry", "contains": "Activity Mug" }, "contains": "Activity Mug" },
            { "do": "expect", "actor": "staff", "testid": "activity-time", "in": { "testid": "activity-entry", "contains": "Activity Mug" } }
          ]
        },
        {
          "id": "624b",
          "desc": "customers cannot open staff activity history",
          "points": 2,
          "statedBy": "Customers cannot open staff activity history.",
          "steps": [
            { "do": "expect", "actor": "customer", "testid": "activity-link", "absent": true }
          ]
        }
      ]
    }
  ]
}
