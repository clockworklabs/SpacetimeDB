{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Ecommerce L2 recommendations",
  "note": "This scenario owns only the signed-in recommendation check.",
  "features": [
    {
      "id": 5,
      "name": "Customer recommendations",
      "actors": ["customer"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "recommendations" }
      ],
      "criteria": [
        {
          "id": "5c",
          "desc": "a purchase recommends another item from that category and excludes an item in the cart",
          "points": 2,
          "statedBy": "Recommend items from categories the customer bought from and exclude items already in the cart",
          "steps": [
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Bluetooth Speaker" } },
            { "do": "pressKey", "actor": "customer", "key": "Escape" },
            { "do": "expect", "actor": "customer", "testid": "recommended-item", "contains": "Headphones", "within": 10000 },
            { "do": "click", "actor": "customer", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Headphones" } },
            { "do": "pressKey", "actor": "customer", "key": "Escape" },
            { "do": "expect", "actor": "customer", "testid": "recommended-item", "contains": "Headphones", "absent": true, "within": 10000 }
          ]
        }
      ]
    }
  ]
}
