{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 1,
  "name": "Only an administrator can restock through staff access",
  "features": [
    {
      "id": 103,
      "name": "Only an administrator can restock",
      "actors": ["admin", "staff"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true }
      ],
      "criteria": [
        {
          "id": "103a",
          "desc": "a valid direct restock works for an administrator but is refused for staff",
          "points": 2,
          "statedBy": "the server refuses warehouse writes from a non-admin account",
          "steps": [
            { "do": "click", "actor": "admin", "testid": "admin-link" },
            { "do": "recordNumber", "actor": "staff", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "as": "purifier-before-control" },
            {
              "do": "callAction",
              "actor": "admin",
              "action": "restock",
              "namedAction": {
                "id": "restock",
                "path": "/api/admin/restock",
                "reducer": "admin_restock",
                "args": [0, 0, 1],
                "params": [
                  { "name": "itemId", "in": "body", "wireType": "u64" },
                  { "name": "warehouseId", "in": "body", "wireType": "u64" },
                  { "name": "quantity", "in": "body" }
                ]
              },
              "input": { "testid": "admin-location-row", "contains": "Air Purifier", "attribute": "data-restock-input" },
              "settleMs": 2000
            },
            { "do": "expectActionOutcome", "actor": "admin", "outcome": "accepted" },
            { "do": "reload", "actor": "staff", "settleMs": 2000 },
            { "do": "expectNumber", "actor": "staff", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "purifier-before-control", "plus": 1 },
            { "do": "recordNumber", "actor": "staff", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "as": "purifier-after-control" },
            {
              "do": "callAction",
              "actor": "staff",
              "from": "admin",
              "action": "restock",
              "namedAction": {
                "id": "restock",
                "path": "/api/admin/restock",
                "reducer": "admin_restock",
                "args": [0, 0, 1],
                "params": [
                  { "name": "itemId", "in": "body", "wireType": "u64" },
                  { "name": "warehouseId", "in": "body", "wireType": "u64" },
                  { "name": "quantity", "in": "body" }
                ]
              },
              "input": { "testid": "admin-location-row", "contains": "Air Purifier", "attribute": "data-restock-input" },
              "settleMs": 2000
            },
            { "do": "expectActionOutcome", "actor": "staff", "outcome": "refused" },
            { "do": "reload", "actor": "staff", "settleMs": 2000 },
            { "do": "expectNumber", "actor": "staff", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "purifier-after-control", "plus": 0 }
          ]
        }
      ]
    }
  ]
}
