{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Native order crash verdict qualification",
  "note": "Draft zero-point controls. One fixed 16-call, zero-offset trial per applicable process boundary. PostgreSQL and MongoDB use both boundaries; SpacetimeDB uses its combined database boundary once. Each trial shares one retained crash observation across atomicity and durability assertions. The reader observes cart and order data, not unrequested warehouse or payment features. Valid reconstruction from durable data is allowed. Fault-window misses and incomplete observation remain inconclusive. Fresh-customer recovery is a separate zero-point prerequisite control, not a third proposed scored invariant. This single-item trial is not general multi-line, power-loss, or network-fault coverage.",
  "features": [
    {
      "id": 9900,
      "name": "Native order checkout: application crash",
      "actors": [
        "a",
        "b"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "a",
          "name": "crash"
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:crash}",
          "item": "Keyboard",
          "as": "baseline-before",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "click",
          "actor": "a",
          "testid": "add-to-cart",
          "in": {
            "testid": "item-card",
            "contains": "Keyboard"
          }
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:crash}",
          "item": "Keyboard",
          "as": "baseline-prepared",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "confirmCheckout",
          "actor": "a",
          "namedAction": {
            "id": "checkout",
            "path": "/api/checkout",
            "reducer": "checkout",
            "args": []
          }
        },
        {
          "do": "dbExpectCheckout",
          "before": "baseline-before",
          "prepared": "baseline-prepared",
          "quantity": 1
        },
        {
          "do": "reload",
          "actor": "a",
          "settleMs": 0
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:crash}",
          "item": "Keyboard",
          "as": "before",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "click",
          "actor": "a",
          "testid": "add-to-cart",
          "in": {
            "testid": "item-card",
            "contains": "Keyboard"
          }
        },
        {
          "do": "dbRecordCheckout",
          "account": "{user:crash}",
          "item": "Keyboard",
          "as": "prepared",
          "storage": {
            "kind": "order-data",
            "cart": true,
            "warehouses": false
          }
        },
        {
          "do": "crashCheckout",
          "namedAction": {
            "id": "checkout",
            "path": "/api/checkout",
            "reducer": "checkout",
            "args": []
          },
          "actor": "a",
          "before": "before",
          "prepared": "prepared",
          "quantity": 1,
          "requests": 16,
          "offsetMs": 0,
          "target": "application",
          "as": "crash-observation"
        }
      ],
      "criteria": [
        {
          "id": "9900a",
          "category": "production",
          "points": 0,
          "desc": "interrupted checkout leaves either the prepared cart or one complete order with the cart cleared",
          "steps": [
            {
              "do": "expectCrashCheckout",
              "from": "crash-observation",
              "verdict": "atomicity"
            }
          ]
        },
        {
          "id": "9900b",
          "category": "production",
          "points": 0,
          "desc": "acknowledged checkout is not rolled back and previously recorded orders remain unchanged",
          "steps": [
            {
              "do": "expectCrashCheckout",
              "from": "crash-observation",
              "verdict": "durability"
            }
          ]
        },
        {
          "id": "9900c",
          "category": "production",
          "points": 0,
          "desc": "a fresh customer can complete checkout after recovery",
          "steps": [
            {
              "do": "signUp",
              "actor": "b",
              "name": "recovered"
            },
            {
              "do": "dbRecordCheckout",
              "account": "{user:recovered}",
              "item": "Keyboard",
              "as": "recovered-before",
              "storage": {
                "kind": "order-data",
                "cart": true,
                "warehouses": false
              }
            },
            {
              "do": "click",
              "actor": "b",
              "testid": "add-to-cart",
              "in": {
                "testid": "item-card",
                "contains": "Keyboard"
              }
            },
            {
              "do": "dbRecordCheckout",
              "account": "{user:recovered}",
              "item": "Keyboard",
              "as": "recovered-prepared",
              "storage": {
                "kind": "order-data",
                "cart": true,
                "warehouses": false
              }
            },
            {
              "do": "click",
              "actor": "b",
              "testid": "cart-toggle"
            },
            {
              "do": "click",
              "actor": "b",
              "testid": "checkout-submit"
            },
            {
              "do": "expectNumber",
              "actor": "b",
              "testid": "cart-count",
              "equals": 0,
              "within": 10000
            },
            {
              "do": "click",
              "actor": "b",
              "testid": "overlay-close",
              "ifAvailable": true
            },
            {
              "do": "dbExpectCheckout",
              "before": "recovered-before",
              "prepared": "recovered-prepared",
              "quantity": 1
            }
          ]
        }
      ]
    },
