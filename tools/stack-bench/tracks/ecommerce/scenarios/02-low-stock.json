{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Ecommerce L2 low-stock boundary",
  "note": "Draft: repaired probe behavior needs matching qualification evidence. This scenario owns only the low-stock boundary check so a failure cannot prevent unrelated operational-view checks from running.",
  "features": [
    {
      "id": 5,
      "name": "The low-stock view",
      "actors": ["admin", "customer", "restocker"],
      "setup": [
        { "do": "dbSetStock", "item": "Air Purifier", "warehouse": "East", "quantity": 2, "settleMs": 250 },
        { "do": "dbSetStock", "item": "Air Purifier", "warehouse": "West", "quantity": 1, "settleMs": 250 },
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signUp", "actor": "customer", "name": "low-stock-focused" },
        { "do": "reload", "actor": "admin", "settleMs": 1000 },
        { "do": "ensureSignedIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user" },
        { "do": "reload", "actor": "customer", "settleMs": 1000 },
        { "do": "ensureSignedIn", "actor": "customer", "name": "low-stock-focused", "readyTestid": "current-user" },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "click", "actor": "admin", "testid": "low-stock-link", "ifAvailable": true, "unlessVisible": "low-stock-item", "within": 10000 }
      ],
      "criteria": [
        {
          "id": "5e",
          "category": "feature",
          "desc": "the dashboard lists a current low-stock item",
          "points": 1,
          "statedBy": "It lists items with 10 units or fewer, most urgent first.",
          "steps": [
            { "do": "expect", "actor": "admin", "testid": "low-stock-item", "contains": "Air Purifier", "within": 8000 }
          ]
        },
        {
          "id": "5a",
          "category": "production",
          "desc": "an item falling to ten units or fewer joins the low-stock list, live",
          "points": 3,
          "statedBy": "items enter and leave this list as stock moves, sells, is restocked, cancelled or returned",
          "steps": [
            { "do": "expect", "actor": "admin", "testid": "low-stock-item", "contains": "Air Purifier", "within": 8000 },
            { "do": "signIn", "actor": "restocker", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
            { "do": "click", "actor": "restocker", "testid": "admin-link" },
            { "do": "fill", "actor": "restocker", "testid": "restock-input", "text": "8", "in": { "testid": "admin-location-row", "contains": "Air Purifier" } },
            { "do": "click", "actor": "restocker", "testid": "restock-submit", "in": { "testid": "admin-location-row", "contains": "Air Purifier" } },
            { "do": "waitUntilAbsent", "actor": "admin", "testid": "low-stock-item", "contains": "Air Purifier", "within": 10000 },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Air Purifier" } },
            { "do": "expect", "actor": "admin", "testid": "low-stock-item", "contains": "Air Purifier", "within": 10000 }
          ]
        }
      ]
    }
  ]
}
