{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 5,
  "name": "Promotion checkout",
  "features": [
    {
      "id": 621,
      "name": "Bounded promotions at checkout",
      "actors": ["staff", "activeBuyer", "expiredBuyer", "firstBuyer", "secondBuyer"],
      "setup": [
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "click", "actor": "staff", "testid": "promotions-link" },
        { "do": "fill", "actor": "staff", "testid": "promotion-code", "text": "LIVE10" },
        { "do": "fill", "actor": "staff", "testid": "promotion-discount", "text": "10" },
        { "do": "fill", "actor": "staff", "testid": "promotion-start", "text": "2020-01-01" },
        { "do": "fill", "actor": "staff", "testid": "promotion-end", "text": "2099-12-31" },
        { "do": "fill", "actor": "staff", "testid": "promotion-limit", "text": "10" },
        { "do": "click", "actor": "staff", "testid": "promotion-submit" },
        { "do": "fill", "actor": "staff", "testid": "promotion-code", "text": "OLD10" },
        { "do": "fill", "actor": "staff", "testid": "promotion-discount", "text": "10" },
        { "do": "fill", "actor": "staff", "testid": "promotion-start", "text": "2000-01-01" },
        { "do": "fill", "actor": "staff", "testid": "promotion-end", "text": "2000-12-31" },
        { "do": "fill", "actor": "staff", "testid": "promotion-limit", "text": "10" },
        { "do": "click", "actor": "staff", "testid": "promotion-submit" },
        { "do": "fill", "actor": "staff", "testid": "promotion-code", "text": "ONCE10" },
        { "do": "fill", "actor": "staff", "testid": "promotion-discount", "text": "10" },
        { "do": "fill", "actor": "staff", "testid": "promotion-start", "text": "2020-01-01" },
        { "do": "fill", "actor": "staff", "testid": "promotion-end", "text": "2099-12-31" },
        { "do": "fill", "actor": "staff", "testid": "promotion-limit", "text": "1" },
        { "do": "click", "actor": "staff", "testid": "promotion-submit" },
        { "do": "signUp", "actor": "activeBuyer", "name": "promotion-active" },
        { "do": "signUp", "actor": "expiredBuyer", "name": "promotion-expired" },
        { "do": "signUp", "actor": "firstBuyer", "name": "promotion-first" },
        { "do": "signUp", "actor": "secondBuyer", "name": "promotion-second" }
      ],
      "criteria": [
        {
          "id": "621a",
          "desc": "an active promotion changes checkout and is recorded on the order",
          "points": 3,
          "statedBy": "An active promotion applies to the cart and the order records its discount.",
          "steps": [
            { "do": "fill", "actor": "activeBuyer", "testid": "search-input", "text": "Keyboard", "enter": true },
            { "do": "click", "actor": "activeBuyer", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Keyboard" } },
            { "do": "click", "actor": "activeBuyer", "testid": "cart-toggle" },
            { "do": "fill", "actor": "activeBuyer", "testid": "cart-promotion", "text": "LIVE10" },
            { "do": "click", "actor": "activeBuyer", "testid": "apply-promotion" },
            { "do": "click", "actor": "activeBuyer", "testid": "checkout-submit" },
            { "do": "click", "actor": "activeBuyer", "testid": "orders-toggle" },
            { "do": "expectNumber", "actor": "activeBuyer", "testid": "order-discount", "in": { "testid": "order-item", "contains": "Keyboard" }, "equals": 8.9 }
          ]
        },
        {
          "id": "621b",
          "desc": "an expired promotion is refused",
          "points": 2,
          "statedBy": "Expired promotions cannot be applied.",
          "steps": [
            { "do": "fill", "actor": "expiredBuyer", "testid": "search-input", "text": "Keyboard", "enter": true },
            { "do": "click", "actor": "expiredBuyer", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Keyboard" } },
            { "do": "click", "actor": "expiredBuyer", "testid": "cart-toggle" },
            { "do": "fill", "actor": "expiredBuyer", "testid": "cart-promotion", "text": "OLD10" },
            { "do": "click", "actor": "expiredBuyer", "testid": "apply-promotion" },
            { "do": "expect", "actor": "expiredBuyer", "testid": "promotion-error" }
          ]
        },
        {
          "id": "621c",
          "desc": "a fully redeemed promotion is refused",
          "points": 2,
          "statedBy": "A promotion cannot be used after its redemption limit is reached.",
          "steps": [
            { "do": "fill", "actor": "firstBuyer", "testid": "search-input", "text": "Keyboard", "enter": true },
            { "do": "click", "actor": "firstBuyer", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Keyboard" } },
            { "do": "click", "actor": "firstBuyer", "testid": "cart-toggle" },
            { "do": "fill", "actor": "firstBuyer", "testid": "cart-promotion", "text": "ONCE10" },
            { "do": "click", "actor": "firstBuyer", "testid": "apply-promotion" },
            { "do": "click", "actor": "firstBuyer", "testid": "checkout-submit" },
            { "do": "fill", "actor": "secondBuyer", "testid": "search-input", "text": "Keyboard", "enter": true },
            { "do": "click", "actor": "secondBuyer", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Keyboard" } },
            { "do": "click", "actor": "secondBuyer", "testid": "cart-toggle" },
            { "do": "fill", "actor": "secondBuyer", "testid": "cart-promotion", "text": "ONCE10" },
            { "do": "click", "actor": "secondBuyer", "testid": "apply-promotion" },
            { "do": "expect", "actor": "secondBuyer", "testid": "promotion-error" }
          ]
        }
      ]
    }
  ]
}
