{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 1,
  "name": "Progression stock limit",
  "features": [
    {
      "id": 3,
      "name": "Buying",
      "actors": ["buyer", "watcher", "visitor"],
      "setup": [
        { "do": "dbSetStock", "item": "Desk Lamp", "warehouse": "East", "quantity": 2, "settleMs": 2000 },
        { "do": "dbSetStock", "item": "Desk Lamp", "warehouse": "West", "quantity": 1, "settleMs": 2000 },
        { "do": "signUp", "actor": "buyer", "name": "eli" },
        { "do": "signUp", "actor": "watcher", "name": "fay" }
      ],
      "criteria": [
        {
          "id": "3d",
          "desc": "an item sells out visibly, and a checkout exceeding stock is refused and changes nothing",
          "points": 2,
          "statedBy": "an item with zero stock cannot be bought",
          "steps": [
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
            { "do": "wait", "actor": "buyer", "ms": 800 },
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
            { "do": "wait", "actor": "buyer", "ms": 800 },
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
            { "do": "expectNumber", "actor": "buyer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "equals": 0 },
            { "do": "expect", "actor": "buyer", "testid": "out-of-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
            { "do": "callAction", "actor": "buyer", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] }, "input": { "testid": "item-card", "contains": "Desk Lamp", "attribute": "data-buy-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "buyer", "outcome": "validation-refused" },
            { "do": "reload", "actor": "buyer", "settleMs": 3000 },
            { "do": "expectNumber", "actor": "buyer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "equals": 0 }
          ]
        }
      ]
    }
  ]
