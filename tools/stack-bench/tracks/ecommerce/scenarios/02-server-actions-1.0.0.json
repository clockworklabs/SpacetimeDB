{
  "schemaVersion": 1,
  "level": 2,
  "track": "ecommerce",
  "name": "Business operations — direct server actions and contention",
  "writeUrlPattern": "\\/api\\/|\\/items|\\/orders|\\/buy|\\/transfer|\\/cancel|\\/ship|\\/fulfil",
  "note": "These focused checks call the same declared operations as the visible interface. Opaque identifiers come from application-provided test handles, so the behavior stays identical across database stacks.",
  "features": [
    {
      "id": 201,
      "name": "Shipping requires an operator",
      "actors": ["customer"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "notstaff" },
        { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Laptop Stand", "enter": true, "settleMs": 1500 },
        { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Laptop Stand" }, "settleMs": 2000 },
        { "do": "click", "actor": "customer", "testid": "orders-toggle" }
      ],
      "criteria": [
        {
          "id": "201c",
          "desc": "the server refuses a customer's direct attempt to ship their own pending order",
          "points": 2,
          "steps": [
            { "do": "callAction", "actor": "customer", "action": "ship", "namedAction": { "id": "ship", "path": "/api/fulfilment/ship", "reducer": "ship_order", "args": [0], "params": [{ "name": "orderId", "in": "body" }] }, "input": { "testid": "order-item", "contains": "Laptop Stand", "attribute": "data-ship-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "refused" },
            { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Laptop Stand" }, "notContains": "hipped" }
          ],
          "statedBy": "only staff and administrators can mark an order as shipped"
        }
      ]
    },
    {
      "id": 202,
      "name": "Stock is conserved while operations overlap",
      "actors": ["admin", "customer"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signUp", "actor": "customer", "name": "conserve" },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Headphones", "enter": true, "settleMs": 1500 }
      ],
      "criteria": [
        {
          "id": "202d",
          "desc": "a direct transfer racing a direct purchase leaves the exact starting total minus the sold unit",
          "points": 2,
          "steps": [
            { "do": "recordNumber", "actor": "admin", "testid": "admin-stock", "in": { "testid": "admin-item-row", "contains": "Headphones" }, "as": "hp-before-race" },
            {
              "do": "race",
              "settleMs": 5000,
              "branches": [
                [
                  { "do": "callAction", "actor": "admin", "action": "transfer", "namedAction": { "id": "transfer", "path": "/api/admin/transfer", "reducer": "admin_transfer_stock", "args": [0, 0, 0, 25], "params": [{ "name": "itemId", "in": "body" }, { "name": "fromWarehouseId", "in": "body" }, { "name": "toWarehouseId", "in": "body" }, { "name": "quantity", "in": "body" }] }, "input": { "testid": "admin-item-row", "contains": "Headphones", "attribute": "data-transfer-input" } }
                ],
                [
                  { "do": "callAction", "actor": "customer", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id" }] }, "input": { "testid": "item-card", "contains": "Headphones", "attribute": "data-buy-input" } }
                ]
              ]
            },
            { "do": "expectActionOutcome", "actor": "admin", "outcome": "accepted" },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "accepted" },
            { "do": "expectNumber", "actor": "admin", "testid": "admin-stock", "in": { "testid": "admin-item-row", "contains": "Headphones" }, "relativeTo": "hp-before-race", "plus": -1, "within": 12000 }
          ],
          "statedBy": "a transfer moves stock and a purchase removes one unit; neither operation may erase the other"
        }
      ]
    },
    {
      "id": 204,
      "name": "An order belongs to the person who placed it",
      "actors": ["owner", "other"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "owner" },
        { "do": "signUp", "actor": "other", "name": "other" },
        { "do": "fill", "actor": "owner", "testid": "search-input", "text": "Chisel", "enter": true, "settleMs": 1500 },
        { "do": "click", "actor": "owner", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Chisel" }, "settleMs": 2000 },
        { "do": "fill", "actor": "owner", "testid": "search-input", "text": "Laptop Stand", "enter": true, "settleMs": 1500 },
        { "do": "click", "actor": "owner", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Laptop Stand" }, "settleMs": 2000 },
        { "do": "click", "actor": "owner", "testid": "orders-toggle" }
      ],
      "criteria": [
        {
          "id": "204a",
          "desc": "the server refuses one customer trying to cancel another customer's still-pending order",
          "points": 2,
          "steps": [
            { "do": "callAction", "actor": "owner", "action": "cancel", "namedAction": { "id": "cancel", "path": "/api/orders/:id/cancel", "reducer": "cancel_order", "args": [0], "params": [{ "name": "orderId", "in": "path", "placeholder": ":id" }] }, "input": { "testid": "order-item", "contains": "Chisel", "attribute": "data-cancel-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "owner", "outcome": "accepted" },
            { "do": "callAction", "actor": "other", "from": "owner", "action": "cancel", "namedAction": { "id": "cancel", "path": "/api/orders/:id/cancel", "reducer": "cancel_order", "args": [0], "params": [{ "name": "orderId", "in": "path", "placeholder": ":id" }] }, "input": { "testid": "order-item", "contains": "Laptop Stand", "attribute": "data-cancel-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "other", "outcome": "refused", "routeProvenBy": "owner" },
            { "do": "expect", "actor": "owner", "testid": "order-status", "in": { "testid": "order-item", "contains": "Laptop Stand" }, "notContains": "ancelled" }
          ],
          "statedBy": "a customer can cancel only their own pending order"
        }
      ]
    }
  ]
}
