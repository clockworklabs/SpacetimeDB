{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Review access",
  "features": [
    {
      "id": 618,
      "name": "Review access",
      "actors": ["owner", "stranger"],
      "setup": [
        { "do": "signUp", "actor": "owner", "name": "review-owner" },
        { "do": "signUp", "actor": "stranger", "name": "review-stranger" },
        { "do": "click", "actor": "owner", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } },
        { "do": "click", "actor": "owner", "testid": "item-name", "in": { "testid": "item-card", "contains": "Keyboard" } }
      ],
      "criteria": [
        {
          "id": "618a",
          "desc": "the server refuses a review from a customer who did not buy the item",
          "points": 2,
          "statedBy": "Only a customer who bought an item can review it.",
          "steps": [
            {
              "do": "replayAs",
              "actor": "stranger",
              "from": "owner",
              "match": "never bought this",
              "namedAction": {
                "id": "submitReview",
                "path": "/api/items/:id/reviews",
                "method": "POST",
                "reducer": "submit_review",
                "args": [0, 5, "never bought this"],
                "params": [
                  { "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" },
                  { "name": "rating", "in": "body" },
                  { "name": "comment", "in": "body" }
                ]
              },
              "namedTarget": {
                "testid": "review-submit",
                "attribute": "data-review-item-id",
                "valueType": "number"
              },
              "settleMs": 1500
            },
            { "do": "expectReplayRejected", "actor": "stranger" },
            { "do": "expect", "actor": "owner", "testid": "review-item", "contains": "never bought this", "absent": true }
          ]
        }
      ]
    }
  ]
}
