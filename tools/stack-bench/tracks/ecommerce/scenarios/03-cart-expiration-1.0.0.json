{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 3,
  "name": "Cart expiration",
  "note": "The browser stays closed while the cart expires.",
  "features": [{
    "id": 304,
    "name": "An inactive cart expires",
    "actors": ["customer", "watcher"],
    "setup": [
      { "do": "signUp", "actor": "customer", "name": "cart-expiry" },
      { "do": "recordNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "as": "before" },
      { "do": "click", "actor": "customer", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Air Purifier" } },
      { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "before", "plus": -1, "within": 10000 },
      { "do": "closeClient", "actor": "customer" }
    ],
    "criteria": [{
      "id": "304a",
      "desc": "an inactive cart expires without a browser, releases stock, and returns empty",
      "points": 4,
      "statedBy": "A cart with no activity for five minutes expires and releases its reservations.",
      "steps": [
        { "do": "wait", "actor": "watcher", "ms": 310000 },
        { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "before", "plus": 0, "within": 30000 },
        { "do": "openClient", "actor": "customer", "settleMs": 3000 },
        { "do": "expect", "actor": "customer", "testid": "cart-expired-notice", "within": 10000 },
        { "do": "expectNumber", "actor": "customer", "testid": "cart-count", "equals": 0 }
      ]
    }]
  }]
}
