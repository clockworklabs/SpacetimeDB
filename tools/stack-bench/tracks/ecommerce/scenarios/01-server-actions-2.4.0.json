{
  "schemaVersion": 1,
  "status": "candidate",
  "track": "ecommerce",
  "level": 1,
  "name": "Direct action boundaries",
  "note": "Refusal checks first prove the same valid route and input with an authorized actor. A missing or malformed endpoint therefore cannot earn authorization credit merely by returning an error.",
  "features": [
    {
      "id": 101,
      "name": "Purchase requires an account",
      "actors": ["buyer", "guest"],
      "setup": [{ "do": "signUp", "actor": "buyer", "name": "kim" }],
      "criteria": [
        {
          "id": "101a",
          "desc": "a valid direct purchase works for the buyer but is refused without a session",
          "points": 2,
          "steps": [
            { "do": "recordNumber", "actor": "buyer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Bluetooth Speaker" }, "as": "speaker-before-control" },
            { "do": "callAction", "actor": "buyer", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] }, "input": { "testid": "item-card", "contains": "Bluetooth Speaker", "attribute": "data-buy-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "buyer", "outcome": "accepted" },
            { "do": "expectNumber", "actor": "buyer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Bluetooth Speaker" }, "relativeTo": "speaker-before-control", "plus": -1 },
            { "do": "callAction", "actor": "guest", "from": "buyer", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] }, "input": { "testid": "item-card", "contains": "Bluetooth Speaker", "attribute": "data-buy-input" }, "authentication": "none", "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "guest", "outcome": "refused" },
            { "do": "expectNumber", "actor": "buyer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Bluetooth Speaker" }, "relativeTo": "speaker-before-control", "plus": -1 }
          ],
          "statedBy": "the server refuses a purchase without an authenticated customer"
        }
      ]
    },
    {
      "id": 102,
      "name": "Purchases are attributed to whoever made them",
      "actors": ["victim", "attacker"],
      "setup": [
        { "do": "signUp", "actor": "victim", "name": "lee" },
        { "do": "signUp", "actor": "attacker", "name": "mel" }
      ],
      "criteria": [
        {
          "id": "102a",
          "desc": "a direct purchase is attributed to the authenticated caller, not another account",
          "points": 2,
          "steps": [
            { "do": "callAction", "actor": "attacker", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] }, "input": { "testid": "item-card", "contains": "Desk Lamp", "attribute": "data-buy-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "attacker", "outcome": "accepted" },
            { "do": "click", "actor": "victim", "testid": "orders-toggle" },
            { "do": "expect", "actor": "victim", "testid": "order-item", "contains": "Desk Lamp", "absent": true },
            { "do": "click", "actor": "attacker", "testid": "orders-toggle" },
            { "do": "expect", "actor": "attacker", "testid": "order-item", "contains": "Desk Lamp", "count": 1 }
          ],
          "statedBy": "the authenticated caller, not a client-supplied identity, owns the order"
        }
      ]
    },
    {
      "id": 103,
      "name": "Only an administrator can restock",
      "actors": ["admin", "customer"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "signUp", "actor": "customer", "name": "ned" }
      ],
      "criteria": [
        {
          "id": "103a",
          "desc": "a valid direct restock works for the administrator but is refused for a customer",
          "points": 2,
          "steps": [
            { "do": "click", "actor": "admin", "testid": "admin-link" },
            { "do": "recordNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "as": "purifier-before-control" },
            { "do": "callAction", "actor": "admin", "action": "restock", "namedAction": { "id": "restock", "path": "/api/admin/restock", "reducer": "admin_restock", "args": [0, 0, 1], "params": [{ "name": "itemId", "in": "body", "wireType": "u64" }, { "name": "warehouseId", "in": "body", "wireType": "u64" }, { "name": "quantity", "in": "body" }] }, "input": { "testid": "admin-location-row", "contains": "Air Purifier", "attribute": "data-restock-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "admin", "outcome": "accepted" },
            { "do": "expectNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "purifier-before-control", "plus": 1 },
            { "do": "recordNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "as": "purifier-after-control" },
            { "do": "callAction", "actor": "customer", "from": "admin", "action": "restock", "namedAction": { "id": "restock", "path": "/api/admin/restock", "reducer": "admin_restock", "args": [0, 0, 1], "params": [{ "name": "itemId", "in": "body", "wireType": "u64" }, { "name": "warehouseId", "in": "body", "wireType": "u64" }, { "name": "quantity", "in": "body" }] }, "input": { "testid": "admin-location-row", "contains": "Air Purifier", "attribute": "data-restock-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "refused" },
            { "do": "expectNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "purifier-after-control", "plus": 0 }
          ],
          "statedBy": "the server refuses warehouse writes from a non-admin account"
        }
      ]
    },
    {
      "id": 104,
      "name": "The price is the store's to set",
      "actors": ["buyer"],
      "setup": [{ "do": "signUp", "actor": "buyer", "name": "oli" }],
      "criteria": [
        {
          "id": "104a",
          "desc": "the direct purchase operation creates exactly one order at the store's current price",
          "points": 2,
          "steps": [
            { "do": "callAction", "actor": "buyer", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] }, "input": { "testid": "item-card", "contains": "Espresso Machine", "attribute": "data-buy-input" }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "buyer", "outcome": "accepted" },
            { "do": "click", "actor": "buyer", "testid": "orders-toggle" },
            { "do": "expect", "actor": "buyer", "testid": "order-item", "contains": "Espresso Machine", "count": 1 },
            { "do": "expectNumber", "actor": "buyer", "testid": "order-total", "in": { "testid": "order-item", "contains": "Espresso Machine" }, "equals": 449 }
          ],
          "statedBy": "the server uses the current stored price when it creates an order"
        }
      ]
    }
  ]
}
