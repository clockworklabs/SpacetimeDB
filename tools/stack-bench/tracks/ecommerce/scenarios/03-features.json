{
  "level": 3,
  "track": "ecommerce",
  "name": "Work that happens later — features",
  "writeUrlPattern": "\\/api\\/|\\/items|\\/cart|\\/orders|\\/checkout|\\/buy|\\/reviews|\\/stock|\\/restock|\\/warehouses|\\/schedule",
  "note": "Deferred work observed from the outside: a reservation that releases itself, a restock that fires on a timer, an order that advances with nobody watching. Every wait here is real time — these criteria are slow by nature and the timings come from the spec (90s reservation, 60s transitions), not from guesses about implementation.",
  "features": [
    {
      "id": 301,
      "name": "A reservation holds stock and then releases it",
      "actors": ["shopper", "watcher"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "resa" },
        {
          "do": "recordNumber",
          "actor": "watcher",
          "testid": "item-stock",
          "in": { "testid": "item-card", "contains": "Desk Lamp" },
          "as": "lamp-before"
        }
      ],
      "criteria": [
        {
          "id": "301a",
          "desc": "adding to the cart takes a unit off the shelf immediately, for a signed-out viewer who never touched the page",
          "points": 2,
          "steps": [
            {
              "do": "click",
              "actor": "shopper",
              "testid": "add-to-cart",
              "in": { "testid": "item-card", "contains": "Desk Lamp" },
              "settleMs": 1500
            },
            {
              "do": "expectNumber",
              "actor": "watcher",
              "testid": "item-stock",
              "in": { "testid": "item-card", "contains": "Desk Lamp" },
              "relativeTo": "lamp-before",
              "plus": -1,
              "within": 10000
            }
          ]
        },
        {
          "id": "301b",
          "desc": "the cart line shows the reservation counting down",
          "points": 1,
          "steps": [
            { "do": "click", "actor": "shopper", "testid": "cart-toggle", "settleMs": 1200 },
            {
              "do": "expect",
              "actor": "shopper",
              "testid": "cart-reservation-timer",
              "in": { "testid": "cart-item", "contains": "Desk Lamp" },
              "within": 8000
            }
          ]
        },
        {
          "id": "301c",
          "desc": "left alone, the reservation expires on its own: the unit returns to the shelf for the watcher without a reload, and the line is marked expired rather than vanishing",
          "points": 3,
          "note": "waits out the spec's 90-second window plus slack; slow by nature.",
          "steps": [
            { "do": "wait", "actor": "shopper", "ms": 100000 },
            {
              "do": "expectNumber",
              "actor": "watcher",
              "testid": "item-stock",
              "in": { "testid": "item-card", "contains": "Desk Lamp" },
              "relativeTo": "lamp-before",
              "plus": 0,
              "within": 30000
            },
            {
              "do": "expect",
              "actor": "shopper",
              "testid": "cart-item-expired",
              "in": { "testid": "cart-item", "contains": "Desk Lamp" },
              "within": 15000
            }
          ]
        }
      ]
    },
    {
      "id": 302,
      "name": "A restock scheduled for later applies itself",
      "actors": ["admin", "watcher"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "exact": true, "password": "stackbench-admin-2026" },
        { "do": "click", "actor": "admin", "testid": "admin-link", "settleMs": 1500 },
        {
          "do": "recordNumber",
          "actor": "watcher",
          "testid": "item-stock",
          "in": { "testid": "item-card", "contains": "Webcam" },
          "as": "webcam-before"
        }
      ],
      "criteria": [
        {
          "id": "302a",
          "desc": "a scheduled restock appears as pending with time remaining, and has not yet changed stock",
          "points": 2,
          "steps": [
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Webcam" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "East" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "7" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "45" },
            { "do": "click", "actor": "admin", "testid": "schedule-restock-submit", "settleMs": 2000 },
            {
              "do": "expect",
              "actor": "admin",
              "testid": "pending-restock-item",
              "contains": "Webcam",
              "within": 8000
            },
            {
              "do": "expect",
              "actor": "admin",
              "testid": "pending-restock-remaining",
              "in": { "testid": "pending-restock-item", "contains": "Webcam" },
              "within": 8000
            },
            {
              "do": "expectNumber",
              "actor": "watcher",
              "testid": "item-stock",
              "in": { "testid": "item-card", "contains": "Webcam" },
              "relativeTo": "webcam-before",
              "plus": 0
            }
          ]
        },
        {
          "id": "302b",
          "desc": "when the delay elapses it applies itself: stock rises for a viewer who did nothing, and it leaves the pending list",
          "points": 3,
          "steps": [
            { "do": "wait", "actor": "admin", "ms": 55000 },
            {
              "do": "expectNumber",
              "actor": "watcher",
              "testid": "item-stock",
              "in": { "testid": "item-card", "contains": "Webcam" },
              "relativeTo": "webcam-before",
              "plus": 7,
              "within": 30000
            },
            {
              "do": "expect",
              "actor": "admin",
              "testid": "pending-restock-item",
              "contains": "Webcam",
              "absent": true,
              "within": 15000
            }
          ]
        },
        {
          "id": "302c",
          "desc": "a cancelled restock never applies",
          "points": 2,
          "steps": [
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Keyboard" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "West" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "9" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "40" },
            { "do": "click", "actor": "admin", "testid": "schedule-restock-submit", "settleMs": 2000 },
            {
              "do": "recordNumber",
              "actor": "watcher",
              "testid": "item-stock",
              "in": { "testid": "item-card", "contains": "Keyboard" },
              "as": "kbd-before"
            },
            {
              "do": "click",
              "actor": "admin",
              "testid": "pending-restock-cancel",
              "in": { "testid": "pending-restock-item", "contains": "Keyboard" },
              "settleMs": 2000
            },
            { "do": "wait", "actor": "admin", "ms": 50000 },
            {
              "do": "expectNumber",
              "actor": "watcher",
              "testid": "item-stock",
              "in": { "testid": "item-card", "contains": "Keyboard" },
              "relativeTo": "kbd-before",
              "plus": 0,
              "within": 10000
            }
          ]
        }
      ]
    }
  ]
}
