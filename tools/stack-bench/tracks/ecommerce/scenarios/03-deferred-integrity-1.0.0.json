{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 3,
  "name": "Deferred-work integrity",
  "note": "Each check owns all state used by its exact-once or stock assertion.",
  "features": [
    {
      "id": 311,
      "name": "A restock applies once",
      "actors": ["admin", "watcher"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true }, { "do": "click", "actor": "admin", "testid": "admin-link" }, { "do": "recordNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "as": "before" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Air Purifier" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "East" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "5" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "20" }, { "do": "click", "actor": "admin", "testid": "schedule-restock-submit" },
        { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "contains": "Air Purifier", "within": 10000 }, { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "before", "plus": 0 },
        { "do": "restartBackend", "settleMs": 15000 }, { "do": "reload", "actor": "watcher", "settleMs": 3000 }
      ],
      "criteria": [{ "id": "311a", "desc": "restart cannot replay a completed restock", "points": 3, "statedBy": "Restarting the backend cannot apply a restock more than once.", "steps": [{ "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "before", "plus": 5, "within": 45000 }, { "do": "restartBackend", "settleMs": 15000 }, { "do": "reload", "actor": "watcher", "settleMs": 3000 }, { "do": "wait", "actor": "watcher", "ms": 15000 }, { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Air Purifier" }, "relativeTo": "before", "plus": 5 }] }]
    },
    {
      "id": 312,
      "name": "Delivery applies once",
      "actors": ["customer", "staff"],
      "setup": [{ "do": "signUp", "actor": "customer", "name": "once-delivery" }, { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true }, { "do": "click", "actor": "staff", "testid": "staff-link" }, { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" } }, { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Desk Lamp", "within": 10000 }, { "do": "click", "actor": "staff", "testid": "ship-submit", "in": { "testid": "queue-item", "contains": "Desk Lamp" } }, { "do": "click", "actor": "customer", "testid": "orders-toggle" }, { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Desk Lamp" }, "contains": "hipped", "within": 10000 }, { "do": "wait", "actor": "customer", "ms": 70000 }, { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Desk Lamp" }, "contains": "elivered", "within": 15000 }, { "do": "restartBackend", "settleMs": 15000 }, { "do": "reload", "actor": "staff", "settleMs": 3000 }],
      "criteria": [{ "id": "312a", "desc": "restart cannot duplicate a delivered order", "points": 3, "statedBy": "Restarting the backend cannot apply an order transition more than once.", "steps": [{ "do": "expect", "actor": "staff", "testid": "completed-order-item", "contains": "Desk Lamp", "count": 1 }, { "do": "expect", "actor": "staff", "testid": "completed-order-status", "in": { "testid": "completed-order-item", "contains": "Desk Lamp" }, "contains": "elivered" }] }]
    },
    {
      "id": 313,
      "name": "Reservation expiry conserves stock",
      "actors": ["customer", "watcher"],
      "setup": [{ "do": "signUp", "actor": "customer", "name": "conserve-expiry" }, { "do": "recordNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "as": "before" }, { "do": "click", "actor": "customer", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Keyboard" } }],
      "criteria": [{ "id": "313a", "desc": "expiry returns exactly the unit reserved", "points": 3, "statedBy": "Reservation expiry returns exactly the stock that the reservation took.", "steps": [{ "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "relativeTo": "before", "plus": -1, "within": 10000 }, { "do": "wait", "actor": "watcher", "ms": 100000 }, { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "relativeTo": "before", "plus": 0, "within": 30000 }] }]
    },
    {
      "id": 314,
      "name": "Checkout conserves reserved stock",
      "actors": ["customer", "watcher"],
      "setup": [{ "do": "signUp", "actor": "customer", "name": "conserve-checkout" }, { "do": "recordNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "as": "before" }, { "do": "click", "actor": "customer", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Headphones" } }, { "do": "click", "actor": "customer", "testid": "cart-toggle" }],
      "criteria": [{ "id": "314a", "desc": "checkout does not decrement stock after the reservation already did", "points": 3, "statedBy": "Checkout does not take reserved stock twice.", "steps": [{ "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "relativeTo": "before", "plus": -1, "within": 10000 }, { "do": "click", "actor": "customer", "testid": "checkout-submit" }, { "do": "expectNumber", "actor": "customer", "testid": "cart-count", "equals": 0, "within": 10000 }, { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Headphones" }, "relativeTo": "before", "plus": -1, "within": 10000 }] }]
    }
  ]
}
