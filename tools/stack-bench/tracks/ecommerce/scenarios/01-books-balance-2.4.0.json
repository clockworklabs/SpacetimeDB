          ],
          "statedBy": "total revenue equals the sum of order totals"
        },
        {
          "id": "107b",
          "desc": "what the store sold is what left the warehouses, and a fresh client agrees",
          "points": 1,
          "steps": [
            {
              "do": "expectNumber",
              "actor": "admin",
              "testid": "admin-stock",
