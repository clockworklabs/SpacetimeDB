              "relativeTo": "stand-before",
              "plus": -2
            },
            {"do":"freshClient","actor":"buyer"},
            {
              "do": "expectNumber",
              "actor": "buyer-fresh",
              "testid": "item-stock",
              "in": {"testid":"item-card","contains":"Laptop Stand"},
