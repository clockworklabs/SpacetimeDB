        {
          "do": "click",
          "actor": "buyer",
          "testid": "buy-now",
          "in": {"testid":"item-card","contains":"Laptop Stand"}
        },
        {"do":"wait","actor":"buyer","ms":1000},
        {
          "do": "click",
          "actor": "buyer",
          "testid": "buy-now",
          "in": {"testid":"item-card","contains":"Laptop Stand"}
        },
        {"do":"wait","actor":"buyer","ms":2000}
      ],
      "criteria": [
        {
          "id": "107a",
          "desc": "revenue rises by exactly what was bought",
          "points": 1,
          "steps": [
            {
              "do": "expectNumber",
              "actor": "admin",
              "testid": "admin-revenue",
              "relativeTo": "revenue-before",
              "plus": 58,
