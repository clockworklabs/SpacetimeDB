{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "The price is the store's to set",
  "note": "Two different prices and a fresh account session verify stored order totals. This does not claim to test arbitrary forged fields; the declared purchase accepts only an item identifier. The later price-change check exercises a changed price.",
  "features": [
    {
      "id": 104,
      "name": "The price is the store's to set",
      "actors": ["buyer"],
      "setup": [{"do":"signUp","actor":"buyer","name":"oli"}],
      "criteria": [
        {
          "id": "104a",
          "category": "production",
          "desc": "direct purchases of two differently priced items persist exactly one correctly priced order each",
          "points": 2,
          "steps": [
            {
              "do": "callAction",
              "actor": "buyer",
              "action": "buy",
              "namedAction": {
                "id": "buy",
                "path": "/api/items/:id/buy",
                "reducer": "buy_now",
                "args": [0],
                "params": [{"name":"itemId","in":"path","placeholder":":id","wireType":"u64"}]
              },
              "input": {"testid":"item-card","contains":"Espresso Machine","attribute":"data-buy-input"},
              "settleMs": 2000
            },
            {"do":"expectActionOutcome","actor":"buyer","outcome":"accepted"},
            {
              "do": "callAction", "actor": "buyer", "action": "buy",
              "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] },
              "input": { "testid": "item-card", "contains": "Coffee Grinder", "attribute": "data-buy-input" },
              "settleMs": 2000
            },
            { "do": "expectActionOutcome", "actor": "buyer", "outcome": "accepted" },
            { "do": "freshClient", "actor": "buyer" },
            { "do": "signIn", "actor": "buyer-fresh", "name": "oli" },
            {"do":"click","actor":"buyer-fresh","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
            {"do":"click","actor":"buyer-fresh","testid":"orders-toggle", "unlessVisible": "order-item" },
            {"do":"expect","actor":"buyer-fresh","testid":"order-item","count":2},
            {"do":"expect","actor":"buyer-fresh","testid":"order-item","contains":"Espresso Machine","count":1},
            {
              "do": "expectNumber",
              "actor": "buyer-fresh",
              "testid": "order-total",
              "in": {"testid":"order-item","contains":"Espresso Machine"},
              "equals": 449
            },
            { "do": "expect", "actor": "buyer-fresh", "testid": "order-item", "contains": "Coffee Grinder", "count": 1 },
            { "do": "expectNumber", "actor": "buyer-fresh", "testid": "order-total", "in": { "testid": "order-item", "contains": "Coffee Grinder" }, "equals": 64 }
          ],
          "statedBy": "the server uses the current stored price when it creates an order"
        }
      ]
    }
  ]
}
