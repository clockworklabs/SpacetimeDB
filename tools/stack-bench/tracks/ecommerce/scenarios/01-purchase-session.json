{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Purchase requires an account",
  "note": "Draft: the purchase-session check includes a bounded credential-tampering probe. Valid purchases must work before and after it. Stored order and stock reads must show no effect from a refused forgery. The read scope requires neither carts nor warehouses. Unsupported or ambiguous credentials remain inconclusive, never a pass or an app defect. This does not test expiry, revocation or every token attack.",
  "features": [
    {
      "id": 101,
      "name": "Purchase requires an account",
      "actors": [
        "buyer",
        "guest",
        "wrong-password",
        "duplicate"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "buyer",
          "name": "kim"
        },
        {
          "do": "dbRecordStock",
          "item": "Bluetooth Speaker",
          "as": "speaker-before-control"
        },
        {
          "do": "callAction",
          "actor": "buyer",
          "action": "buy",
          "namedAction": {
            "id": "buy",
            "path": "/api/items/:id/buy",
            "reducer": "buy_now",
            "args": [
              0
            ],
            "params": [
              {
                "name": "itemId",
                "in": "path",
                "placeholder": ":id",
                "wireType": "u64"
              }
            ]
          },
          "input": {
            "testid": "item-card",
            "contains": "Bluetooth Speaker",
            "attribute": "data-buy-input"
          },
          "settleMs": 2000
        },
        {
          "do": "expectActionOutcome",
          "actor": "buyer",
          "outcome": "accepted"
        },
        {
          "do": "dbExpectStock",
          "item": "Bluetooth Speaker",
          "relativeTo": "speaker-before-control",
          "plus": -1
        }
      ],
