      "actors": [
        "buyer",
        "guest",
        "wrong-password",
        "duplicate"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "buyer",
          "name": "kim"
        },
        {
          "do": "dbRecordStock",
          "item": "Bluetooth Speaker",
          "as": "speaker-before-control"
        },
        {
          "do": "callAction",
          "actor": "buyer",
          "action": "buy",
          "namedAction": {
            "id": "buy",
            "path": "/api/items/:id/buy",
            "reducer": "buy_now",
            "args": [
              0
            ],
            "params": [
              {
                "name": "itemId",
                "in": "path",
                "placeholder": ":id",
                "wireType": "u64"
              }
            ]
          },
          "input": {
            "testid": "item-card",
            "contains": "Bluetooth Speaker",
            "attribute": "data-buy-input"
          },
          "settleMs": 2000
        },
        {
          "do": "expectActionOutcome",
          "actor": "buyer",
          "outcome": "accepted"
        },
        {
          "do": "dbExpectStock",
          "item": "Bluetooth Speaker",
          "relativeTo": "speaker-before-control",
          "plus": -1
        }
