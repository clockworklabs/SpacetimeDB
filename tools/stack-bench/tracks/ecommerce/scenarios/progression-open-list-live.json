{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Progression open review list",
  "features": [
    {
      "id": 902,
      "name": "An open list stays current",
      "actors": ["reader", "reviewer"],
      "setup": [
        { "do": "signUp", "actor": "reviewer", "name": "raceR" },
        { "do": "signUp", "actor": "reader", "name": "raceL" },
        {"do":"callAction","actor":"reviewer","action":"buy","namedAction":{"id":"buy","path":"/api/items/:id/buy","reducer":"buy_now","args":[0],"params":[{"name":"itemId","in":"path","placeholder":":id","wireType":"u64"}]},"input":{"testid":"item-card","contains":"Keyboard","attribute":"data-buy-input"}},
        {"do":"expectActionOutcome","actor":"reviewer","outcome":"accepted"},
        {"do":"click","actor":"reviewer","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
        {"do":"click","actor":"reviewer","testid":"orders-toggle","unlessVisible":"order-item"},
        {"do":"expect","actor":"reviewer","testid":"order-item","contains":"Keyboard","within":10000},
        {"do":"click","actor":"reviewer","testid":"overlay-close","ifAvailable":true},
        {"do":"click","actor":"reviewer","testid":"catalog-link","ifAvailable":true},
        {"do": "openItem", "actor": "reviewer", "item": "Keyboard"},
        { "do": "expect", "actor": "reviewer", "testid": "item-detail", "within": 10000 },
        {"do":"click","actor":"reviewer","testid":"review-toggle","unlessVisible":"review-rating","ifAvailable":true},
        { "do": "fill", "actor": "reviewer", "testid": "review-rating", "text": "5" }
      ],
      "criteria": [
        {
          "id": "902a",
          "category": "production",
          "desc": "one customer has the Keyboard's reviews open before another posts one; the already-open view shows that review exactly once",
          "points": 1,
          "statedBy": "A view opened while a review is submitted converges to the current review list.",
          "steps": [
            {"do": "openItem", "actor": "reader", "item": "Keyboard"},
            { "do": "expect", "actor": "reader", "testid": "item-detail", "within": 10000 },
            {"do":"click","actor":"reviewer","testid":"review-toggle","unlessVisible":"review-rating","ifAvailable":true},
            { "do": "fill", "actor": "reviewer", "testid": "review-input", "text": "live-review-kbd" },
            { "do": "click", "actor": "reviewer", "testid": "review-submit" },
            { "do": "expectElementCount", "actor": "reviewer", "testid": "review-item", "contains": "live-review-kbd", "equals": 1, "within": 10000 },
            { "do": "expectElementCount", "actor": "reader", "testid": "review-item", "contains": "live-review-kbd", "equals": 1, "within": 10000 }
          ]
        }
      ]
    }
  ]
}
