{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Completed order return",
  "note": "Draft: revised observations require matching reference and defect-control qualification.",
  "features": [
    {
      "id": 330,
      "name": "Completed order return",
      "actors": [
        "customer",
        "staff",
        "admin"
      ],
      "setup": [
        {"do":"signUp","actor":"customer","name":"return-complete"},
        {"do":"signIn","actor":"staff","name":"staff","password":"stackbench-staff-2026","exact":true},
        {"do":"signIn","actor":"admin","name":"admin","password":"stackbench-admin-2026","exact":true},
        {"do":"click","actor":"staff","testid":"staff-link"},
        {"do":"click","actor":"admin","testid":"admin-link"},
        {"do":"expectNumber","actor":"customer","testid":"item-price","in":{"testid":"item-card","contains":"Keyboard"},"equals":89},
        {"do":"dbRecordStock","item":"Keyboard","as":"return-stock-before"},
        {"do":"recordNumber","actor":"admin","testid":"admin-revenue","as":"return-revenue-before"},
        {"do":"click","actor":"customer","testid":"buy-now","in":{"testid":"item-card","contains":"Keyboard"}},
        {"do":"reload","actor":"staff","settleMs":1000},
        {"do":"ensureSignedIn","actor":"staff","name":"staff","readyTestid":"current-user","password":"stackbench-staff-2026","exact":true},
        {"do":"click","actor":"staff","testid":"overlay-close","ifAvailable":true,"within":1000},
        {"do":"click","actor":"staff","testid":"staff-link","unlessVisible":"queue-item"},
        {"do":"expect","actor":"staff","testid":"queue-item","contains":"Keyboard","within":10000},
        {"do":"dbExpectStock","item":"Keyboard","relativeTo":"return-stock-before","plus":-1},
        {"do":"reload","actor":"admin","settleMs":1000},
        {"do":"ensureSignedIn","actor":"admin","name":"admin","readyTestid":"current-user","password":"stackbench-admin-2026","exact":true},
        {"do":"click","actor":"admin","testid":"overlay-close","ifAvailable":true,"within":1000},
        {"do":"click","actor":"admin","testid":"admin-link","unlessVisible":"admin-revenue"},
        {"do":"expectNumber","actor":"admin","testid":"admin-revenue","relativeTo":"return-revenue-before","plus":89,"within":10000},
        {"do":"click","actor":"staff","testid":"ship-submit","in":{"testid":"queue-item","contains":"Keyboard"}},
        {"do":"reload","actor":"customer","settleMs":1000},
        {"do":"ensureSignedIn","actor":"customer","name":"return-complete","readyTestid":"current-user"},
        {"do":"click","actor":"customer","testid":"overlay-close","ifAvailable":true,"within":1000},
        {"do":"click","actor":"customer","testid":"orders-toggle","unlessVisible":"order-item"},
        {"do":"expect","actor":"customer","testid":"order-status","in":{"testid":"order-item","contains":"Keyboard"},"value":"shipped","ignoreCase":true,"within":10000}
      ],
      "criteria": [
        {
          "id": "3c",
          "category": "production",
          "desc": "returning a shipped item restores stock and revenue and marks the item returned",
          "points": 3,
          "statedBy": "An accepted return marks the item as returned, restores stock, and reduces revenue by the price paid.",
          "steps": [
            {"do":"click","actor":"customer","testid":"return-item","in":{"testid":"order-item","contains":"Keyboard"}},
            {"do":"expect","actor":"customer","testid":"order-status","in":{"testid":"order-item","contains":"Keyboard"},"value":"returned","ignoreCase":true,"within":10000},
            {"do":"freshClient","actor":"customer"},
            {"do":"signIn","actor":"customer-fresh","name":"return-complete"},
            {"do":"click","actor":"customer-fresh","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
            {"do":"click","actor":"customer-fresh","testid":"orders-toggle"},
            {"do":"expect","actor":"customer-fresh","testid":"order-status","in":{"testid":"order-item","contains":"Keyboard"},"value":"returned","ignoreCase":true,"within":10000},
            {"do":"reload","actor":"admin","settleMs":1000},
            {"do":"ensureSignedIn","actor":"admin","name":"admin","password":"stackbench-admin-2026","exact":true,"readyTestid":"current-user"},
            {"do":"click","actor":"admin","testid":"admin-link","unlessVisible":"admin-revenue"},
            {"do":"expectNumber","actor":"admin","testid":"admin-revenue","relativeTo":"return-revenue-before","plus":0,"within":10000},
            {"do":"click","actor":"customer","testid":"overlay-close","ifAvailable":true,"within":1000},
            {"do":"click","actor":"customer","testid":"catalog-link","ifAvailable":true,"within":1000},
            {"do":"dbExpectStock","item":"Keyboard","relativeTo":"return-stock-before","plus":0}
          ]
        }
      ]
    }
  ]
}
