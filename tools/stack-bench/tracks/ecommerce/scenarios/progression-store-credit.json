{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 5,
  "name": "Store credit",
  "features": [
    {
      "id": 750,
      "name": "Credit checkout records both payment portions",
      "actors": [
        "owner",
        "staff",
        "tab"
      ],
      "setup": [
        {"do":"signUp","actor":"owner","name":"credit-owner-750"},
        {"do":"click","actor":"owner","testid":"credit-link","unlessVisible":"credit-panel"},
        {"do":"expect","actor":"owner","testid":"credit-panel","attribute":"aria-busy","value":"false","within":10000},
        {"do":"signIn","actor":"staff","name":"staff","password":"stackbench-staff-2026","exact":true},
        {"do":"click","actor":"staff","testid":"credit-link","unlessVisible":"credit-panel"},
        {"do":"expect","actor":"staff","testid":"credit-panel","attribute":"aria-busy","value":"false","within":10000},
        {"do":"fill","actor":"staff","testid":"credit-amount-input","text":"10.00"},
        {"do":"fill","actor":"staff","testid":"credit-reference-input","text":"credit-750"},
        {"do":"callAction","actor":"staff","from":"staff","action":"grantCredit","namedAction":{"id":"grantCredit","path":"/api/staff/credit","method":"POST","reducer":"grant_credit","args":[0,1000,""],"params":[{"name":"accountId","in":"body","wireType":"u64"},{"name":"amountMinor","in":"body"},{"name":"reference","in":"body"}]},"input":{"testid":"credit-grant","attribute":"data-action-input","overrides":{"accountId":{"actor":"owner","testid":"credit-panel","attribute":"data-account-id"}}},"settleMs":0},
        {"do":"expectActionOutcome","actor":"staff","outcome":"accepted"},
        {"do":"expectNumber","actor":"owner","testid":"credit-balance","equals":10,"within":10000},
        {"do":"click","actor":"owner","testid":"catalog-link"},
        {"do":"click","actor":"owner","testid":"add-to-cart","in":{"testid":"item-card","contains":"Desk Lamp"}},
        {"do":"click","actor":"owner","testid":"cart-toggle"},
        {"do":"expectNumber","actor":"owner","testid":"cart-total","equals":42}
      ],
      "criteria": [
        {
          "id": "750a",
          "category": "feature",
          "desc": "Credit checkout records both payment portions",
          "points": 2,
          "steps": [
            {"do":"click","actor":"owner","testid":"credit-checkout"},
            {"do":"freshClient","actor":"owner"},
            {"do":"signIn","actor":"owner-fresh","name":"credit-owner-750"},
            {"do":"click","actor":"owner-fresh","testid":"orders-toggle","unlessVisible":"order-item"},
            {"do":"expectElementCount","actor":"owner-fresh","testid":"order-item","contains":"Desk Lamp","equals":1,"within":10000},
            {"do":"expectNumber","actor":"owner-fresh","testid":"payment-credit-amount","equals":10,"in":{"testid":"order-item","contains":"Desk Lamp"}},
            {"do":"expectNumber","actor":"owner-fresh","testid":"payment-external-amount","equals":32,"in":{"testid":"order-item","contains":"Desk Lamp"}},
            {"do":"expectNumber","actor":"owner-fresh","testid":"payment-amount","equals":42,"in":{"testid":"order-item","contains":"Desk Lamp"}},
            {"do":"click","actor":"owner-fresh","testid":"credit-link","unlessVisible":"credit-panel"},
            {"do":"expect","actor":"owner-fresh","testid":"credit-panel","attribute":"aria-busy","value":"false","within":10000},
            {"do":"expectNumber","actor":"owner-fresh","testid":"credit-balance","equals":0}
          ]
        }
      ]
    },
