{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 1,
  "name": "Purchasing and orders",
  "features": [
    {
      "id": 3,
      "name": "Purchase order history",
      "actors": ["buyer"],
      "setup": [
        { "do": "signUp", "actor": "buyer", "name": "purchase-buyer" }
      ],
      "criteria": [
        {
          "id": "3c",
          "desc": "the purchase is recorded in the buyer's order history at the price paid",
          "points": 1,
          "statedBy": "A purchase creates an order for the customer at the price paid.",
          "steps": [
            { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Coffee Grinder" } },
            { "do": "click", "actor": "buyer", "testid": "orders-toggle" },
            { "do": "expect", "actor": "buyer", "testid": "order-item", "contains": "Coffee Grinder" },
            { "do": "expectNumber", "actor": "buyer", "testid": "order-total", "in": { "testid": "order-item", "contains": "Coffee Grinder" }, "equals": 64 }
          ]
        }
      ]
    }
  ]
}
