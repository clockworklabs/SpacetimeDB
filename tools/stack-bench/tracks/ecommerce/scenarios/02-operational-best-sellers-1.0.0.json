{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Ecommerce L2 signed-out best sellers",
  "note": "This scenario owns only the signed-out recommendation check.",
  "features": [
    {
      "id": 5,
      "name": "Signed-out best sellers",
      "actors": ["buyer", "visitor"],
      "setup": [
        { "do": "signUp", "actor": "buyer", "name": "best-seller-buyer" },
        { "do": "fill", "actor": "buyer", "testid": "search-input", "text": "Webcam", "enter": true, "settleMs": 1500 },
        { "do": "click", "actor": "buyer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Webcam" } },
        { "do": "click", "actor": "buyer", "testid": "orders-toggle" },
        { "do": "expect", "actor": "buyer", "testid": "order-item", "contains": "Webcam", "within": 10000 }
      ],
      "criteria": [
        {
          "id": "5d",
          "desc": "a signed-out visitor sees a best seller in the recommendations list",
          "points": 1,
          "statedBy": "Signed-out visitors see best sellers",
          "steps": [
            { "do": "reload", "actor": "visitor", "settleMs": 2500 },
            { "do": "expect", "actor": "visitor", "testid": "recommended-item", "contains": "Webcam", "within": 10000 }
          ]
        }
      ]
    }
  ]
}
