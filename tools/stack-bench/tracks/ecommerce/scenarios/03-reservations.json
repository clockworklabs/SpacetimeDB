{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Reservations",
  "note": "Each check creates its own account and reservation.",
  "features": [
    {
      "id": 301,
      "name": "A cart reserves stock",
      "actors": ["shopper", "watcher"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "reserve-stock" },
        { "do": "recordNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "as": "before" }
      ],
      "criteria": [{
        "id": "301a",
        "desc": "adding an item reserves one unit for every open viewer",
        "points": 2,
        "statedBy": "Adding an item to a cart reserves its stock immediately for 90 seconds.",
        "steps": [
          { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
          { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "relativeTo": "before", "plus": -1, "within": 10000 }
        ]
      }]
    },
    {
      "id": 305,
      "name": "Reservation time is visible",
      "actors": ["shopper"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "reserve-clock" },
        { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Gaming Mouse" } },
        { "do": "click", "actor": "shopper", "testid": "cart-toggle" }
      ],
      "criteria": [{
        "id": "305a",
        "desc": "the reservation timer decreases",
        "points": 1,
        "statedBy": "The cart shows the remaining reservation time.",
        "steps": [
          { "do": "expectNumber", "actor": "shopper", "testid": "cart-reservation-timer", "in": { "testid": "cart-item", "contains": "Gaming Mouse" }, "atLeast": 80 },
          { "do": "wait", "actor": "shopper", "ms": 15000 },
          { "do": "expectNumber", "actor": "shopper", "testid": "cart-reservation-timer", "in": { "testid": "cart-item", "contains": "Gaming Mouse" }, "atMost": 75 }
        ]
      }]
    },
    {
      "id": 306,
      "name": "Checkout consumes a reservation",
      "actors": ["shopper"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "reserve-checkout" },
        { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Keyboard" } },
        { "do": "click", "actor": "shopper", "testid": "cart-toggle" }
      ],
      "criteria": [{
        "id": "306a",
        "desc": "checkout converts the reservation into an order and empties the cart",
        "points": 2,
        "statedBy": "Checkout converts a live reservation into a sale.",
        "steps": [
          { "do": "click", "actor": "shopper", "testid": "checkout-submit" },
          { "do": "expectNumber", "actor": "shopper", "testid": "cart-count", "equals": 0, "within": 10000 },
          { "do": "click", "actor": "shopper", "testid": "orders-toggle" },
          { "do": "expect", "actor": "shopper", "testid": "order-item", "contains": "Keyboard", "count": 1 }
        ]
      }]
    },
    {
      "id": 307,
      "name": "A reservation expires",
      "actors": ["shopper"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "reserve-expiry" },
        { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Bluetooth Speaker" } },
        { "do": "click", "actor": "shopper", "testid": "cart-toggle" }
      ],
      "criteria": [{
        "id": "307a",
        "desc": "an expired reservation marks its cart line",
        "points": 3,
        "statedBy": "An expired reservation remains visible as expired.",
        "steps": [
          { "do": "wait", "actor": "shopper", "ms": 100000 },
          { "do": "expect", "actor": "shopper", "testid": "cart-item-expired", "in": { "testid": "cart-item", "contains": "Bluetooth Speaker" }, "within": 15000 }
        ]
      }]
    },
    {
      "id": 308,
      "name": "Changing quantity renews a reservation",
      "actors": ["shopper"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "reserve-renew" },
        { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Headphones" } },
        { "do": "wait", "actor": "shopper", "ms": 60000 },
        { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Headphones" } },
        { "do": "click", "actor": "shopper", "testid": "cart-toggle" }
      ],
      "criteria": [{
        "id": "308a",
        "desc": "raising quantity starts a new reservation window",
        "points": 2,
        "statedBy": "Adding the item again renews the reservation.",
        "steps": [
          { "do": "wait", "actor": "shopper", "ms": 40000 },
          { "do": "expectNumber", "actor": "shopper", "testid": "cart-reservation-timer", "in": { "testid": "cart-item", "contains": "Headphones" }, "atLeast": 35 },
          { "do": "expect", "actor": "shopper", "testid": "cart-item-expired", "in": { "testid": "cart-item", "contains": "Headphones" }, "absent": true }
        ]
      }]
    }
  ]
}
