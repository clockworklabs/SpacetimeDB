{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Support triage",
  "features": [
    {
      "id": 611,
      "name": "Support triage",
      "actors": [
        "visitor",
        "staff"
      ],
      "setup": [
        {
          "do": "click",
          "actor": "visitor",
          "testid": "support-link"
        },
        {
          "do": "fill",
          "actor": "visitor",
          "testid": "support-email",
          "text": "triage@example.com"
        },
        {
          "do": "fill",
          "actor": "visitor",
          "testid": "support-subject",
          "text": "Missing item"
        },
        {
          "do": "fill",
          "actor": "visitor",
          "testid": "support-message",
          "text": "One item is missing."
        },
        {
          "do": "click",
          "actor": "visitor",
          "testid": "support-submit"
        },
        {
          "do": "expect",
          "actor": "visitor",
          "testid": "support-reference",
          "nonEmpty": true
        },
        {
          "do": "signIn",
          "actor": "staff",
          "name": "staff",
          "password": "stackbench-staff-2026",
          "exact": true
        },
        {
          "do": "click",
          "actor": "staff",
          "testid": "staff-link"
        }
      ],
      "criteria": [
        {
          "id": "611a",
          "desc": "staff can assign a new ticket",
          "points": 1,
          "statedBy": "Staff can assign support tickets.",
          "steps": [
            {
              "do": "fill",
              "actor": "staff",
              "testid": "support-assignee",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              },
              "text": "staff"
            },
            {
              "do": "click",
              "actor": "staff",
              "testid": "support-update",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              }
            },
            {
              "do": "reload",
              "actor": "staff",
              "settleMs": 2500
            },
            {
              "do": "click",
              "actor": "staff",
              "testid": "staff-link"
            },
            {
              "do": "expect",
              "actor": "staff",
              "testid": "support-assignee",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              },
              "value": "staff"
            }
          ]
        },
        {
          "id": "611b",
          "desc": "staff can set a ticket priority",
          "points": 1,
          "statedBy": "Staff can set support ticket priority.",
          "steps": [
            {
              "do": "fill",
              "actor": "staff",
              "testid": "support-priority",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              },
              "text": "high"
            },
            {
              "do": "click",
              "actor": "staff",
              "testid": "support-update",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              }
            },
            {
              "do": "reload",
              "actor": "staff",
              "settleMs": 2500
            },
            {
              "do": "click",
              "actor": "staff",
              "testid": "staff-link"
            },
            {
              "do": "expect",
              "actor": "staff",
              "testid": "support-priority",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              },
              "value": "high"
            }
          ]
        },
        {
          "id": "611c",
          "desc": "staff can change a ticket status",
          "points": 1,
          "statedBy": "Staff can change support ticket status.",
          "steps": [
            {
              "do": "fill",
              "actor": "staff",
              "testid": "support-status-input",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              },
              "text": "in progress"
            },
            {
              "do": "click",
              "actor": "staff",
              "testid": "support-update",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              }
            },
            {
              "do": "expect",
              "actor": "staff",
              "testid": "support-status",
              "in": {
                "testid": "support-ticket",
                "contains": "Missing item"
              },
              "contains": "in progress"
            }
          ]
        }
      ]
    }
  ]
}
