{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 5,
  "name": "Stock alert delivery after a direct stock write",
  "features": [
    {
      "id": 631,
      "name": "Stock alert delivery after a direct stock write",
      "actors": ["subscriber"],
      "setup": [
        {"do":"signUp","actor":"subscriber","name":"stock-subscriber"},
        { "do": "click", "actor": "subscriber", "testid": "overlay-close", "ifAvailable": true, "within": 1000 },
        { "do": "click", "actor": "subscriber", "testid": "catalog-link", "ifAvailable": true, "unlessVisible": "item-list" },
        {"do": "click", "actor": "subscriber", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["notification-settings", "notification-order"]},
        {"do":"click","actor":"subscriber","testid":"notification-settings","unlessVisible":"notification-order"},
        {"do":"click","actor":"subscriber","testid":"notification-stock"},
        {"do":"expect","actor":"subscriber","testid":"notification-stock","attribute":"data-state","value":"on"},
        {"do":"click","actor":"subscriber","testid":"notification-save"},
        {"do":"expect","actor":"subscriber","testid":"notification-save-state","attribute":"data-submit-state","value":"succeeded","within":10000},
        {"do":"click","actor":"subscriber","testid":"overlay-close","ifAvailable":true},
        {"do":"click","actor":"subscriber","testid":"catalog-link","ifAvailable":true},
        {"do":"dbSetStock","item":"Air Purifier","warehouse":"East","quantity":0,"settleMs":1000},
        {"do":"dbSetStock","item":"Air Purifier","warehouse":"West","quantity":0,"settleMs":1000},
        {"do":"reload","actor":"subscriber","settleMs":1000},
        {"do":"ensureSignedIn","actor":"subscriber","name":"stock-subscriber","readyTestid":"current-user"},
        { "do": "click", "actor": "subscriber", "testid": "catalog-link", "ifAvailable": true, "unlessVisible": "item-list" },
        {"do":"click","actor":"subscriber","testid":"stock-alert","in":{"testid":"item-card","contains":"Air Purifier"}},
        {"do":"expect","actor":"subscriber","testid":"item-card","contains":"Air Purifier","attribute":"data-submit-state","value":"succeeded","within":10000}
      ],
      "criteria": [
        {
          "id": "631d",
          "category": "production",
          "desc": "stock restored by a direct database write sends the requested alert",
          "points": 1,
          "statedBy": "A stock request creates an alert when stock returns, including stock written outside the application.",
          "steps": [
            {"do":"freshClient","actor":"subscriber"},
            {"do":"signIn","actor":"subscriber-fresh","name":"stock-subscriber"},
            {"do":"click","actor":"subscriber-fresh","testid":"catalog-link","ifAvailable":true,"unlessVisible":["notifications-panel","notifications-toggle","notification-settings"]},
            {"do": "click", "actor": "subscriber-fresh", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["notification-settings", "notifications-panel", "notifications-toggle"]},
            {"do":"click","actor":"subscriber-fresh","testid":"notification-settings","ifAvailable":true,"unlessVisible":["notifications-panel","notifications-toggle"]},
            {"do": "click", "actor": "subscriber-fresh", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["notifications-toggle", "notifications-panel"]},
            {"do":"click","actor":"subscriber-fresh","testid":"notifications-toggle","unlessVisible":"notifications-panel"},
            {"do":"expect","actor":"subscriber-fresh","testid":"notifications-panel","attribute":"aria-busy","value":"false","within":10000},
            {"do":"expectElementCount","actor":"subscriber-fresh","testid":"stock-alert-delivery","contains":"Air Purifier","equals":0},
            {"do":"dbSetStock","item":"Air Purifier","warehouse":"East","quantity":1,"settleMs":0},
            {"do":"wait","actor":"subscriber","ms":10000},
            {"do":"freshClient","actor":"subscriber"},
            {"do":"signIn","actor":"subscriber-fresh","name":"stock-subscriber"},
            {"do":"click","actor":"subscriber-fresh","testid":"catalog-link","ifAvailable":true,"unlessVisible":["notifications-panel","notifications-toggle","notification-settings"]},
            {"do": "click", "actor": "subscriber-fresh", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["notification-settings", "notifications-panel", "notifications-toggle"]},
            {"do":"click","actor":"subscriber-fresh","testid":"notification-settings","ifAvailable":true,"unlessVisible":["notifications-panel","notifications-toggle"]},
            {"do": "click", "actor": "subscriber-fresh", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["notifications-toggle", "notifications-panel"]},
            {"do":"click","actor":"subscriber-fresh","testid":"notifications-toggle","unlessVisible":"notifications-panel"},
            {"do":"expect","actor":"subscriber-fresh","testid":"notifications-panel","attribute":"aria-busy","value":"false","within":10000},
            {"do":"expect","actor":"subscriber-fresh","testid":"stock-alert-delivery","contains":"Air Purifier","within":10000}
          ]
        }
      ]
    }
  ]
}
