{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 4,
  "name": "Personalized recommendations",
  "features": [
    {
      "id": 403,
      "name": "Recommendations use customer activity",
      "actors": ["sales-helper", "audio-customer", "home-customer", "computing-customer"],
      "setup": [
        { "do": "signUp", "actor": "sales-helper", "name": "recommend-sales" },
        { "do": "click", "actor": "sales-helper", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "settleMs": 500 },
        { "do": "click", "actor": "sales-helper", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "settleMs": 500 },
        { "do": "click", "actor": "sales-helper", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "settleMs": 500 },
        { "do": "signUp", "actor": "audio-customer", "name": "recommend-audio" },
        { "do": "click", "actor": "audio-customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Bluetooth Speaker" } },
        { "do": "signUp", "actor": "home-customer", "name": "recommend-home" },
        { "do": "click", "actor": "home-customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Coffee Grinder" } },
        { "do": "signUp", "actor": "computing-customer", "name": "recommend-computing" },
        { "do": "click", "actor": "computing-customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } }
      ],
      "criteria": [
        {
          "id": "403a",
          "desc": "recommendations follow the customer's categories, global sales, and name tie-break",
          "points": 4,
          "statedBy": "Order the remaining items by global units sold, highest first, then by item name.",
          "steps": [
            { "do": "expect", "actor": "audio-customer", "testid": "recommended-item", "in": { "testid": "recommendations" }, "contains": "Headphones" },
            { "do": "expectNumber", "actor": "home-customer", "testid": "recommendation-rank", "in": { "testid": "recommended-item", "contains": "Desk Lamp" }, "equals": 1, "within": 10000 },
            { "do": "expectSequence", "actor": "computing-customer", "testid": "recommended-item", "in": { "testid": "recommendations" }, "equals": ["Gaming Mouse", "Laptop Stand", "Webcam"], "within": 10000 }
          ]
        },
        {
          "id": "403b",
          "desc": "one customer's activity does not replace another customer's recommendations",
          "points": 2,
          "statedBy": "Customer recommendation profiles are isolated.",
          "steps": [
            { "do": "click", "actor": "audio-customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Headphones" } },
            { "do": "expect", "actor": "audio-customer", "testid": "recommended-item", "in": { "testid": "recommendations" }, "contains": "Headphones", "absent": true },
            { "do": "expectNumber", "actor": "home-customer", "testid": "recommendation-rank", "in": { "testid": "recommended-item", "contains": "Desk Lamp" }, "equals": 1, "within": 10000 },
            { "do": "expectSequence", "actor": "computing-customer", "testid": "recommended-item", "in": { "testid": "recommendations" }, "equals": ["Gaming Mouse", "Laptop Stand", "Webcam"], "within": 10000 }
          ]
        }
      ]
    }
  ]
}
