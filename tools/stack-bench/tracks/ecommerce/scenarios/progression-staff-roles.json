{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Staff roles",
  "features": [
    {
      "id": 621,
      "name": "Staff roles",
      "actors": ["admin", "replayAdmin", "staff"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "expect", "actor": "admin", "testid": "admin-link", "within": 6000 },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "fill", "actor": "admin", "testid": "staff-role-select", "in": { "testid": "staff-role-row", "contains": "staff" }, "text": "inventory" },
        { "do": "click", "actor": "admin", "testid": "staff-role-save", "in": { "testid": "staff-role-row", "contains": "staff" } }
      ],
      "criteria": [
        {
          "id": "621c",
          "desc": "an administrator can assign a staff role",
          "points": 1,
          "statedBy": "An administrator can assign a role to an existing staff account.",
          "steps": [
            { "do": "expect", "actor": "admin", "testid": "staff-role-select", "in": { "testid": "staff-role-row", "contains": "staff" }, "value": "inventory", "within": 10000 }
          ]
        },
        {
          "id": "621a",
          "desc": "an assigned staff role survives a reload",
          "points": 2,
          "statedBy": "Assigned staff roles persist.",
          "steps": [
            { "do": "reload", "actor": "admin", "settleMs": 2500 },
            { "do": "expect", "actor": "admin", "testid": "admin-link", "within": 6000 },
            { "do": "click", "actor": "admin", "testid": "admin-link" },
            { "do": "expect", "actor": "admin", "testid": "staff-role-select", "in": { "testid": "staff-role-row", "contains": "staff" }, "value": "inventory", "within": 10000 }
          ]
        },
        {
          "id": "621b",
          "desc": "a staff member cannot assign roles through the UI or a replayed request",
          "points": 2,
          "statedBy": "A staff member cannot assign or change roles.",
          "steps": [
            { "do": "signIn", "actor": "replayAdmin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
            { "do": "expect", "actor": "replayAdmin", "testid": "admin-link", "within": 6000 },
            { "do": "click", "actor": "replayAdmin", "testid": "admin-link" },
            { "do": "fill", "actor": "replayAdmin", "testid": "staff-role-select", "in": { "testid": "staff-role-row", "contains": "staff" }, "text": "inventory" },
            { "do": "click", "actor": "replayAdmin", "testid": "staff-role-save", "in": { "testid": "staff-role-row", "contains": "staff" } },
            { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
            { "do": "click", "actor": "staff", "testid": "staff-link" },
            { "do": "expect", "actor": "staff", "testid": "staff-role-save", "absent": true },
            { "do": "replayAs", "actor": "staff", "from": "replayAdmin", "match": "role", "namedAction": { "id": "assignStaffRole", "path": "/api/staff/:id/role", "method": "PUT", "reducer": "assign_staff_role", "args": [0, "inventory"], "params": [{ "name": "accountId", "in": "path", "placeholder": ":id", "wireType": "u64" }, { "name": "role", "in": "body" }] }, "namedTarget": { "testid": "staff-role-row", "contains": "staff", "attribute": "data-account-id", "valueType": "number" }, "settleMs": 1500 },
            { "do": "expectReplayRejected", "actor": "staff" }
          ]
        }
      ]
    }
  ]
}
