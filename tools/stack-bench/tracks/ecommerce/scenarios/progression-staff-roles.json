{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Staff roles",
  "note": "Draft: revised role-revocation control requires matching pristine and defect qualification before verified comparisons.",
  "features": [
    {
      "id": 621,
      "name": "Staff roles",
      "actors": ["admin", "replayAdmin", "staff", "roleAdmin", "promotedStaff"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "expect", "actor": "admin", "testid": "admin-link", "within": 6000 },
        { "do": "click", "actor": "admin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff" },
        { "do": "fill", "actor": "admin", "testid": "staff-role-select", "in": { "testid": "staff-role-account-staff" }, "text": "inventory" },
        { "do": "click", "actor": "admin", "testid": "staff-role-save", "in": { "testid": "staff-role-account-staff" } }
      ],
      "criteria": [
        {
          "id": "621c",
          "category": "feature",
          "desc": "an administrator can assign a staff role",
          "points": 1,
          "statedBy": "An administrator can assign a role to an existing staff account.",
          "steps": [
            { "do": "expect", "actor": "admin", "testid": "staff-role-select", "in": { "testid": "staff-role-account-staff" }, "value": "inventory", "within": 10000 }
          ]
        },
        {
          "id": "621a",
          "category": "production",
          "desc": "an assigned staff role survives reload and backend restart in a fresh browser",
          "points": 2,
          "statedBy": "Assigned staff roles persist.",
          "steps": [
            { "do": "reload", "actor": "admin", "settleMs": 2500 },
            { "do": "ensureSignedIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "admin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff", "ifAvailable": true },
            { "do": "expect", "actor": "admin", "testid": "staff-role-select", "in": { "testid": "staff-role-account-staff" }, "value": "inventory", "within": 10000 },
            { "do": "restartBackend", "settleMs": 1000 },
            { "do": "freshClient", "actor": "admin" },
            { "do": "signIn", "actor": "admin-fresh", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
            { "do": "click", "actor": "admin-fresh", "testid": "admin-link", "unlessVisible": "staff-role-account-staff" },
            { "do": "expect", "actor": "admin-fresh", "testid": "staff-role-select", "in": { "testid": "staff-role-account-staff" }, "value": "inventory", "within": 10000 }
          ]
        },
        {
          "id": "621b",
          "category": "production",
          "desc": "a staff member cannot assign roles through the UI or a replayed request",
          "points": 2,
          "statedBy": "A staff member cannot assign or change roles.",
          "steps": [
            { "do": "signIn", "actor": "replayAdmin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
            { "do": "expect", "actor": "replayAdmin", "testid": "admin-link", "within": 6000 },
            { "do": "click", "actor": "replayAdmin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff" },
            { "do": "expect", "actor": "replayAdmin", "testid": "staff-role-select", "in": { "testid": "staff-role-account-staff" }, "value": "inventory", "within": 10000 },
            { "do": "fill", "actor": "replayAdmin", "testid": "staff-role-select", "in": { "testid": "staff-role-account-staff" }, "text": "staff" },
            { "do": "click", "actor": "replayAdmin", "testid": "staff-role-save", "in": { "testid": "staff-role-account-staff" } },
            { "do": "reload", "actor": "replayAdmin", "settleMs": 1000 },
            { "do": "ensureSignedIn", "actor": "replayAdmin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "replayAdmin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff", "ifAvailable": true },
            { "do": "expect", "actor": "replayAdmin", "testid": "staff-role-select", "in": { "testid": "staff-role-account-staff" }, "value": "staff", "within": 10000 },
            { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
            { "do": "click", "actor": "staff", "testid": "staff-link", "ifAvailable": true },
            { "do": "expect", "actor": "staff", "testid": "staff-role-save", "absent": true },
            { "do": "replayAs", "actor": "staff", "from": "replayAdmin", "match": "role", "swap": { "find": "\"role\":\"staff\"", "with": "\"role\":\"inventory\"" }, "namedAction": { "id": "assignStaffRole", "path": "/api/staff/:id/role", "method": "PUT", "reducer": "assign_staff_role", "args": [0, "inventory"], "params": [{ "name": "accountId", "in": "path", "placeholder": ":id", "wireType": "u64" }, { "name": "role", "in": "body" }] }, "namedTarget": { "testid": "staff-role-account-staff", "attribute": "data-account-id", "valueType": "string" }, "settleMs": 1500 },
            { "do": "expectReplayRejected", "actor": "staff" },
            { "do": "reload", "actor": "replayAdmin", "settleMs": 1000 },
            { "do": "ensureSignedIn", "actor": "replayAdmin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "replayAdmin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff", "ifAvailable": true },
            { "do": "expect", "actor": "replayAdmin", "testid": "staff-role-select", "in": { "testid": "staff-role-account-staff" }, "value": "staff", "within": 10000 }
          ]
        },
        {
          "id": "621d",
          "category": "production",
          "desc": "removing administrator access blocks a previously authorized session without changing the target role",
          "points": 2,
          "statedBy": "Only the admin role grants administrator access.",
          "steps": [
            {"do": "signIn", "actor": "roleAdmin", "name": "admin", "password": "stackbench-admin-2026", "exact": true},
            {"do": "click", "actor": "roleAdmin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff"},
            {"do": "replayAs", "actor": "roleAdmin", "from": "roleAdmin", "match": "__role-revocation-named-action__", "namedAction": {"id": "assignStaffRole", "path": "/api/staff/:id/role", "method": "PUT", "reducer": "assign_staff_role", "args": [0, "admin"], "params": [{"name": "accountId", "in": "path", "placeholder": ":id", "wireType": "u64"}, {"name": "role", "in": "body"}]}, "namedTarget": {"testid": "staff-role-account-staff", "attribute": "data-account-id", "valueType": "string"}, "settleMs": 0},
            {"do": "expectReplayCompleted", "actor": "roleAdmin", "requireAccepted": true},
            {"do": "reload", "actor": "roleAdmin", "settleMs": 0},
            {"do": "ensureSignedIn", "actor": "roleAdmin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user"},
            {"do": "click", "actor": "roleAdmin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff", "ifAvailable": true},
            {"do": "expect", "actor": "roleAdmin", "testid": "staff-role-select", "in": {"testid": "staff-role-account-staff"}, "value": "admin", "within": 10000},
            {"do": "signIn", "actor": "promotedStaff", "name": "staff", "password": "stackbench-staff-2026", "exact": true},
            {"do": "replayAs", "actor": "promotedStaff", "from": "roleAdmin", "match": "__role-revocation-named-action__", "namedAction": {"id": "assignStaffRole", "path": "/api/staff/:id/role", "method": "PUT", "reducer": "assign_staff_role", "args": [0, "admin"], "params": [{"name": "accountId", "in": "path", "placeholder": ":id", "wireType": "u64"}, {"name": "role", "in": "body"}]}, "namedTarget": {"testid": "staff-role-account-staff", "attribute": "data-account-id", "valueType": "string"}, "settleMs": 0},
            {"do": "expectReplayCompleted", "actor": "promotedStaff", "requireAccepted": true},
            {"do": "replayAs", "actor": "roleAdmin", "from": "roleAdmin", "match": "__role-revocation-named-action__", "namedAction": {"id": "assignStaffRole", "path": "/api/staff/:id/role", "method": "PUT", "reducer": "assign_staff_role", "args": [0, "staff"], "params": [{"name": "accountId", "in": "path", "placeholder": ":id", "wireType": "u64"}, {"name": "role", "in": "body"}]}, "namedTarget": {"testid": "staff-role-account-staff", "attribute": "data-account-id", "valueType": "string"}, "settleMs": 0},
            {"do": "expectReplayCompleted", "actor": "roleAdmin", "requireAccepted": true},
            {"do": "reload", "actor": "roleAdmin", "settleMs": 0},
            {"do": "ensureSignedIn", "actor": "roleAdmin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user"},
            {"do": "click", "actor": "roleAdmin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff", "ifAvailable": true},
            {"do": "expect", "actor": "roleAdmin", "testid": "staff-role-select", "in": {"testid": "staff-role-account-staff"}, "value": "staff", "within": 10000},
            {"do": "replayAs", "actor": "promotedStaff", "from": "roleAdmin", "match": "__role-revocation-named-action__", "namedAction": {"id": "assignStaffRole", "path": "/api/staff/:id/role", "method": "PUT", "reducer": "assign_staff_role", "args": [0, "admin"], "params": [{"name": "accountId", "in": "path", "placeholder": ":id", "wireType": "u64"}, {"name": "role", "in": "body"}]}, "namedTarget": {"testid": "staff-role-account-staff", "attribute": "data-account-id", "valueType": "string"}, "settleMs": 0},
            {"do": "expectReplayRejected", "actor": "promotedStaff"},
            {"do": "reload", "actor": "roleAdmin", "settleMs": 0},
            {"do": "ensureSignedIn", "actor": "roleAdmin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user"},
            {"do": "click", "actor": "roleAdmin", "testid": "admin-link", "unlessVisible": "staff-role-account-staff", "ifAvailable": true},
            {"do": "expect", "actor": "roleAdmin", "testid": "staff-role-select", "in": {"testid": "staff-role-account-staff"}, "value": "staff", "within": 10000}
          ]
        }
      ]
    }
  ]
}
