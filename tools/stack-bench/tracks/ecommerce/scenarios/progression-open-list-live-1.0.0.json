{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 1,
  "name": "Progression open review list",
  "features": [
    {
      "id": 902,
      "name": "An open list stays current",
      "actors": ["reader", "reviewer"],
      "setup": [
        { "do": "signUp", "actor": "reviewer", "name": "raceR" },
        { "do": "signUp", "actor": "reader", "name": "raceL" },
        { "do": "recordNumber", "actor": "reviewer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "as": "keyboard-before-review-purchase" },
        { "do": "click", "actor": "reviewer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } },
        { "do": "expectNumber", "actor": "reviewer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "relativeTo": "keyboard-before-review-purchase", "plus": -1, "within": 10000 },
        { "do": "click", "actor": "reviewer", "testid": "item-name", "in": { "testid": "item-card", "contains": "Keyboard" } },
        { "do": "expect", "actor": "reviewer", "testid": "item-detail", "within": 10000 },
        { "do": "fill", "actor": "reviewer", "testid": "review-rating", "text": "5" }
      ],
      "criteria": [
        {
          "id": "902a",
          "desc": "one customer has the Keyboard's reviews open before another posts one; the already-open view shows that review exactly once",
          "points": 1,
          "statedBy": "A view opened while a review is submitted converges to the current review list.",
          "steps": [
            { "do": "click", "actor": "reader", "testid": "item-name", "in": { "testid": "item-card", "contains": "Keyboard" } },
            { "do": "expect", "actor": "reader", "testid": "item-detail", "within": 10000 },
            { "do": "fill", "actor": "reviewer", "testid": "review-input", "text": "live-review-kbd" },
            { "do": "click", "actor": "reviewer", "testid": "review-submit" },
            { "do": "expectElementCount", "actor": "reviewer", "testid": "review-item", "contains": "live-review-kbd", "equals": 1, "within": 10000 },
            { "do": "expectElementCount", "actor": "reader", "testid": "review-item", "contains": "live-review-kbd", "equals": 1, "within": 10000 }
          ]
        }
      ]
    }
  ]
}
