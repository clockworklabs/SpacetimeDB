{
  "schemaVersion": 1,
  "level": 1,
  "track": "ecommerce",
  "name": "Storefront and warehouse — restock during purchases",
  "writeUrlPattern": "\\/api\\/|\\/items|\\/cart|\\/orders|\\/checkout|\\/buy|\\/reviews|\\/stock|\\/restock|\\/warehouses",
  "note": "Draft: matching reference and mutation qualification is pending. An ordinary purchase and restock are setup prerequisites. The race checks stored total stock, each buyer order, and UI agreement. Concurrent client dispatch does not prove overlapping server execution.",
  "features": [
    {
      "id": 202,
      "name": "A restock during a rush is not lost",
      "actors": [
        "admin",
        "a",
        "b",
        "c"
      ],
      "setup": [
        {
          "do": "signIn",
          "actor": "admin",
          "name": "admin",
          "password": "stackbench-admin-2026",
          "exact": true
        },
        {
          "do": "click",
          "actor": "admin",
          "testid": "admin-link"
        },
        {
          "do": "signUp",
          "actor": "a",
          "name": "r1"
        },
        {
          "do": "signUp",
          "actor": "b",
          "name": "r2"
        },
        {
          "do": "signUp",
          "actor": "c",
          "name": "r3"
        },
        {
          "do": "dbRecordStock",
          "item": "Bluetooth Speaker",
          "as": "stored-before-serial-purchase"
        },
        {
          "do": "click",
          "actor": "a",
          "testid": "buy-now",
          "in": {
            "testid": "item-card",
            "contains": "Bluetooth Speaker"
          }
        },
        {
          "do": "click",
          "actor": "a",
          "testid": "orders-toggle",
          "unlessVisible": "order-item"
        },
        {
          "do": "expect",
          "actor": "a",
          "testid": "order-item",
          "contains": "Bluetooth Speaker",
          "count": 1,
          "within": 10000
        },
        {
          "do": "dbExpectStock",
          "item": "Bluetooth Speaker",
          "relativeTo": "stored-before-serial-purchase",
          "plus": -1
        },
        {
          "do": "reload",
          "actor": "a",
          "settleMs": 1000
        },
        {
          "do": "ensureSignedIn",
          "actor": "a",
          "name": "r1",
          "readyTestid": "current-user"
        },
        {
          "do": "expectNumber",
          "actor": "admin",
          "testid": "admin-stock",
          "in": {
            "testid": "admin-item-row",
            "contains": "Bluetooth Speaker"
          },
          "relativeTo": "stored-before-serial-purchase",
          "plus": -1,
          "within": 10000
