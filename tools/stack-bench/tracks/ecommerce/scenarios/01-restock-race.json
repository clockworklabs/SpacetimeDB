          "do": "expectNumber",
          "actor": "a",
          "testid": "item-stock",
          "in": {
            "testid": "item-card",
            "contains": "Bluetooth Speaker"
          },
          "relativeTo": "storefront-before",
          "plus": 5,
          "within": 8000
        },
        {
          "do": "dbExpectStock",
          "item": "Bluetooth Speaker",
          "relativeTo": "stored-before-control",
          "plus": 5
