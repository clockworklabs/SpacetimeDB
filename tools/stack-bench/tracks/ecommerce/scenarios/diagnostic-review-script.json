        {"do":"expect","actor":"reader-fresh","testid":"review-item","contains":"Benign stored review","within":10000},
        {"do":"wait","actor":"reader-fresh","ms":1000},
        {"do":"expectNoScriptExecution","actor":"reader-fresh"}
      ]
