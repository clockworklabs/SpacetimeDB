{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Live review rating",
  "note": "This scenario uses two different customers and does not depend on the outcome of the separate repeat-submission check.",
  "features": [
    {
      "id": 6,
      "name": "Reviews",
      "actors": ["author", "other"],
      "setup": [
        { "do": "signUp", "actor": "author", "name": "leon" },
        { "do": "signUp", "actor": "other", "name": "maya" },
        { "do": "callAction", "actor": "author", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] }, "input": { "testid": "item-card", "contains": "Gaming Mouse", "attribute": "data-buy-input" } },

        { "do": "expectActionOutcome", "actor": "author", "outcome": "accepted" },
        {"do":"click","actor":"author","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
        { "do": "click", "actor": "author", "testid": "orders-toggle", "unlessVisible": "order-item" },
        { "do": "expect", "actor": "author", "testid": "order-item", "contains": "Gaming Mouse", "within": 10000 },
        { "do": "click", "actor": "author", "testid": "overlay-close", "ifAvailable": true },
        { "do": "click", "actor": "author", "testid": "catalog-link", "ifAvailable": true },
        { "do": "openItem", "actor": "author", "item": "Gaming Mouse" },
        {"do":"click","actor":"author","testid":"review-toggle","unlessVisible":"review-rating","ifAvailable":true},
        { "do": "fill", "actor": "author", "testid": "review-rating", "text": "2" },
        { "do": "fill", "actor": "author", "testid": "review-input", "text": "works for travel" },
        { "do": "click", "actor": "author", "testid": "review-submit" },
        { "do": "expect", "actor": "author", "testid": "review-item", "contains": "works for travel" },
        { "do": "callAction", "actor": "other", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] }, "input": { "testid": "item-card", "contains": "Gaming Mouse", "attribute": "data-buy-input" } },

        { "do": "expectActionOutcome", "actor": "other", "outcome": "accepted" },
        {"do":"click","actor":"other","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
        { "do": "click", "actor": "other", "testid": "orders-toggle", "unlessVisible": "order-item" },
        { "do": "expect", "actor": "other", "testid": "order-item", "contains": "Gaming Mouse", "within": 10000 },
        { "do": "click", "actor": "other", "testid": "overlay-close", "ifAvailable": true },
        { "do": "click", "actor": "other", "testid": "catalog-link", "ifAvailable": true }
      ],
      "criteria": [
        {
          "id": "6c",
          "category": "production",
          "desc": "the average rating reflects both reviewers and updates live",
          "points": 1,
          "steps": [
            { "do": "openItem", "actor": "other", "item": "Gaming Mouse" },
            {"do":"click","actor":"other","testid":"review-toggle","unlessVisible":"review-rating","ifAvailable":true},
            { "do": "fill", "actor": "other", "testid": "review-rating", "text": "4" },
            { "do": "fill", "actor": "other", "testid": "review-input", "text": "does the job" },
            { "do": "click", "actor": "other", "testid": "review-submit" },
            { "do": "expectNumber", "actor": "other", "testid": "review-average", "equals": 3, "within": 10000 },
            { "do": "expectAgreement", "actors": ["author", "other"], "testid": "review-average", "numeric": true, "within": 10000 }
          ],
          "statedBy": "each item shows its average rating, which updates live as reviews arrive"
        }
      ]
    }
  ]
}
