{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Cancellation contention diagnostic",
  "note": "Draft reference diagnostic; not selected by scored campaigns. Widths 1/4/16/64, three fresh-account cohorts each, over two sessions of one account. Client dispatch overlap is not proof of server execution overlap. Each paid non-credit order is verified before cancellation. Repeated calls may refuse or succeed without extra effects. Reconcile warehouse allocations, cancelled status, preserved records and fresh revenue. Payment rows remain history in these references; this does not qualify payment-provider refunds or account-credit reversal. Reference-only readers require exact schema mapping. Preserve unknown request outcomes; they cannot pass. Qualification pending.",
  "features": [
    {"id":9100,"name":"1 concurrent cancellation requests, cohort 1","actors":["a","b","admin"],
      "setup":[
        {"do":"signIn","actor":"admin","name":"admin","password":"stackbench-admin-2026","exact":true},
        {"do":"click","actor":"admin","testid":"admin-link"},
        {"do":"recordNumber","actor":"admin","testid":"admin-revenue","as":"revenue-before"},
        {"do":"signUp","actor":"a","name":"cancel-1-1"},
        {"do":"signIn","actor":"b","name":"cancel-1-1"},
        {"do":"dbRecordCheckout","account":"{user:cancel-1-1}","item":"Keyboard","as":"checkout-before"},
        {"do":"click","actor":"a","testid":"add-to-cart","in":{"testid":"item-card","contains":"Keyboard"}},
        {"do":"click","actor":"a","testid":"cart-toggle","unlessVisible":"cart-total"},
        {"do":"expectNumber","actor":"a","testid":"cart-quantity","in":{"testid":"cart-item","contains":"Keyboard"},"equals":1,"within":10000},
        {"do":"dbRecordCheckout","account":"{user:cancel-1-1}","item":"Keyboard","as":"checkout-prepared"},
        {"do":"callAction","actor":"a","action":"checkout","namedAction":{"id":"checkout","path":"/api/checkout","reducer":"checkout","args":[]},"settleMs":1000},
        {"do":"dbExpectCheckout","before":"checkout-before","prepared":"checkout-prepared","quantity":1},
        {"do":"dbRecordCheckout","account":"{user:cancel-1-1}","item":"Keyboard","as":"cancel-before"},
        {"do":"reload","actor":"a","settleMs":1000},
        {"do":"ensureSignedIn","actor":"a","name":"cancel-1-1","readyTestid":"current-user"},
        {"do":"click","actor":"a","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
        {"do":"click","actor":"a","testid":"orders-toggle","unlessVisible":"order-item"},
        {"do":"expect","actor":"a","testid":"order-status","in":{"testid":"order-item","contains":"Keyboard"},"value":"pending","ignoreCase":true,"within":10000}
      ],
      "criteria":[{"id":"9100a","category":"production","points":0,
        "desc":"concurrent cancellation restores original warehouse stock once, preserves order and payment history, and removes revenue once",
        "steps":[
          {"do":"callConcurrently","actors":["a","b"],"from":"a","action":"cancel","namedAction":{"id":"cancel","path":"/api/orders/:id/cancel","reducer":"cancel_order","args":[0],"params":[{"name":"orderId","in":"path","placeholder":":id","wireType":"u64"}]},"input":{"testid":"order-item","contains":"Keyboard","attribute":"data-cancel-input"},"requests":1,"requestTimeoutMs":30000,"settleMs":3000},
          {"do":"expectCallOutcomes"},
          {"do":"dbExpectCancellation","before":"cancel-before"},
          {"do":"reload","actor":"admin","settleMs":1000},
          {"do":"ensureSignedIn","actor":"admin","name":"admin","password":"stackbench-admin-2026","exact":true,"readyTestid":"current-user"},
          {"do":"click","actor":"admin","testid":"overlay-close","ifAvailable":true,"within":1000},
          {"do":"click","actor":"admin","testid":"admin-link","unlessVisible":"admin-revenue"},
          {"do":"expectNumber","actor":"admin","testid":"admin-revenue","relativeTo":"revenue-before","plus":0,"within":10000}
        ]
      }]
    },
