{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Progression account state after reload",
  "features": [
    {
      "id": 105,
      "name": "An account keeps what belongs to it",
      "actors": ["shopper"],
      "setup": [
        { "do": "signUp", "actor": "shopper", "name": "pat" }
      ],
      "criteria": [
        {
          "id": "105a",
          "category": "production",
          "desc": "cart and order history survive reload and backend restart, including a fresh account login",
          "points": 1,
          "statedBy": "the signed-in account, cart, and orders persist across a page reload",
          "steps": [
            { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Headphones" } },
            { "do": "click", "actor": "shopper", "testid": "cart-toggle", "unlessVisible": "cart-total" },
            { "do": "click", "actor": "shopper", "testid": "checkout-submit", "settleMs": 1500 },
            { "do": "click", "actor": "shopper", "testid": "overlay-close", "ifAvailable": true },
            { "do": "click", "actor": "shopper", "testid": "catalog-link", "settleMs": 2500, "ifAvailable": true },
            { "do": "click", "actor": "shopper", "testid": "add-to-cart", "in": { "testid": "item-card", "contains": "Keyboard" } },
            { "do": "click", "actor": "shopper", "testid": "cart-toggle", "unlessVisible": "cart-total" },
            { "do": "expect", "actor": "shopper", "testid": "cart-item", "contains": "Keyboard", "within": 10000 },
            { "do": "reload", "actor": "shopper", "settleMs": 4000 },
            { "do": "expect", "actor": "shopper", "testid": "current-user", "contains": "pat" },
            { "do": "click", "actor": "shopper", "testid": "cart-toggle", "unlessVisible": "cart-total" },
            { "do": "expect", "actor": "shopper", "testid": "cart-item", "contains": "Keyboard" },
            { "do": "reload", "actor": "shopper", "settleMs": 2500 },
            { "do": "click", "actor": "shopper", "testid": "orders-toggle", "unlessVisible": "order-item" },
            { "do": "expect", "actor": "shopper", "testid": "order-item", "contains": "Headphones", "count": 1 },
            { "do": "restartBackend", "settleMs": 1000 },
            { "do": "freshClient", "actor": "shopper" },
            { "do": "signIn", "actor": "shopper-fresh", "name": "pat" },
            { "do": "click", "actor": "shopper-fresh", "testid": "cart-toggle", "unlessVisible": "cart-total" },
            { "do": "expect", "actor": "shopper-fresh", "testid": "cart-item", "contains": "Keyboard", "count": 1 },
            { "do": "click", "actor": "shopper-fresh", "testid": "overlay-close", "ifAvailable": true },
            { "do": "click", "actor": "shopper-fresh", "testid": "orders-toggle", "unlessVisible": "order-item" },
            { "do": "expect", "actor": "shopper-fresh", "testid": "order-item", "contains": "Headphones", "count": 1 }
          ]
        }
      ]
    }
  ]
}
