{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Checkout contention diagnostic",
  "note": "Draft diagnostic only; not selected by scored campaigns. Widths 1/4/16/64 are parallel requests cycled over two sessions of one fresh account, not distinct clients. Three fresh-account cohorts per width share one otherwise idle app. Each cohort prepares one cart and verifies one order and one stored stock decrement; rejecting all requests cannot pass. Timing is client dispatch through response, not server execution overlap or committed-operation latency. Use a reset disposable app copy and the same runtime/resources for each stack. Qualification is pending.",
  "features": [
    {"id": 9000, "name": "1 parallel checkout requests, cohort 1", "actors": ["a", "b"],
      "setup": [
        {"do":"signUp","actor":"a","name":"cohort-1-1"},
        {"do":"signIn","actor":"b","name":"cohort-1-1"},
        {"do":"dbRecordStock","item":"Keyboard","as":"stock-before"},
        {"do":"click","actor":"a","testid":"add-to-cart","in":{"testid":"item-card","contains":"Keyboard"}},
        {"do":"click","actor":"a","testid":"cart-toggle"},
        {"do":"expectNumber","actor":"a","testid":"cart-quantity","in":{"testid":"cart-item","contains":"Keyboard"},"equals":1,"within":10000}
      ],
      "criteria": [{"id": "9000a", "category": "production", "points": 0,
        "desc": "one prepared cart produces one order and one stored stock decrement",
        "steps": [
          {"do":"callConcurrently","actors":["a","b"],"action":"checkout","namedAction":{"id":"checkout","path":"/api/checkout","reducer":"checkout","args":[]},"requests":1,"requestTimeoutMs":30000,"settleMs":3000},
          {"do":"expectCallOutcomes"},
          {"do":"dbExpectStock","item":"Keyboard","relativeTo":"stock-before","plus":-1},
          {"do":"reload","actor":"a","settleMs":1000},
          {"do":"ensureSignedIn","actor":"a","name":"cohort-1-1","readyTestid":"current-user"},
          {"do":"click","actor":"a","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
          {"do":"click","actor":"a","testid":"orders-toggle"},
          {"do":"expect","actor":"a","testid":"order-item","contains":"Keyboard","count":1,"within":10000},
          {"do":"click","actor":"a","testid":"cart-toggle"},
          {"do":"expect","actor":"a","testid":"cart-item","absent":true,"within":10000}
        ]
      }]
    },
