{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Scheduled-work access",
  "note": "The customer attempts to schedule a restock and cancel an admin-created pending restock.",
  "features": [
    {
      "id": 317,
      "name": "Customers cannot manage scheduled restocks",
      "actors": ["admin", "customer"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "click", "actor": "admin", "testid": "restocks-link", "ifAvailable": true },
        { "do": "signUp", "actor": "customer", "name": "restock-outsider" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Webcam" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "West" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "3" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "180" },
        { "do": "click", "actor": "admin", "testid": "schedule-restock-submit" },
        { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "count": 1 }
      ],
      "criteria": [
        {
          "id": "317a",
          "category": "production",
          "desc": "the server refuses customer scheduling and cancellation of restocks",
          "points": 3,
          "statedBy": "Only an admin can schedule or cancel a restock.",
          "steps": [
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Webcam" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "West" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "3" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "180" },
            { "do": "callAction", "actor": "customer", "from": "admin", "action": "scheduleRestock", "authentication": "actor", "input": { "testid": "schedule-restock-submit", "attribute": "data-action-input" }, "namedAction": { "id": "scheduleRestock", "path": "/api/admin/scheduled-restocks", "method": "POST", "reducer": "schedule_restock", "args": ["", "", 0, 0], "params": [{ "name": "item", "in": "body" }, { "name": "warehouse", "in": "body" }, { "name": "quantity", "in": "body" }, { "name": "delaySeconds", "in": "body" }] }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "refused" },
            { "do": "replayAs", "actor": "customer", "from": "admin", "match": "DELETE", "namedAction": { "id": "cancelScheduledRestock", "path": "/api/admin/scheduled-restocks/{restockId}", "method": "DELETE", "reducer": "cancel_scheduled_restock", "args": [0], "params": [{ "name": "restockId", "in": "path", "placeholder": "{restockId}", "wireType": "u64" }] }, "namedTarget": { "testid": "pending-restock-item", "attribute": "data-entity-id", "valueType": "string" }, "settleMs": 2000 },
            { "do": "expectReplayRejected", "actor": "customer" },
            { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "count": 1 },
            { "do": "click", "actor": "admin", "testid": "pending-restock-cancel", "in": { "testid": "pending-restock-item" } }
          ]
        }
      ]
    }
  ]
}
