{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 3,
  "name": "Scheduled-work access",
  "note": "The admin proves each route with a distinct restock; the customer then attempts a new schedule and a cancellation.",
  "features": [
    {
      "id": 317,
      "name": "Customers cannot manage scheduled restocks",
      "actors": ["admin", "customer"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        {"do": "click", "actor": "admin", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["admin-link", "admin-panel", "schedule-restock-item"]},
        { "do": "click", "actor": "admin", "testid": "admin-link", "unlessVisible": ["admin-panel", "schedule-restock-item"] },
        { "do": "click", "actor": "admin", "testid": "restocks-link", "ifAvailable": true, "unlessVisible": "schedule-restock-item" },
        { "do": "signUp", "actor": "customer", "name": "restock-outsider" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Webcam" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "West" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "3" },
        { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "180" },
        { "do": "click", "actor": "admin", "testid": "schedule-restock-submit" },
        { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "count": 1 }
      ],
      "criteria": [
        {
          "id": "317a",
          "category": "production",
          "desc": "the server refuses customer scheduling and cancellation of restocks",
          "points": 3,
          "statedBy": "Only an admin can schedule or cancel a restock.",
          "steps": [
            { "do": "click", "actor": "admin", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["admin-link", "admin-panel", "schedule-restock-item"] },
            { "do": "click", "actor": "admin", "testid": "admin-link", "unlessVisible": ["admin-panel", "schedule-restock-item"] },
            { "do": "click", "actor": "admin", "testid": "restocks-link", "ifAvailable": true, "unlessVisible": "schedule-restock-item" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Desk Lamp" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "East" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "3" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "180" },
            { "do": "callAction", "actor": "admin", "action": "scheduleRestock", "authentication": "actor", "input": { "testid": "schedule-restock-submit", "attribute": "data-action-input" }, "namedAction": { "id": "scheduleRestock", "path": "/api/admin/scheduled-restocks", "method": "POST", "reducer": "schedule_restock", "args": ["", "", 0, 0], "params": [{ "name": "item", "in": "body" }, { "name": "warehouse", "in": "body" }, { "name": "quantity", "in": "body" }, { "name": "delaySeconds", "in": "body" }] }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "admin", "outcome": "accepted" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Keyboard" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "East" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "3" },
            { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "180" },
            { "do": "callAction", "actor": "customer", "from": "admin", "action": "scheduleRestock", "authentication": "actor", "input": { "testid": "schedule-restock-submit", "attribute": "data-action-input" }, "namedAction": { "id": "scheduleRestock", "path": "/api/admin/scheduled-restocks", "method": "POST", "reducer": "schedule_restock", "args": ["", "", 0, 0], "params": [{ "name": "item", "in": "body" }, { "name": "warehouse", "in": "body" }, { "name": "quantity", "in": "body" }, { "name": "delaySeconds", "in": "body" }] }, "settleMs": 2000 },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "refused", "routeProvenBy": "admin" },
            { "do": "reload", "actor": "admin", "settleMs": 1000 },
            { "do": "ensureSignedIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "admin", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["admin-link", "admin-panel", "pending-restock-item"] },
            { "do": "click", "actor": "admin", "testid": "admin-link", "unlessVisible": ["admin-panel", "pending-restock-item"] },
            { "do": "click", "actor": "admin", "testid": "restocks-link", "ifAvailable": true, "unlessVisible": "pending-restock-item" },
            { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "count": 2, "within": 10000 },
            { "do": "replayAs", "actor": "admin", "from": "admin", "match": "__317a-authorized-cancel__", "namedAction": { "id": "cancelScheduledRestock", "path": "/api/admin/scheduled-restocks/{restockId}", "method": "DELETE", "reducer": "cancel_scheduled_restock", "args": [0], "params": [{ "name": "restockId", "in": "path", "placeholder": "{restockId}", "wireType": "u64" }] }, "namedTarget": { "testid": "pending-restock-item", "attribute": "data-entity-id", "valueType": "string" }, "settleMs": 2000 },
            { "do": "expectReplayCompleted", "actor": "admin", "requireAccepted": true },
            { "do": "reload", "actor": "admin", "settleMs": 1000 },
            { "do": "ensureSignedIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "admin", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["admin-link", "admin-panel", "pending-restock-item"] },
            { "do": "click", "actor": "admin", "testid": "admin-link", "unlessVisible": ["admin-panel", "pending-restock-item"] },
            { "do": "click", "actor": "admin", "testid": "restocks-link", "ifAvailable": true, "unlessVisible": "pending-restock-item" },
            { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "count": 1, "within": 10000 },
            { "do": "replayAs", "actor": "customer", "from": "admin", "match": "__317a-customer-cancel__", "namedAction": { "id": "cancelScheduledRestock", "path": "/api/admin/scheduled-restocks/{restockId}", "method": "DELETE", "reducer": "cancel_scheduled_restock", "args": [0], "params": [{ "name": "restockId", "in": "path", "placeholder": "{restockId}", "wireType": "u64" }] }, "namedTarget": { "testid": "pending-restock-item", "attribute": "data-entity-id", "valueType": "string" }, "settleMs": 2000 },
            { "do": "expectReplayRejected", "actor": "customer" },
            { "do": "reload", "actor": "admin", "settleMs": 1000 },
            { "do": "ensureSignedIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "admin", "testid": "current-user", "ifAvailable": true, "unlessVisible": ["admin-link", "admin-panel", "pending-restock-item"] },
            { "do": "click", "actor": "admin", "testid": "admin-link", "unlessVisible": ["admin-panel", "pending-restock-item"] },
            { "do": "click", "actor": "admin", "testid": "restocks-link", "ifAvailable": true, "unlessVisible": "pending-restock-item" },
            { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "count": 1, "within": 10000 },
            { "do": "click", "actor": "admin", "testid": "pending-restock-cancel", "in": { "testid": "pending-restock-item" } }
          ]
        }
      ]
    }
  ]
}
