{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 2,
  "name": "Cancellation leaves the fulfilment queue",
  "features": [
    {
      "id": 3,
      "name": "Cancellation and fulfilment",
      "actors": ["customer", "staff"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "cancel-queue" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "click", "actor": "staff", "testid": "staff-link" }
      ],
      "criteria": [
        {
          "id": "3d",
          "desc": "cancelling a pending order removes it from the fulfilment queue",
          "points": 1,
          "statedBy": "the order leaves the fulfilment queue",
          "steps": [
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Coffee Grinder" } },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Coffee Grinder", "within": 10000 },
            { "do": "click", "actor": "customer", "testid": "orders-toggle" },
            { "do": "click", "actor": "customer", "testid": "cancel-order", "in": { "testid": "order-item", "contains": "Coffee Grinder" } },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Coffee Grinder", "absent": true, "within": 10000 }
          ]
        }
      ]
    }
  ]
}
