{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Ecommerce L2 independently selectable checks",
  "note": "Each criterion establishes every state and recorded value that it later observes, so it remains valid when selected by itself.",
  "features": [
    {
      "id": 1,
      "name": "Fulfilment queue",
      "actors": ["customer", "staff"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "fq-focused" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "click", "actor": "staff", "testid": "staff-link" }
      ],
      "criteria": [
        {
          "id": "1b",
          "desc": "the queue names the warehouse the order will ship from",
          "points": 1,
          "statedBy": "which warehouse each will ship from",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Desk Lamp", "enter": true, "settleMs": 1500 },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Desk Lamp" } },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Desk Lamp", "within": 10000 },
            { "do": "expect", "actor": "staff", "testid": "queue-warehouse", "in": { "testid": "queue-item", "contains": "Desk Lamp" }, "nonEmpty": true }
          ]
        },
        {
          "id": "1c",
          "desc": "shipping removes the order from the queue for staff and marks it shipped for the customer, live",
          "points": 2,
          "statedBy": "it leaves the queue for everyone watching the queue, and the customer's order history shows it as shipped, live",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Keyboard", "enter": true, "settleMs": 1500 },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Keyboard" } },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Keyboard", "within": 10000 },
            { "do": "click", "actor": "staff", "testid": "ship-submit", "in": { "testid": "queue-item", "contains": "Keyboard" } },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Keyboard", "absent": true, "within": 10000 },
            { "do": "click", "actor": "customer", "testid": "orders-toggle" },
            { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "contains": "hipped", "within": 10000 }
          ]
        },
        {
          "id": "1e",
          "desc": "the server refuses a customer's direct attempt to ship their own order",
          "points": 2,
          "statedBy": "Staff mark an order shipped",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Webcam", "enter": true, "settleMs": 1500 },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Webcam" }, "settleMs": 2000 },
            { "do": "click", "actor": "customer", "testid": "orders-toggle" },
            {
              "do": "callAction",
              "actor": "customer",
              "action": "ship",
              "namedAction": {
                "id": "ship",
                "path": "/api/fulfilment/ship",
                "reducer": "ship_order",
                "args": [0],
                "params": [{ "name": "orderId", "in": "body", "wireType": "u64" }]
              },
              "input": { "testid": "order-item", "contains": "Webcam", "attribute": "data-ship-input" },
              "settleMs": 2000
            },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "refused" },
            { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Webcam" }, "notContains": "hipped" }
          ]
        }
      ]
    },
    {
      "id": 2,
      "name": "Warehouse totals",
      "actors": ["admin"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "click", "actor": "admin", "testid": "admin-link" }
      ],
      "criteria": [
        {
          "id": "2b",
          "desc": "both warehouse totals move live and in opposite directions as stock is transferred",
          "points": 2,
          "statedBy": "the per-warehouse numbers staff and admins see both move at once",
          "steps": [
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "as": "warehouse-east-before" },
            { "do": "recordNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "as": "warehouse-west-before" },
            { "do": "fill", "actor": "admin", "testid": "transfer-from", "text": "East", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "fill", "actor": "admin", "testid": "transfer-to", "text": "West", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "fill", "actor": "admin", "testid": "transfer-qty", "text": "10", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "click", "actor": "admin", "testid": "transfer-submit", "in": { "testid": "admin-item-row", "contains": "Headphones" } },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "East" }, "relativeTo": "warehouse-east-before", "plus": -10, "within": 10000 },
            { "do": "expectNumber", "actor": "admin", "testid": "warehouse-total", "in": { "testid": "admin-warehouse-item", "contains": "West" }, "relativeTo": "warehouse-west-before", "plus": 10, "within": 10000 }
          ]
        }
      ]
    },
    {
      "id": 3,
      "name": "Cancellation history",
      "actors": ["customer"],
      "setup": [{ "do": "signUp", "actor": "customer", "name": "cancel-focused" }],
      "criteria": [
        {
          "id": "3b",
          "desc": "a cancelled order is shown as cancelled in the customer's history",
          "points": 1,
          "statedBy": "a customer can cancel an order that has not shipped",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Coffee Grinder", "enter": true, "settleMs": 1500 },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Coffee Grinder" }, "settleMs": 2000 },
            { "do": "click", "actor": "customer", "testid": "orders-toggle" },
            { "do": "click", "actor": "customer", "testid": "cancel-order", "in": { "testid": "order-item", "contains": "Coffee Grinder" } },
            { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Coffee Grinder" }, "contains": "ancel", "within": 10000 }
          ]
        }
      ]
    },
    {
      "id": 4,
      "name": "Live catalog price",
      "actors": ["admin", "visitor"],
      "setup": [
        { "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true },
        { "do": "click", "actor": "admin", "testid": "admin-link" },
        { "do": "fill", "actor": "visitor", "testid": "search-input", "text": "Air Purifier", "enter": true, "settleMs": 1500 }
      ],
      "criteria": [
        {
          "id": "4b",
          "desc": "the new price reaches a signed-out visitor without a reload",
          "points": 2,
          "statedBy": "the storefront shows the new price immediately, to everyone",
          "steps": [
            { "do": "expectNumber", "actor": "visitor", "testid": "item-price", "in": { "testid": "item-card", "contains": "Air Purifier" }, "atLeast": 2 },
            { "do": "fill", "actor": "admin", "testid": "price-input", "text": "1.00", "in": { "testid": "admin-item-row", "contains": "Air Purifier" } },
            { "do": "click", "actor": "admin", "testid": "price-submit", "in": { "testid": "admin-item-row", "contains": "Air Purifier" } },
            { "do": "expectNumber", "actor": "visitor", "testid": "item-price", "in": { "testid": "item-card", "contains": "Air Purifier" }, "equals": 1, "within": 10000 }
          ]
        }
      ]
    },
    {
      "id": 202,
      "name": "Stock recovery is durable across clients",
      "actors": ["customer"],
      "setup": [{ "do": "signUp", "actor": "customer", "name": "fresh-stock" }],
      "criteria": [
        {
          "id": "202c",
          "desc": "a fresh client sees the restored total after a sale is cancelled",
          "points": 1,
          "statedBy": "every one of these numbers is the same for every person looking at it",
          "steps": [
            { "do": "fill", "actor": "customer", "testid": "search-input", "text": "Induction Cooktop", "enter": true, "settleMs": 1500 },
            { "do": "recordNumber", "actor": "customer", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Induction Cooktop" }, "as": "fresh-stock-before" },
            { "do": "click", "actor": "customer", "testid": "buy-now", "in": { "testid": "item-card", "contains": "Induction Cooktop" }, "settleMs": 2000 },
            { "do": "click", "actor": "customer", "testid": "orders-toggle" },
            { "do": "click", "actor": "customer", "testid": "cancel-order", "in": { "testid": "order-item", "contains": "Induction Cooktop" }, "settleMs": 2000 },
            { "do": "freshClient", "actor": "customer" },
            { "do": "fill", "actor": "customer-fresh", "testid": "search-input", "text": "Induction Cooktop", "enter": true, "settleMs": 2000 },
            { "do": "expectNumber", "actor": "customer-fresh", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Induction Cooktop" }, "relativeTo": "fresh-stock-before", "plus": 0 }
          ]
        }
      ]
    }
  ]
}
