{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 2,
  "name": "Ecommerce L2 fulfilment shipping",
  "note": "This scenario owns only the shipping result check.",
  "features": [
    {
      "id": 1,
      "name": "Ship a pending order",
      "actors": ["customer", "staff"],
      "setup": [
        { "do": "signUp", "actor": "customer", "name": "fq-ship" },
        { "do": "signIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true },
        { "do": "click", "actor": "staff", "testid": "staff-link" }
      ],
      "criteria": [
        {
          "id": "1c",
          "category": "feature",
          "desc": "shipping removes the order from the queue and marks the customer's order shipped",
          "points": 2,
          "statedBy": "Staff can mark an order as shipped; show the new status in the fulfilment area and the customer's order history.",
          "steps": [
            { "do": "callAction", "actor": "customer", "action": "buy", "namedAction": { "id": "buy", "path": "/api/items/:id/buy", "reducer": "buy_now", "args": [0], "params": [{ "name": "itemId", "in": "path", "placeholder": ":id", "wireType": "u64" }] }, "input": { "testid": "item-card", "contains": "Keyboard", "attribute": "data-buy-input" } },
            { "do": "expectActionOutcome", "actor": "customer", "outcome": "accepted" },
            {"do":"click","actor":"customer","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
            { "do": "click", "actor": "customer", "testid": "orders-toggle", "unlessVisible": "order-item" },
            { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "value": "pending", "ignoreCase": true, "within": 10000 },
            { "do": "reload", "actor": "staff", "settleMs": 2000 },
            { "do": "ensureSignedIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "staff", "testid": "staff-link", "ifAvailable": true },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Keyboard", "within": 10000 },
            { "do": "click", "actor": "staff", "testid": "ship-submit", "in": { "testid": "queue-item", "contains": "Keyboard" } },
            { "do": "expect", "actor": "staff", "testid": "fulfilment-panel", "attribute": "data-submit-state", "value": "succeeded", "within": 10000 },
            { "do": "reload", "actor": "staff", "settleMs": 2000 },
            { "do": "ensureSignedIn", "actor": "staff", "name": "staff", "password": "stackbench-staff-2026", "exact": true, "readyTestid": "current-user" },
            { "do": "click", "actor": "staff", "testid": "staff-link", "ifAvailable": true },
            { "do": "expect", "actor": "staff", "testid": "queue-item", "contains": "Keyboard", "absent": true, "within": 10000 },
            { "do": "reload", "actor": "customer", "settleMs": 2000 },
            { "do": "ensureSignedIn", "actor": "customer", "name": "fq-ship", "readyTestid": "current-user" },
            {"do":"click","actor":"customer","testid":"overlay-close","ifAvailable":true,"unlessVisible":"order-item","within":1000},
            { "do": "click", "actor": "customer", "testid": "orders-toggle", "unlessVisible": "order-item" },
            { "do": "expect", "actor": "customer", "testid": "order-status", "in": { "testid": "order-item", "contains": "Keyboard" }, "value": "shipped", "ignoreCase": true, "within": 10000 }
          ]
        }
      ]
    }
  ]
}
