{
  "schemaVersion": 1,
  "status": "draft",
  "track": "ecommerce",
  "level": 3,
  "name": "Scheduled restocks",
  "note": "Each check schedules its own restock.",
  "features": [
    {
      "id": 302,
      "name": "A restock is pending before it is due",
      "actors": ["admin"],
      "setup": [{ "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true }, { "do": "click", "actor": "admin", "testid": "admin-link" }],
      "criteria": [{
        "id": "302a",
        "desc": "a scheduled restock is pending and its remaining time decreases",
        "points": 2,
        "statedBy": "A pending restock shows its remaining time.",
        "steps": [
          { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Webcam" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "East" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "7" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "90" }, { "do": "click", "actor": "admin", "testid": "schedule-restock-submit" },
          { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "contains": "Webcam", "within": 10000 },
          { "do": "expectNumber", "actor": "admin", "testid": "pending-restock-remaining", "in": { "testid": "pending-restock-item", "contains": "Webcam" }, "atLeast": 80 },
          { "do": "wait", "actor": "admin", "ms": 15000 },
          { "do": "expectNumber", "actor": "admin", "testid": "pending-restock-remaining", "in": { "testid": "pending-restock-item", "contains": "Webcam" }, "atMost": 75 },
          { "do": "click", "actor": "admin", "testid": "pending-restock-cancel", "in": { "testid": "pending-restock-item", "contains": "Webcam" } }
        ]
      }]
    },
    {
      "id": 305,
      "name": "A due restock applies",
      "actors": ["admin", "watcher"],
      "setup": [{ "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true }, { "do": "click", "actor": "admin", "testid": "admin-link" }, { "do": "fill", "actor": "watcher", "testid": "search-input", "text": "Keyboard", "enter": true }, { "do": "recordNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "as": "before" }],
      "criteria": [{
        "id": "305a",
        "desc": "a due restock updates stock and moves to the ledger",
        "points": 3,
        "statedBy": "A due restock updates stock, leaves the pending list, and enters the stock ledger.",
        "steps": [
          { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Keyboard" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "West" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "7" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "15" }, { "do": "click", "actor": "admin", "testid": "schedule-restock-submit" },
          { "do": "wait", "actor": "admin", "ms": 25000 },
          { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Keyboard" }, "relativeTo": "before", "plus": 7, "within": 15000 },
          { "do": "expect", "actor": "admin", "testid": "pending-restock-item", "contains": "Keyboard", "absent": true },
          { "do": "expect", "actor": "admin", "testid": "stock-ledger-entry", "contains": "Keyboard" }
        ]
      }]
    },
    {
      "id": 306,
      "name": "A scheduled restock can be cancelled",
      "actors": ["admin", "watcher"],
      "setup": [{ "do": "signIn", "actor": "admin", "name": "admin", "password": "stackbench-admin-2026", "exact": true }, { "do": "click", "actor": "admin", "testid": "admin-link" }, { "do": "recordNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "as": "before" }],
      "criteria": [{
        "id": "306a",
        "desc": "a cancelled restock never applies",
        "points": 2,
        "statedBy": "An admin can schedule and cancel a restock.",
        "steps": [
          { "do": "fill", "actor": "admin", "testid": "schedule-restock-item", "text": "Desk Lamp" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-warehouse", "text": "East" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-qty", "text": "9" }, { "do": "fill", "actor": "admin", "testid": "schedule-restock-delay", "text": "15" }, { "do": "click", "actor": "admin", "testid": "schedule-restock-submit" },
          { "do": "click", "actor": "admin", "testid": "pending-restock-cancel", "in": { "testid": "pending-restock-item", "contains": "Desk Lamp" } },
          { "do": "wait", "actor": "admin", "ms": 25000 },
          { "do": "expectNumber", "actor": "watcher", "testid": "item-stock", "in": { "testid": "item-card", "contains": "Desk Lamp" }, "relativeTo": "before", "plus": 0 }
        ]
      }]
    }
  ]
}
