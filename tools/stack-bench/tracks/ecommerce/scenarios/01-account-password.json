{
  "schemaVersion": 1,
  "track": "ecommerce",
  "level": 1,
  "name": "Password refusal",
  "features": [
    {
      "id": 1,
      "name": "Accounts",
      "actors": [
        "ordinary",
        "ordinary-returning",
        "ordinary-impostor",
        "owner",
        "returning",
        "impostor"
      ],
      "setup": [],
      "criteria": [
        {
          "id": "1c",
          "category": "production",
          "desc": "the complete accepted password is required to sign in",
          "points": 1,
          "steps": [
            {
              "do": "signUp",
              "actor": "ordinary",
              "name": "password-ordinary",
              "password": "ordinary-password-A"
            },
            {
              "do": "expect",
              "actor": "ordinary",
              "testid": "current-user",
              "contains": "password-ordinary",
              "within": 6000
            },
            {
              "do": "signIn",
              "actor": "ordinary-returning",
              "name": "password-ordinary",
              "password": "ordinary-password-A",
              "awaitSignedIn": false
            },
            {
              "do": "expect",
              "actor": "ordinary-returning",
              "testid": "current-user",
              "contains": "password-ordinary",
              "within": 10000
            },
            {
              "do": "signIn",
              "actor": "ordinary-impostor",
              "name": "password-ordinary",
              "password": "ordinary-password-B",
              "expectFailure": true
            },
            {
              "do": "expect",
              "actor": "ordinary-impostor",
              "testid": "auth-error",
              "within": 6000
            },
            {
              "do": "reload",
              "actor": "ordinary-impostor",
              "application": true,
              "settleMs": 1000
            },
            {
              "do": "expect",
              "actor": "ordinary-impostor",
              "testid": "current-user",
              "absent": true
            },
            {
              "do": "probePasswordBoundary",
              "actor": "owner",
              "returningActor": "returning",
              "impostorActor": "impostor",
              "name": "password-boundary",
              "password": "界界界界界界界界界界界界界界界界界界界界界界界界-A",
              "wrongPassword": "界界界界界界界界界界界界界界界界界界界界界界界界-B"
            }
          ],
          "statedBy": "signing in with a wrong password fails with a visible error"
        }
      ]
    }
  ]
}
