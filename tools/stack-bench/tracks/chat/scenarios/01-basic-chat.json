{
  "level": 1,
  "note": "Level 1 is sequential's basic chat with accounts added. Accounts replace the display-name stub; typing indicators, read receipts and unread counts are sequential's, unchanged apart from signing up rather than naming yourself.",
  "features": [
    {
      "id": 1,
      "name": "Accounts",
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        }
      ],
      "criteria": [
        {
          "id": "signup-signs-in",
          "points": 1,
          "desc": "Creating an account signs the user in and shows their username",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "current-user",
              "contains": "Alice",
              "within": 6000
            }
          ]
        },
        {
          "id": "duplicate-username-rejected",
          "points": 1,
          "desc": "Signing up with a taken username is rejected with a visible error, and must not sign the visitor in as the existing account",
          "steps": [
            {
              "do": "signUp",
              "actor": "bob",
              "name": "Alice",
              "expectFailure": true
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "auth-error",
              "within": 6000
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "current-user",
              "absent": true,
              "within": 3000
            }
          ]
        },
        {
          "id": "signout-and-signin",
          "points": 1,
          "desc": "A user can sign out and sign back in with the same credentials",
          "steps": [
            {
              "do": "click",
              "actor": "alice",
              "testid": "signout"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "signup-username",
              "within": 6000
            },
            {
              "do": "signIn",
              "actor": "alice",
              "name": "Alice"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "current-user",
              "contains": "Alice",
              "within": 6000
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "name": "Basic Chat",
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "general"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "general"
        }
      ],
      "criteria": [
        {
          "id": "own-message-appears",
          "points": 1,
          "desc": "A sent message appears in the sender's own message list",
          "steps": [
            {
              "do": "send",
              "actor": "alice",
              "text": "hello from alice"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-item",
              "contains": "hello from alice",
              "within": 5000
            }
          ]
        },
        {
          "id": "cross-user-realtime",
          "points": 1,
          "desc": "A second user in the same room receives messages live, with no reload",
          "steps": [
            {
              "do": "enterRoom",
              "actor": "bob",
              "room": "general"
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "hello from alice",
              "within": 5000
            },
            {
              "do": "send",
              "actor": "bob",
              "text": "hello from bob"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-item",
              "contains": "hello from bob",
              "within": 3000
            }
          ]
        },
        {
          "id": "presence-and-leave",
          "points": 1,
          "desc": "Online users lists both participants; leaving a room works",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "online-users",
              "contains": "Bob",
              "within": 5000
            },
            {
              "do": "click",
              "actor": "bob",
              "testid": "leave-room"
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-input",
              "absent": true,
              "within": 5000
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "name": "Typing Indicators",
      "actors": [
        "alice",
        "bob",
        "carol"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "signUp",
          "actor": "carol",
          "name": "Carol"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "typing-a"
        },
        {
          "do": "createRoom",
          "actor": "carol",
          "room": "typing-b"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "typing-a"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "typing-a"
        },
        {
          "do": "enterRoom",
          "actor": "carol",
          "room": "typing-b"
        }
      ],
      "criteria": [
        {
          "id": "indicator-appears",
          "points": 1,
          "desc": "Typing by another user in the same room shows an indicator live",
          "steps": [
            {
              "do": "typeInto",
              "actor": "bob",
              "text": "composing a reply"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "typing-indicator",
              "within": 4000,
              "contains": "typing"
            }
          ]
        },
        {
          "id": "indicator-expires",
          "points": 1,
          "desc": "Indicator disappears within 6s once typing stops",
          "steps": [
            {
              "do": "clearInput",
              "actor": "bob"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "typing-indicator",
              "absent": true,
              "within": 6500,
              "contains": "typing"
            }
          ]
        },
        {
          "id": "scoped-to-room",
          "points": 1,
          "desc": "Typing is scoped to the room \u2014 a user in another room sees nothing",
          "steps": [
            {
              "do": "typeInto",
              "actor": "bob",
              "text": "still typing here"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "typing-indicator",
              "within": 4000,
              "contains": "typing"
            },
            {
              "do": "expect",
              "actor": "carol",
              "testid": "typing-indicator",
              "absent": true,
              "within": 2000,
              "contains": "typing"
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "name": "Read Receipts",
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "receipts"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "receipts"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "did you see this"
        }
      ],
      "criteria": [
        {
          "id": "receipt-appears",
          "points": 1,
          "desc": "Receipt appears for the sender once another user views the message",
          "steps": [
            {
              "do": "enterRoom",
              "actor": "bob",
              "room": "receipts"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "read-receipt",
              "within": 6000
            }
          ]
        },
        {
          "id": "receipt-names-reader",
          "points": 1,
          "desc": "Receipt names the user who read it",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "read-receipt",
              "contains": "Bob",
              "within": 6000
            }
          ]
        },
        {
          "id": "sender-excluded",
          "points": 1,
          "desc": "The sender is not listed as a reader of their own message",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "read-receipt",
              "notContains": "Alice",
              "within": 6000
            }
          ]
        }
      ]
    },
    {
      "id": 5,
      "name": "Unread Message Counts",
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "unread-main"
        },
        {
          "do": "createRoom",
          "actor": "bob",
          "room": "unread-side"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "unread-main"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "unread-main"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "unread-side"
        }
      ],
      "criteria": [
        {
          "id": "badge-appears",
          "points": 1,
          "desc": "A badge appears live on a room with unread messages",
          "steps": [
            {
              "do": "send",
              "actor": "alice",
              "text": "unread one"
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "unread-badge",
              "in": {
                "testid": "room-item",
                "contains": "{room:unread-main}"
              },
              "within": 5000
            }
          ]
        },
        {
          "id": "badge-counts",
          "points": 1,
          "desc": "The badge reflects the number of unread messages (paced above the app's send rate limit)",
          "steps": [
            {
              "do": "wait",
              "actor": "alice",
              "ms": 1400
            },
            {
              "do": "send",
              "actor": "alice",
              "text": "unread two"
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "unread-badge",
              "contains": "2",
              "in": {
                "testid": "room-item",
                "contains": "{room:unread-main}"
              },
              "within": 5000
            }
          ]
        },
        {
          "id": "badge-clears",
          "points": 1,
          "desc": "The badge clears when the room is opened",
          "steps": [
            {
              "do": "enterRoom",
              "actor": "bob",
              "room": "unread-main"
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "unread-badge",
              "in": {
                "testid": "room-item",
                "contains": "{room:unread-main}"
              },
              "absent": true,
              "within": 5000
            }
          ]
        }
      ]
    },
    {
      "id": 6,
      "name": "Room Members and Roles",
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "team"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "team"
        }
      ],
      "criteria": [
        {
          "id": "members-appear-live",
          "points": 1,
          "desc": "Someone joining a room appears in its member panel without anyone reloading",
          "steps": [
            {
              "do": "enterRoom",
              "actor": "bob",
              "room": "team"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "member-item",
              "contains": "Bob",
              "within": 8000
            }
          ]
        },
        {
          "id": "owner-is-shown",
          "points": 1,
          "desc": "The room's creator is marked as its owner",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "member-owner",
              "within": 6000
            }
          ]
        },
        {
          "id": "removed-member-disappears",
          "points": 1,
          "desc": "Removing a member takes them out of the panel live, for everyone still in the room",
          "steps": [
            {
              "do": "click",
              "actor": "alice",
              "testid": "member-remove",
              "in": {
                "testid": "member-item",
                "contains": "Bob"
              }
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "member-item",
              "contains": "Bob",
              "absent": true,
              "within": 8000
            }
          ]
        }
      ]
    },
    {
      "id": 7,
      "name": "Direct Messages",
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "wait",
          "actor": "alice",
          "ms": 2000
        }
      ],
      "criteria": [
        {
          "id": "dm-can-be-started",
          "points": 1,
          "desc": "A user can open a direct conversation with another user",
          "steps": [
            {
              "do": "click",
              "actor": "alice",
              "testid": "dm-start",
              "in": {
                "testid": "online-user",
                "contains": "Bob"
              }
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "dm-item",
              "contains": "Bob",
              "within": 8000
            }
          ]
        },
        {
          "id": "dm-delivers-live",
          "points": 1,
          "desc": "A direct message reaches the other participant live, with no reload",
          "steps": [
            {
              "do": "click",
              "actor": "alice",
              "testid": "dm-item",
              "in": {
                "testid": "dm-list",
                "contains": "Bob"
              }
            },
            {
              "do": "send",
              "actor": "alice",
              "text": "a private word"
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "a private word",
              "within": 10000
            }
          ]
        },
        {
          "id": "dm-persists",
          "points": 1,
          "desc": "A direct conversation and its messages survive a reload",
          "steps": [
            {
              "do": "reload",
              "actor": "bob",
              "settleMs": 3500
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "dm-item",
              "contains": "Alice",
              "within": 10000
            }
          ]
        }
      ]
    },
    {
      "id": 8,
      "name": "Message Ownership",
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "signUp",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "signUp",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "owned"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "owned"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "owned"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "a message of my own"
        }
      ],
      "criteria": [
        {
          "id": "author-can-edit-and-delete",
          "points": 1,
          "desc": "The author of a message is offered edit and delete on it",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-edit",
              "in": {
                "testid": "message-item",
                "contains": "a message of my own"
              },
              "within": 6000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-delete",
              "in": {
                "testid": "message-item",
                "contains": "a message of my own"
              },
              "within": 6000
            }
          ]
        },
        {
          "id": "others-are-not",
          "points": 1,
          "desc": "Nobody else is offered edit or delete on that message",
          "steps": [
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "a message of my own",
              "within": 8000
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-edit",
              "in": {
                "testid": "message-item",
                "contains": "a message of my own"
              },
              "absent": true,
              "within": 5000
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-delete",
              "in": {
                "testid": "message-item",
                "contains": "a message of my own"
              },
              "absent": true,
              "within": 5000
            }
          ]
        }
      ]
    }
  ]
}