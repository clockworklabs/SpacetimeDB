{
  "name": "@spacetimedb/stack-bench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node dist/scripts/stage-javascript-modules.js",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:typescript": "npm run build && node --test dist/tests/*.test.js",
    "bootstrap:browsers": "playwright install chromium",
    "prebench": "npm run build --silent",
    "bench": "node commands/bench.mjs",
    "prepreflight": "npm run build",
    "preflight": "node dist/commands/preflight.js",
    "prerecover": "npm run build",
    "recover": "node dist/commands/recovery.js recover",
    "release:bundle": "node src/releases/release-bundle.mjs",
    "release:source": "npm run build --silent && node dist/src/releases/release-source.js --json",
    "verify:release": "node src/releases/release-manifest.mjs verify",
    "precheck:scenarios": "npm run build --silent",
    "check:scenarios": "node dist/commands/check-scenarios.js --track chat && node dist/commands/check-scenarios.js --track ecommerce --recipe l1-modular-2.5.0.json && node dist/commands/check-scenarios.js --track ecommerce --recipe l2-standard-1.6.0.json && node dist/commands/check-scenarios.js --track ecommerce --recipe l3-standard-1.0.0.json && node dist/commands/check-scenarios.js --track ecommerce --recipe progression-catalog-1.0.0.json",
    "precheck:mutations": "npm run build",
    "check:mutations": "node dist/commands/check-mutations.js",
    "precheck:definition-goldens": "npm run build --silent",
    "check:definition-goldens": "node dist/commands/definition-goldens.js",
    "precheck:composition": "npm run build --silent",
    "check:composition": "node dist/commands/check-composition.js",
    "check:prompts": "node --test tests/dependency-neutral-prompt.test.mjs",
    "precheck:calibration": "npm run build --silent",
    "check:calibration": "node dist/commands/check-calibration.js",
    "check:references": "node src/references/reference-fixtures.mjs",
    "pregraph": "npm run build",
    "graph": "node dist/commands/progression-graph.js",
    "pack": "node commands/composition-cli.mjs pack",
    "recipe": "node commands/composition-cli.mjs recipe",
    "campaign": "node commands/campaign-cli.mjs",
    "dashboard": "node dashboard/dashboard-server.mjs",
    "prerepair": "npm run build",
    "repair": "node dist/commands/repair-cli.js",
    "pretest": "npm run build --silent",
    "test": "node --test tests/*.test.mjs dist/tests/*.test.js",
    "test:container": "node commands/container-smoke.mjs",
    "test:references": "node src/references/reference-build.mjs",
    "qualify:reference": "node src/references/reference-live.mjs",
    "test:faults": "node commands/fault-injection.mjs",
    "pretest:loop": "npm run build",
    "test:loop": "node commands/test-loop.mjs",
    "test:null": "node commands/null-control.mjs"
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.6.3"
  }
}
