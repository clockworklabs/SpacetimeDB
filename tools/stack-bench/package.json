{
  "name": "@spacetimedb/stack-bench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/stage-javascript-modules.mjs",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:typescript": "npm run build && node --test dist/tests/*.test.js",
    "bootstrap:browsers": "playwright install chromium",
    "bench": "node commands/bench.mjs",
    "prepreflight": "npm run build",
    "preflight": "node dist/commands/preflight.js",
    "prerecover": "npm run build",
    "recover": "node dist/commands/recovery.js recover",
    "release:bundle": "node src/releases/release-bundle.mjs",
    "release:source": "node src/releases/release-source.mjs --json",
    "verify:release": "node src/releases/release-manifest.mjs verify",
    "check:scenarios": "node commands/check-scenarios.mjs --track chat && node commands/check-scenarios.mjs --track ecommerce --recipe l1-modular-2.5.0.json && node commands/check-scenarios.mjs --track ecommerce --recipe l2-standard-1.6.0.json && node commands/check-scenarios.mjs --track ecommerce --recipe l3-standard-1.0.0.json && node commands/check-scenarios.mjs --track ecommerce --recipe progression-catalog-1.0.0.json",
    "precheck:mutations": "npm run build",
    "check:mutations": "node dist/commands/check-mutations.js",
    "check:definition-goldens": "node commands/definition-goldens.mjs",
    "check:composition": "node commands/check-composition.mjs",
    "check:prompts": "node commands/prompt-snapshot.mjs",
    "check:calibration": "node commands/check-calibration.mjs",
    "check:references": "node src/references/reference-fixtures.mjs",
    "pregraph": "npm run build",
    "graph": "node dist/commands/progression-graph.js",
    "pack": "node commands/composition-cli.mjs pack",
    "recipe": "node commands/composition-cli.mjs recipe",
    "campaign": "node commands/campaign-cli.mjs",
    "dashboard": "node dashboard/dashboard-server.mjs",
    "prerepair": "npm run build",
    "repair": "node dist/commands/repair-cli.js",
    "test": "node --test tests/*.test.mjs",
    "test:container": "node commands/container-smoke.mjs",
    "test:references": "node src/references/reference-build.mjs",
    "qualify:reference": "node src/references/reference-live.mjs",
    "test:faults": "node commands/fault-injection.mjs",
    "pretest:loop": "npm run build",
    "test:loop": "node commands/test-loop.mjs",
    "test:null": "node commands/null-control.mjs"
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.6.3"
  }
}
