{
  "level": 1,
  "track": "stack-bench",
  "note": "Level 1 features: accounts, a live shared resource, and durable messages. Identity is verified here as a feature (sign up, sign in, sign out, persistence) and again as an invariant in 01-accounts-invariants.json, which checks the properties the feature spec never states.",
  "features": [
    {
      "id": 1,
      "name": "Accounts",
      "actors": ["alice", "bob"],
      "setup": [
        { "do": "signUp", "actor": "alice", "name": "Alice" }
      ],
      "criteria": [
        {
          "id": "signup-signs-in",
          "points": 1,
          "desc": "Creating an account signs the user in and shows their username",
          "steps": [
            { "do": "expect", "actor": "alice", "testid": "current-user", "contains": "Alice", "within": 6000 }
          ]
        },
        {
          "id": "duplicate-username-rejected",
          "points": 1,
          "desc": "Signing up with a taken username is rejected with a visible error, and must not sign the visitor in as the existing account",
          "steps": [
            { "do": "signUp", "actor": "bob", "name": "Alice", "expectFailure": true },
            { "do": "expect", "actor": "bob", "testid": "auth-error", "within": 6000 },
            { "do": "expect", "actor": "bob", "testid": "current-user", "absent": true, "within": 3000 }
          ]
        },
        {
          "id": "signout-and-signin",
          "points": 1,
          "desc": "A user can sign out and sign back in with the same credentials",
          "steps": [
            { "do": "click", "actor": "alice", "testid": "signout" },
            { "do": "expect", "actor": "alice", "testid": "signup-username", "within": 6000 },
            { "do": "signIn", "actor": "alice", "name": "Alice" },
            { "do": "expect", "actor": "alice", "testid": "current-user", "contains": "Alice", "within": 6000 }
          ]
        }
      ]
    },
    {
      "id": 2,
      "name": "Rooms",
      "actors": ["alice", "bob"],
      "setup": [
        { "do": "signUp", "actor": "alice", "name": "Alice" },
        { "do": "signUp", "actor": "bob", "name": "Bob" }
      ],
      "criteria": [
        {
          "id": "room-appears-live",
          "points": 1,
          "desc": "A room created by one user appears in another user's list live, with no reload",
          "steps": [
            { "do": "createRoom", "actor": "alice", "room": "general" },
            { "do": "expect", "actor": "bob", "testid": "room-item", "contains": "{room:general}", "within": 6000 }
          ]
        },
        {
          "id": "enter-and-leave",
          "points": 1,
          "desc": "A user can enter a room to post, and leave it",
          "steps": [
            { "do": "enterRoom", "actor": "bob", "room": "general" },
            { "do": "click", "actor": "bob", "testid": "leave-room" },
            { "do": "expect", "actor": "bob", "testid": "message-input", "absent": true, "within": 5000 }
          ]
        },
        {
          "id": "presence-live",
          "points": 1,
          "desc": "The online-users list shows other signed-in accounts",
          "steps": [
            { "do": "expect", "actor": "alice", "testid": "online-users", "contains": "Bob", "within": 8000 }
          ]
        }
      ]
    },
    {
      "id": 3,
      "name": "Messages",
      "actors": ["alice", "bob"],
      "setup": [
        { "do": "signUp", "actor": "alice", "name": "Alice" },
        { "do": "signUp", "actor": "bob", "name": "Bob" },
        { "do": "createRoom", "actor": "alice", "room": "general" },
        { "do": "enterRoom", "actor": "alice", "room": "general" },
        { "do": "enterRoom", "actor": "bob", "room": "general" }
      ],
      "criteria": [
        {
          "id": "cross-user-realtime",
          "points": 1,
          "desc": "A message reaches the other user live, with no reload",
          "steps": [
            { "do": "send", "actor": "alice", "text": "hello from alice" },
            { "do": "expect", "actor": "bob", "testid": "message-item", "contains": "hello from alice", "within": 5000 }
          ]
        },
        {
          "id": "attributed-to-account",
          "points": 1,
          "desc": "A message is attributed to the account that sent it",
          "steps": [
            { "do": "expect", "actor": "bob", "testid": "message-item", "contains": "Alice", "within": 5000 }
          ]
        },
        {
          "id": "history-survives-reload",
          "points": 1,
          "desc": "Message history persists across a reload",
          "steps": [
            { "do": "reload", "actor": "bob", "settleMs": 3000 },
            { "do": "enterRoom", "actor": "bob", "room": "general" },
            { "do": "expect", "actor": "bob", "testid": "message-item", "contains": "hello from alice", "within": 8000 }
          ]
        }
      ]
    }
  ]
}
