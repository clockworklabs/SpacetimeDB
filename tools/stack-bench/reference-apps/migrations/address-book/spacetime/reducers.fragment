
function ensureAddressBook(ctx: Ctx, accountId: bigint) {
  if (ctx.db.addressBookOwner.accountId.find(accountId)) return;
  ctx.db.addressBookOwner.insert({ accountId });
  const old = ctx.db.customerProfile.accountId.find(accountId);
  if (old && (old.name !== '' || old.address !== '')) {
    ctx.db.addressEntry.insert({ id: 0n, accountId, name: old.name, address: old.address, isDefault: true });
  }
}

function syncAddressProfile(ctx: Ctx, accountId: bigint) {
  const entry = [...ctx.db.addressEntry.accountId.filter(accountId)].find(entry => entry.isDefault);
  const profile = { accountId, name: entry?.name ?? '', address: entry?.address ?? '' };
  if (ctx.db.customerProfile.accountId.find(accountId)) ctx.db.customerProfile.accountId.update(profile);
  else ctx.db.customerProfile.insert(profile);
}

function saveDefaultAddress(ctx: Ctx, accountId: bigint, name: string, address: string) {
  ensureAddressBook(ctx, accountId);
  const existing = [...ctx.db.addressEntry.accountId.filter(accountId)].find(entry => entry.isDefault);
  if (existing) ctx.db.addressEntry.id.update({ ...existing, name, address });
  else ctx.db.addressEntry.insert({ id: 0n, accountId, name, address, isDefault: true });
  syncAddressProfile(ctx, accountId);
}

export const openAddressBook = spacetimedb.reducer((ctx) => {
  ensureAddressBook(ctx, requireAccount(ctx).id);
});

export const addAddress = spacetimedb.reducer({ name: t.string(), address: t.string() }, (ctx, { name, address }) => {
  const accountId = requireAccount(ctx).id;
  ensureAddressBook(ctx, accountId);
  const isDefault = [...ctx.db.addressEntry.accountId.filter(accountId)].length === 0;
  ctx.db.addressEntry.insert({ id: 0n, accountId, name, address, isDefault });
  syncAddressProfile(ctx, accountId);
});

function ownedAddress(ctx: Ctx, id: string) {
  const accountId = requireAccount(ctx).id;
  ensureAddressBook(ctx, accountId);
  if (!/^[0-9]{1,20}$/.test(id) || BigInt(id) > 18446744073709551615n) throw new SenderError('Address missing');
  const entry = ctx.db.addressEntry.id.find(BigInt(id));
  if (!entry || entry.accountId !== accountId) throw new SenderError('Address missing');
  return entry;
}

export const editAddress = spacetimedb.reducer({ id: t.string(), name: t.string(), address: t.string() }, (ctx, { id, name, address }) => {
  const entry = ownedAddress(ctx, id);
  ctx.db.addressEntry.id.update({ ...entry, name, address });
  syncAddressProfile(ctx, entry.accountId);
});

export const chooseAddress = spacetimedb.reducer({ id: t.string() }, (ctx, { id }) => {
  const entry = ownedAddress(ctx, id);
  for (const other of ctx.db.addressEntry.accountId.filter(entry.accountId)) {
    ctx.db.addressEntry.id.update({ ...other, isDefault: other.id === entry.id });
  }
  syncAddressProfile(ctx, entry.accountId);
});

export const deleteAddress = spacetimedb.reducer({ id: t.string() }, (ctx, { id }) => {
  const entry = ownedAddress(ctx, id);
  if (entry.isDefault && [...ctx.db.addressEntry.accountId.filter(entry.accountId)].length > 1) {
    throw new SenderError('Choose another default first');
  }
  ctx.db.addressEntry.id.delete(entry.id);
  syncAddressProfile(ctx, entry.accountId);
});

export const myAddresses = spacetimedb.view(
  { name: 'my_addresses', public: true },
  t.array(t.object('AddressBookEntry', { id: t.string(), name: t.string(), address: t.string(), isDefault: t.bool() })), (ctx) => {
    const accountId = getAccountId(ctx);
    return accountId === null ? [] : [...ctx.db.addressEntry.accountId.filter(accountId)]
      .map(entry => ({ id: String(entry.id), name: entry.name, address: entry.address, isDefault: entry.isDefault }));
  }
);
