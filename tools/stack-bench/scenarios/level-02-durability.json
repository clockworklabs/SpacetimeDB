{
  "level": 2,
  "note": "Durability of scheduled work across a backend restart, measured in BOTH conditions a real deploy produces: users who are away (tab closed) and users who are sitting on the page watching. Chat users are frequently the latter, so testing only the closed-tab case would assume away the harder half.",
  "features": [
    {
      "id": 301,
      "name": "Scheduled Delivery Survives Restart (client away)",
      "max": 2,
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "register",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "register",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "durable"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "durable"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "durable"
        }
      ],
      "criteria": [
        {
          "id": "pending-survives-restart",
          "points": 1,
          "desc": "A message scheduled before a backend restart is still listed as pending afterwards \u2014 the schedule is persisted, not held in process memory",
          "steps": [
            {
              "do": "scheduleMessage",
              "actor": "alice",
              "text": "DURABLE alpha",
              "secondsAhead": 200
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "scheduled-item",
              "within": 6000
            },
            {
              "do": "closeClient",
              "actor": "alice"
            },
            {
              "do": "closeClient",
              "actor": "bob"
            },
            {
              "do": "restartBackend",
              "settleMs": 8000
            },
            {
              "do": "openClient",
              "actor": "alice",
              "settleMs": 5000
            },
            {
              "do": "ensureRegistered",
              "actor": "alice",
              "name": "Alice"
            },
            {
              "do": "enterRoom",
              "actor": "alice",
              "room": "durable"
            },
            {
              "do": "click",
              "actor": "alice",
              "testid": "schedule-toggle",
              "within": 6000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "scheduled-item",
              "within": 12000
            }
          ]
        },
        {
          "id": "delivers-after-restart",
          "points": 1,
          "desc": "The scheduled message actually sends at its appointed time despite the restart. In-process timers are gone after a restart, so the message never arrives.",
          "steps": [
            {
              "do": "openClient",
              "actor": "bob",
              "settleMs": 4000
            },
            {
              "do": "ensureRegistered",
              "actor": "bob",
              "name": "Bob"
            },
            {
              "do": "enterRoom",
              "actor": "bob",
              "room": "durable"
            },
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "DURABLE alpha",
              "within": 230000
            }
          ]
        }
      ],
      "note": "Restarts are modelled the way a deploy actually happens: the user is not sitting on the page while it restarts. A client left connected auto-reconnects mid-restart, which is a different property (scored as invariant 103 Session Persistence) and would otherwise decide this test. Closing the client first keeps this about whether the SCHEDULE survives. Storage \u2014 and therefore any stored credential \u2014 persists across the close, exactly as a returning user's browser would."
    },
    {
      "id": 302,
      "name": "Scheduled Delivery Survives Restart (client watching)",
      "max": 2,
      "actors": [
        "alice",
        "bob"
      ],
      "note": "The client stays connected through the restart, as a user watching the page would. The socket drops and the SDK reconnects on its own \u2014 the app must come back as the SAME user and still show its own pending work.",
      "setup": [
        {
          "do": "register",
          "actor": "alice",
          "name": "Alice"
        },
        {
          "do": "register",
          "actor": "bob",
          "name": "Bob"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "watching"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "watching"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "watching"
        }
      ],
      "criteria": [
        {
          "id": "pending-visible-to-watching-author",
          "points": 1,
          "desc": "A user who stayed on the page through the restart still sees their own pending scheduled message. If the automatic reconnect re-identifies the client, its own work becomes invisible to it.",
          "steps": [
            {
              "do": "scheduleMessage",
              "actor": "alice",
              "text": "WATCHING alpha",
              "secondsAhead": 200
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "scheduled-item",
              "within": 6000
            },
            {
              "do": "restartBackend",
              "settleMs": 20000
            },
            {
              "do": "click",
              "actor": "alice",
              "testid": "schedule-toggle",
              "within": 10000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "scheduled-item",
              "within": 20000
            }
          ]
        },
        {
          "id": "delivers-to-watching-client",
          "points": 1,
          "desc": "The scheduled message still arrives for a client that stayed connected across the restart",
          "steps": [
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "WATCHING alpha",
              "within": 230000
            }
          ]
        }
      ]
    }
  ]
}