{
  "level": 1,
  "note": "Cross-cutting correctness invariants, scored as a SEPARATE axis from the feature rubric. The feature spec describes features, so anything cross-cutting \u2014 identity, isolation, authorization \u2014 is invisible to a feature-only rubric: an app can score well while shipping account takeover. Seeded from the historical defect taxonomy plus findings from manual grading. Every new human finding should land here. Each invariant is its own feature with fresh contexts: sharing one session lets a single root defect cascade and overstate the number of independent problems.",
  "features": [
    {
      "id": 101,
      "name": "Identity Integrity",
      "max": 2,
      "actors": [
        "alice",
        "impostor"
      ],
      "setup": [
        {
          "do": "register",
          "actor": "alice",
          "name": "Victim"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "shared"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "shared"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "alice private message"
        }
      ],
      "criteria": [
        {
          "id": "name-is-not-identity",
          "points": 1,
          "desc": "Two browsers registering the SAME display name must be DISTINCT users. Express apps upsert by users.name, collapsing them into one account \u2014 so one cannot see the other typing (self-filtered), and entering a known name takes over that account. SpacetimeDB keys on ctx.sender, so identical names stay distinct.",
          "steps": [
            {
              "do": "register",
              "actor": "impostor",
              "name": "Victim"
            },
            {
              "do": "enterRoom",
              "actor": "impostor",
              "room": "shared"
            },
            {
              "do": "typeInto",
              "actor": "alice",
              "text": "typing as the original user"
            },
            {
              "do": "expect",
              "actor": "impostor",
              "testid": "typing-indicator",
              "contains": "typing",
              "within": 5000
            }
          ]
        },
        {
          "id": "no-message-inheritance",
          "points": 1,
          "desc": "A same-named second user must not be able to post AS the original user. If they are one account, the impostor's message is indistinguishable from the victim's; distinct users are the minimum requirement for attribution to mean anything.",
          "steps": [
            {
              "do": "send",
              "actor": "impostor",
              "text": "posted by the impostor"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "message-item",
              "contains": "posted by the impostor",
              "within": 5000
            }
          ]
        }
      ]
    },
    {
      "id": 102,
      "name": "Data Isolation",
      "max": 3,
      "actors": [
        "alice",
        "bob"
      ],
      "setup": [
        {
          "do": "register",
          "actor": "alice",
          "name": "Victim"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "shared"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "shared"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "alice private message"
        },
        {
          "do": "register",
          "actor": "bob",
          "name": "Bystander"
        },
        {
          "do": "createRoom",
          "actor": "bob",
          "room": "other-room"
        },
        {
          "do": "enterRoom",
          "actor": "bob",
          "room": "other-room"
        }
      ],
      "criteria": [
        {
          "id": "messages-scoped-to-room",
          "points": 1,
          "desc": "A message sent in one room must never appear in another room (historical: messages-leak-across-rooms)",
          "steps": [
            {
              "do": "expect",
              "actor": "bob",
              "testid": "message-item",
              "contains": "alice private message",
              "absent": true,
              "within": 4000
            }
          ]
        },
        {
          "id": "own-messages-not-unread",
          "points": 1,
          "desc": "Sending a message must not raise the sender's own unread badge (historical: unread-counts-own-messages, seen twice on SpacetimeDB)",
          "steps": [
            {
              "do": "send",
              "actor": "alice",
              "text": "alice second message"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "unread-badge",
              "in": {
                "testid": "room-item",
                "contains": "{room:shared}"
              },
              "absent": true,
              "within": 4000
            }
          ]
        },
        {
          "id": "no-duplicate-rooms",
          "points": 1,
          "desc": "A room must render exactly once in the list \u2014 optimistic insert plus broadcast echo duplicates it (historical: room-list-duplication)",
          "steps": [
            {
              "do": "expect",
              "actor": "alice",
              "testid": "room-item",
              "contains": "{room:shared}",
              "count": 1,
              "within": 4000
            }
          ]
        }
      ]
    },
    {
      "id": 103,
      "name": "Session Persistence",
      "max": 1,
      "actors": [
        "alice"
      ],
      "setup": [
        {
          "do": "register",
          "actor": "alice",
          "name": "Victim"
        },
        {
          "do": "createRoom",
          "actor": "alice",
          "room": "shared"
        },
        {
          "do": "enterRoom",
          "actor": "alice",
          "room": "shared"
        },
        {
          "do": "send",
          "actor": "alice",
          "text": "alice private message"
        }
      ],
      "criteria": [
        {
          "id": "identity-survives-reload",
          "points": 1,
          "desc": "Reloading must not silently create a new identity or log the user out (historical: identity-lost-on-refresh, SpacetimeDB-specific)",
          "steps": [
            {
              "do": "reload",
              "actor": "alice"
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "name-input",
              "absent": true,
              "within": 5000
            },
            {
              "do": "expect",
              "actor": "alice",
              "testid": "room-item",
              "contains": "{room:shared}",
              "within": 5000
            }
          ]
        }
      ]
    }
  ]
}