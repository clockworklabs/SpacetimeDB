# Run output: each variant writes <variant>/<variant>-YYYYMMDD/. Graded runs are published
# to clockworklabs/spacetimedb-llm-sequential-upgrade-results with
# `cargo llm-apps sequential publish`, which leaves out personal data and build output.
/sequential-upgrade/
/one-shot/

# The OpenTelemetry collector's shared log (logs.jsonl, metrics.jsonl and rotated backups)
/telemetry/

# Bookkeeping for `cargo llm-apps sequential loop` and `benchmark`
/.grade-lock/
/benchmark-status.json
/benchmark-run-*.log
