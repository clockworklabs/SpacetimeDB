});

export const addPrivate = spacetimedb.reducer({ name: "add_private" }, {
  name: t.string(),
});

export const assertCallerIdentityIsModuleIdentity = spacetimedb.reducer({ name: "assert_caller_identity_is_module_identity" }, {});

export const deletePlayer = spacetimedb.reducer({ name: "delete_player" }, {
  id: t.u64(),
});

export const deletePlayersByName = spacetimedb.reducer({ name: "delete_players_by_name" }, {
  name: t.string(),
});

export const expectEnvironment = spacetimedb.reducer({ name: "expect_environment" }, {
  key: t.string(),
  expected: t.option(t.string()),
});

export const listOverAge = spacetimedb.reducer({ name: "list_over_age" }, {
  age: t.u8(),
});

export const logModuleIdentity = spacetimedb.reducer({ name: "log_module_identity" }, {});

export const queryPrivate = spacetimedb.reducer({ name: "query_private" }, {});

export const sayHello = spacetimedb.reducer({ name: "say_hello" }, {});

export const test = spacetimedb.reducer({
  arg: TestA,
  arg2: TestB,
  arg3: NamespaceTestC,
  arg4: NamespaceTestF,
});

export const testBtreeIndexArgs = spacetimedb.reducer({ name: "test_btree_index_args" }, {});

export const useSubmodule = spacetimedb.reducer({ name: "use_submodule" }, {
  value: t.string(),
});

export const getMySchemaViaHttp = spacetimedb.procedure({ name: "get_my_schema_via_http" }, {}, t.string());

export const readEnvironment = spacetimedb.procedure({ name: "read_environment" }, {
  key: t.string(),
}, t.option(t.string()));

export const useSubmoduleProcedure = spacetimedb.procedure({ name: "use_submodule_procedure" }, {}, t.u64());

export const envReadRootSqlView = spacetimedb.view({ name: "env_read_root_sql_view", public: true }, t.array(EnvReadRootSqlViewRow));

