});


export const TestB = t.object("TestB", {
  foo: t.string(),
});

export const NamespaceTestC = t.enum("NamespaceTestC", {
  Foo: t.unit(),
  Bar: t.unit(),
});

export const NamespaceTestF = t.enum("NamespaceTestF", {
  Foo: t.unit(),
  Bar: t.unit(),
  Baz: t.string(),
});

export const Test = t.object("Test", {
  get arg() { return TestA; },
  get arg2() { return TestB; },
  get arg3() { return NamespaceTestC; },
  get arg4() { return NamespaceTestF; },
});
const loggedOutPlayer = table(
  { name: "logged_out_player", public: true, indexes: [
    { accessor: "identity", name: "logged_out_player_identity_idx_btree", algorithm: 'btree', columns: ["identity"] },
    { accessor: "name", name: "logged_out_player_name_idx_btree", algorithm: 'btree', columns: ["name"] },
    { accessor: "player_id", name: "logged_out_player_player_id_idx_btree", algorithm: 'btree', columns: ["playerId"] },
  ], constraints: [
    { name: "logged_out_player_identity_key", constraint: 'unique', columns: ["identity"] },
    { name: "logged_out_player_name_key", constraint: 'unique', columns: ["name"] },
    { name: "logged_out_player_player_id_key", constraint: 'unique', columns: ["playerId"] },
  ] }, {
    identity: t.identity().primaryKey(),
    playerId: t.u64().autoInc().name("player_id"),
    name: t.string(),
  }
);

const person = table(
  { name: "person", public: true, indexes: [
    { accessor: "age", name: "person_age_idx_btree", algorithm: 'btree', columns: ["age"] },
    { accessor: "id", name: "person_id_idx_btree", algorithm: 'btree', columns: ["id"] },
  ], constraints: [
