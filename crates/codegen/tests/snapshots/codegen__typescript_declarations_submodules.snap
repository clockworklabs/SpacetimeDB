"declarations.ts" = '''
// THIS FILE IS AUTOMATICALLY GENERATED BY SPACETIMEDB. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY TABLES IN YOUR MODULE SOURCE CODE INSTEAD.

import { schema, table, t } from 'spacetimedb/schema';
import * as types from './types';
import { BinaryReader } from 'spacetimedb';
import * as myLib from './my_lib/declarations';

const loggedOutPlayer = table(
  { name: "logged_out_player", public: true, indexes: [
    { accessor: "identity", name: "logged_out_player_identity_idx_btree", algorithm: 'btree', columns: ["identity"] },
    { accessor: "name", name: "logged_out_player_name_idx_btree", algorithm: 'btree', columns: ["name"] },
    { accessor: "player_id", name: "logged_out_player_player_id_idx_btree", algorithm: 'btree', columns: ["playerId"] },
  ], constraints: [
    { name: "logged_out_player_identity_key", constraint: 'unique', columns: ["identity"] },
    { name: "logged_out_player_name_key", constraint: 'unique', columns: ["name"] },
    { name: "logged_out_player_player_id_key", constraint: 'unique', columns: ["playerId"] },
  ] }, {
    identity: t.identity().primaryKey(),
    playerId: t.u64().autoInc().name("player_id"),
    name: t.string(),
  }
);

const person = table(
  { name: "person", public: true, indexes: [
    { accessor: "age", name: "person_age_idx_btree", algorithm: 'btree', columns: ["age"] },
    { accessor: "id", name: "person_id_idx_btree", algorithm: 'btree', columns: ["id"] },
  ], constraints: [
    { name: "person_id_key", constraint: 'unique', columns: ["id"] },
  ] }, {
    id: t.u32().primaryKey().autoInc(),
    name: t.string(),
    age: t.u8(),
  }
);

const player = table(
  { name: "player", public: true, indexes: [
    { accessor: "identity", name: "player_identity_idx_btree", algorithm: 'btree', columns: ["identity"] },
    { accessor: "name", name: "player_name_idx_btree", algorithm: 'btree', columns: ["name"] },
    { accessor: "player_id", name: "player_player_id_idx_btree", algorithm: 'btree', columns: ["playerId"] },
  ], constraints: [
    { name: "player_identity_key", constraint: 'unique', columns: ["identity"] },
    { name: "player_name_key", constraint: 'unique', columns: ["name"] },
    { name: "player_player_id_key", constraint: 'unique', columns: ["playerId"] },
  ] }, {
    identity: t.identity().primaryKey(),
    playerId: t.u64().autoInc().name("player_id"),
    name: t.string(),
  }
);

const testD = table(
  { name: "test_d", public: true }, {
    testC: t.option(types.NamespaceTestC).name("test_c").default(t.option(types.NamespaceTestC).deserialize(new BinaryReader(new Uint8Array([0, 0])))),
    testCNested: t.option(t.array(types.NamespaceTestC)).name("test_c_nested"),
  }
);

const testF = table(
  { name: "test_f", public: true }, {
    field: types.Foobar,
  }
);

export const EnvReadRootSqlViewRow = t.row({
  key: t.string(),
  value: t.string(),
});

export const MyPlayerRow = t.row({
  identity: t.identity().primaryKey(),
  playerId: t.u64().name("player_id"),
  name: t.string(),
});

const spacetimedb = schema({
  loggedOutPlayer,
  person,
  player,
  testD,
  testF,
  "myLib": { name: "my_lib", module: myLib },
});
export default spacetimedb;

export const add = spacetimedb.reducer({
  name: t.string(),
  age: t.u8(),
});

export const addPlayer = spacetimedb.reducer({ name: "add_player" }, {
  name: t.string(),
});

export const addPrivate = spacetimedb.reducer({ name: "add_private" }, {
  name: t.string(),
});

export const assertCallerIdentityIsModuleIdentity = spacetimedb.reducer({ name: "assert_caller_identity_is_module_identity" }, {});

export const deletePlayer = spacetimedb.reducer({ name: "delete_player" }, {
  id: t.u64(),
});

export const deletePlayersByName = spacetimedb.reducer({ name: "delete_players_by_name" }, {
  name: t.string(),
});

export const expectEnvironment = spacetimedb.reducer({ name: "expect_environment" }, {
  key: t.string(),
  expected: t.option(t.string()),
});

export const listOverAge = spacetimedb.reducer({ name: "list_over_age" }, {
  age: t.u8(),
});

export const logModuleIdentity = spacetimedb.reducer({ name: "log_module_identity" }, {});

export const queryPrivate = spacetimedb.reducer({ name: "query_private" }, {});

export const sayHello = spacetimedb.reducer({ name: "say_hello" }, {});

export const test = spacetimedb.reducer({
  arg: types.TestA,
  arg2: types.TestB,
  arg3: types.NamespaceTestC,
  arg4: types.NamespaceTestF,
});

export const testBtreeIndexArgs = spacetimedb.reducer({ name: "test_btree_index_args" }, {});

export const useSubmodule = spacetimedb.reducer({ name: "use_submodule" }, {
  value: t.string(),
});

export const getMySchemaViaHttp = spacetimedb.procedure({ name: "get_my_schema_via_http" }, {}, t.string());

export const readEnvironment = spacetimedb.procedure({ name: "read_environment" }, {
  key: t.string(),
}, t.option(t.string()));

export const useSubmoduleProcedure = spacetimedb.procedure({ name: "use_submodule_procedure" }, {}, t.u64());

export const envReadRootSqlView = spacetimedb.view({ name: "env_read_root_sql_view", public: true }, t.array(EnvReadRootSqlViewRow));

export const myPlayer = spacetimedb.view({ name: "my_player", public: true }, t.option(MyPlayerRow));
'''
