"declarations.ts" = '''
// THIS FILE IS AUTOMATICALLY GENERATED BY SPACETIMEDB. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY TABLES IN YOUR MODULE SOURCE CODE INSTEAD.

import { schema, table, t } from 'spacetimedb/schema';

const audit = table(
  { name: "audit", public: true, event: true }, {
    message: t.string(),
  }
);

const person = table(
  { name: "person", public: true, indexes: [
    { accessor: "byName", name: "person_display_name_idx_hash", algorithm: 'hash', columns: ["displayName"] },
    { accessor: "byId", name: "person_id_idx_direct", algorithm: 'direct', column: "id" },
  ], constraints: [
    { name: "person_id_key", constraint: 'unique', columns: ["id"] },
  ] }, {
    id: t.u32().primaryKey().autoInc(),
    displayName: t.string().name("display_name"),
    score: t.u32().default(7),
  }
);

const spacetimedb = schema({
  audit,
  person,
});
export default spacetimedb;
'''
"index.ts" = '''
// THIS FILE IS AUTOMATICALLY GENERATED BY SPACETIMEDB.
import * as declarations from './declarations';
import { createClient, type EventContextInterface, type ReducerEventContextInterface, type SubscriptionEventContextInterface, type ErrorContextInterface, type SubscriptionHandleImpl, type RemoteModuleOfDeclarations } from 'spacetimedb';
const client = createClient(declarations, { cliVersion: "X.Y.Z", tableAliases: {} });
export const { DbConnection, DbConnectionBuilder, SubscriptionBuilder, tables, reducers, procedures } = client;
export type DbConnection = InstanceType<typeof DbConnection>;
export type DbConnectionBuilder = InstanceType<typeof DbConnectionBuilder>;
export type SubscriptionBuilder = InstanceType<typeof SubscriptionBuilder>;
type RemoteModule = RemoteModuleOfDeclarations<typeof declarations>;
export type DbView = DbConnection['db'];
export type Tables = typeof tables;
export type EventContext = Omit<EventContextInterface<RemoteModule>, 'db'> & { db: DbView };
export type ReducerEventContext = Omit<ReducerEventContextInterface<RemoteModule>, 'db'> & { db: DbView };
export type SubscriptionEventContext = Omit<SubscriptionEventContextInterface<RemoteModule>, 'db'> & { db: DbView };
export type ErrorContext = Omit<ErrorContextInterface<RemoteModule>, 'db'> & { db: DbView };
export type SubscriptionHandle = SubscriptionHandleImpl<RemoteModule>;
export type * as Reducers from './types/reducers';
export type * as Procedures from './types/procedures';
'''
"types.ts" = '''
