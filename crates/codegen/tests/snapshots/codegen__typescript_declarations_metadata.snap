"declarations.ts" = '''
// THIS FILE IS AUTOMATICALLY GENERATED BY SPACETIMEDB. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY TABLES IN YOUR MODULE SOURCE CODE INSTEAD.

import { schema, table, t } from 'spacetimedb/schema';

import type { Infer } from 'spacetimedb/schema';

export const ZAddress = t.object("ZAddress", {
  city: t.string(),
});
export type ZAddress = Infer<typeof ZAddress>;
export const Person = t.row("Person", {
  id: t.u32().primaryKey().autoInc(),
  displayName: t.string().name("display_name"),
  score: t.u32().default(7),
  get address() { return ZAddress; },
});
export type Person = Infer<typeof Person>;

const audit = table(
  { name: "audit", public: true, event: true }, {
    message: t.string(),
  }
);

const person = table(
  { name: "person", public: true, indexes: [
    { accessor: "byName", name: "person_display_name_idx_hash", algorithm: 'hash', columns: ["displayName"] },
    { accessor: "byId", name: "person_id_idx_direct", algorithm: 'direct', column: "id" },
  ], constraints: [
    { name: "person_id_key", constraint: 'unique', columns: ["id"] },
  ] }, Person
);

const spacetimedb = schema({
  audit,
  person,
});
export default spacetimedb;

export const submitPerson = spacetimedb.reducer({ name: "submit_person" }, {
  person: Person,
});
'''
