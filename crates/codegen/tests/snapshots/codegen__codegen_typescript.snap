import { t, type Infer } from 'spacetimedb/schema';

export const Baz = t.object("Baz", {
  field: t.string(),
});
export type Baz = Infer<typeof Baz>;

export const Foobar = t.enum("Foobar", {
  get Baz() { return Baz; },
  Bar: t.unit(),
  Har: t.u32(),
});
export type Foobar = Infer<typeof Foobar>;

export const HasSpecialStuff = t.object("HasSpecialStuff", {
  identity: t.identity(),
  connectionId: t.connectionId(),
});
export type HasSpecialStuff = Infer<typeof HasSpecialStuff>;

export const NonrepeatingTestArg = t.object("NonrepeatingTestArg", {
  scheduledId: t.u64(),
  scheduledAt: t.scheduleAt(),
  prevTime: t.timestamp(),
});
export type NonrepeatingTestArg = Infer<typeof NonrepeatingTestArg>;

export const Person = t.object("Person", {
  id: t.u32(),
  name: t.string(),
  age: t.u8(),
});
export type Person = Infer<typeof Person>;

export const PkMultiIdentity = t.object("PkMultiIdentity", {
  id: t.u32(),
  other: t.u32(),
});
export type PkMultiIdentity = Infer<typeof PkMultiIdentity>;

export const Player = t.object("Player", {
  identity: t.identity(),
  playerId: t.u64(),
  name: t.string(),
});
export type Player = Infer<typeof Player>;

export const Point = t.object("Point", {
  x: t.i64(),
  y: t.i64(),
});
export type Point = Infer<typeof Point>;

export const PrivateTable = t.object("PrivateTable", {
  name: t.string(),
});
export type PrivateTable = Infer<typeof PrivateTable>;

export const RemoveTable = t.object("RemoveTable", {
  id: t.u32(),
});
export type RemoveTable = Infer<typeof RemoveTable>;

export const RepeatingTestArg = t.object("RepeatingTestArg", {
  scheduledId: t.u64(),
  scheduledAt: t.scheduleAt(),
  prevTime: t.timestamp(),
});
export type RepeatingTestArg = Infer<typeof RepeatingTestArg>;

export const TestA = t.object("TestA", {
  x: t.u32(),
  y: t.u32(),
  z: t.string(),
});
export type TestA = Infer<typeof TestA>;

export const TestB = t.object("TestB", {
  foo: t.string(),
});
export type TestB = Infer<typeof TestB>;

export const TestD = t.object("TestD", {
  get testC() { return t.option(NamespaceTestC); },
  get testCNested() { return t.option(t.array(NamespaceTestC)); },
});
export type TestD = Infer<typeof TestD>;

export const TestE = t.object("TestE", {
  id: t.u64(),
  name: t.string(),
});
export type TestE = Infer<typeof TestE>;

export const TestFoobar = t.object("TestFoobar", {
  get field() { return Foobar; },
});
export type TestFoobar = Infer<typeof TestFoobar>;

export const NamespaceTestC = t.enum("NamespaceTestC", {
  Foo: t.unit(),
  Bar: t.unit(),
});
export type NamespaceTestC = Infer<typeof NamespaceTestC>;

export const NamespaceTestF = t.enum("NamespaceTestF", {
  Foo: t.unit(),
  Bar: t.unit(),
  Baz: t.string(),
});
export type NamespaceTestF = Infer<typeof NamespaceTestF>;
