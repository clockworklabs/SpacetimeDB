<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SpacetimeDB.Runtime</AssemblyName>
    <Version>2.13.0</Version>
    <Title>SpacetimeDB Module Runtime</Title>
    <Description>The SpacetimeDB Runtime implements the database runtime bindings for writing SpacetimeDB modules in C#.</Description>
  </PropertyGroup>

  <!-- Project references inherit the module RID. Pack also builds this variant
       without a RID: it contains IL, not a native compiler/toolchain dependency. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'wasi-wasm' Or '$(_SpacetimeDBWasmRuntime)' == 'true'">
    <DefineConstants>$(DefineConstants);SPACETIMEDB_WASM_RUNTIME</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_SpacetimeDBWasmRuntime)' == 'true'">
    <OutputPath>bin/$(Configuration)/wasm/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/wasm/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SpacetimeDB</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <RestoreAdditionalProjectSources Condition="$(TargetFramework.StartsWith('net8.')) And '$(SPACETIMEDB_WASM_AOT)' == '1'">https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Note: BSATN.Codegen is included in the BSATN.Runtime NuGet package. -->
    <ProjectReference Include="../BSATN.Runtime/BSATN.Runtime.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" SkipGetTargetFrameworkProperties="true" />
    <!-- ...But we also need BSATN.Codegen to transform `[SpacetimeDB.Type]` usages in source of Runtime itself. -->
    <!-- For that, it has to be included as an explicit private dependency. -->
    <ProjectReference Include="../BSATN.Codegen/BSATN.Codegen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" SkipGetTargetFrameworkProperties="true" />
    <!-- Codegen package must be built before this one so that it's included in NuGet Runtime package, but we don't depend on it. -->
    <!-- (*not* with OutputItemType=analyzer because we don't want to use that source generator on source of Runtime itself) -->
    <ProjectReference Include="../Codegen/Codegen.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- Preserve .NET 8 packaging. .NET 10 modules reference the LLVM toolchain
       directly so managed consumers of this runtime do not depend on it. -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net8.')) And '$(SPACETIMEDB_WASM_AOT)' == '1'">
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="8.0.0-*" IncludeAssets="All" />
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" Version="8.0.0-*" IncludeAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="build/*" Pack="true" PackagePath="build" />
    <!-- NuGet prefers buildTransitive props over build props. Keep .NET 8 on its existing early WASI configuration. -->
    <None Include="buildTransitive/net10.0/*" Pack="true" PackagePath="buildTransitive/net10.0" />
    <None Include="bindings.c" Pack="true" PackagePath="" />
    <None Include="driver.h" Pack="true" PackagePath="" />
    <!-- We want all users who depends on Runtime to automatically get the Roslyn codegen component as well. -->
    <None Include="../Codegen/bin/$(Configuration)/netstandard2.0/SpacetimeDB.Codegen.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpacetimeDB.Testing" />
    <InternalsVisibleTo Include="SpacetimeDB.Testing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="bindings.c" />
    <UpToDateCheckInput Include="driver.h" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackWasmRuntime</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="PackWasmRuntime" Condition="'$(TargetFramework)' == 'net10.0'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="TargetFramework=net10.0;_SpacetimeDBWasmRuntime=true"
             RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_WasmRuntimeAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_WasmRuntimeAssembly)" PackagePath="runtimes/wasi-wasm/lib/net10.0" />
    </ItemGroup>
  </Target>

</Project>
