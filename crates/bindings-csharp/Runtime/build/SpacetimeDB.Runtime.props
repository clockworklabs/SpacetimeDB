<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The .NET 8 WASI SDK inspects OutputType before NuGet .targets are imported.
       Defer until project-local TargetFramework is known, but before SDK inference. -->
  <PropertyGroup>
    <_SpacetimeBeforeTargetFrameworkInferenceTargets>$(BeforeTargetFrameworkInferenceTargets)</_SpacetimeBeforeTargetFrameworkInferenceTargets>
    <BeforeTargetFrameworkInferenceTargets>$(MSBuildThisFileDirectory)SpacetimeDB.Runtime.Jit.props</BeforeTargetFrameworkInferenceTargets>
  </PropertyGroup>
</Project>
