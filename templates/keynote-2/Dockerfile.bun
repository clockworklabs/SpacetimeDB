FROM oven/bun:1.4.4
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json bun.lockb* tsconfig.json ./

RUN bun install --ignore-scripts

# Copy source
COPY bun ./bun

ENV PORT=4001

CMD ["bun", "bun/bun-server.ts"]
