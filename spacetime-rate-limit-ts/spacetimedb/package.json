{
  "name": "spacetime-rate-limit-module",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "spacetime build",
    "publish:local": "spacetime publish --server local --yes spacetime-rate-limit",
    "publish:local:reset": "spacetime publish --server local --yes --delete-data=always spacetime-rate-limit"
  },
  "dependencies": {
    "@spacetimedb/rate-limit": "workspace:*",
    "spacetimedb": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
